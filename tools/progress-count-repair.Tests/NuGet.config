<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The repository-local CoreSync builds Shared needs (as src/NuGet.config), from this folder. -->
  <packageSources>
    <add key="coresync-local" value="../../lib/coresync" />
    <add key="coresync-postgresql-local3" value="../../lib/coresync-postgresql-local3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="coresync-local">
      <package pattern="CoreSync.Sqlite" />
    </packageSource>
    <packageSource key="coresync-postgresql-local3">
      <package pattern="CoreSync.PostgreSQL" />
    </packageSource>
  </packageSourceMapping>
</configuration>
