<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="LiveApiSmoke.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <ProjectReference Include="../../src/SentenceStudio.Native/SentenceStudio.Native.csproj" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativeApiEndpoint.cs"
             Link="NativeApiEndpoint.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativeProfileAuthService.cs"
             Link="NativeProfileAuthService.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativePreviewFixture.cs"
             Link="NativePreviewFixture.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="../SentenceStudio.Native.Tests/NativeSliceFixture.cs"
             Link="NativeSliceFixture.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="../SentenceStudio.Native.Tests/ScratchPorts.cs"
             Link="ScratchPorts.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
