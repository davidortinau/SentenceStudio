<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="LiveApiSmoke.cs" />
    <!-- Nested project: its own bin/obj output must not join this compile. -->
    <Compile Remove="LiveApiSmoke/**" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <ProjectReference Include="../../src/SentenceStudio.Native/SentenceStudio.Native.csproj" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativeApiEndpoint.cs"
             Link="NativeApiEndpoint.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativeResourceDateFormatter.cs"
             Link="NativeResourceDateFormatter.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativeResourceQuickKeyCommands.cs"
             Link="NativeResourceQuickKeyCommands.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativeLocalizedText.cs"
             Link="NativeLocalizedText.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/App/ApplicationFormRoutes.cs"
             Link="ApplicationFormRoutes.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativeProfileAuthService.cs"
             Link="NativeProfileAuthService.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/LearningResources/LearningResourceViewState.cs"
             Link="LearningResourceViewState.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/LearningResources/LearningResourceInputSelection.cs"
             Link="LearningResourceInputSelection.cs" />
    <!-- VocabularyFilterState, SkillsCoordinator, ProfileCoordinator, ActivityLogReader,
         ActivityLogCoordinator, QuizSettingsDraft and SettingsCoordinator now live in
         src/SentenceStudio.Native/Features and arrive through the project reference. -->
    <Compile Include="../../src/SentenceStudio.Native.iOS/Styling/SourceUiLayout.cs"
             Link="SourceUiLayout.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Styling/SourceUiAppearance.cs"
             Link="SourceUiAppearance.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Styling/SourceUiTypography.cs"
             Link="SourceUiTypography.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/Settings/SettingsAppearanceSave.cs"
             Link="SettingsAppearanceSave.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativeDashboardCardAccessibility.cs"
             Link="NativeDashboardCardAccessibility.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativePreviewFixture.cs"
             Link="NativePreviewFixture.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="../SentenceStudio.Native.Tests/NativeSliceFixture.cs"
             Link="NativeSliceFixture.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="../SentenceStudio.Native.Tests/DeviceInterpreterQueryGuard.cs"
             Link="DeviceInterpreterQueryGuard.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="../SentenceStudio.Native.Tests/ScratchPorts.cs"
             Link="ScratchPorts.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="../SentenceStudio.Native.Tests/ScratchResourceAiGateway.cs"
             Link="ScratchResourceAiGateway.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
