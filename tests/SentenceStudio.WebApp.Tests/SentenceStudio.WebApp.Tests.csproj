<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    End-to-end tests for the WebApp's own HTTP pipeline: real Identity cookie authentication, real
    authorization middleware, real endpoint routing, and real Razor component rendering.

    Web SDK rather than the plain SDK because WebApplicationFactory needs the test host to resolve
    the application's static asset manifest the same way the app does; under the plain SDK the
    host cannot serve MapStaticAssets and page requests fail before reaching a component.

    net11.0 to match SentenceStudio.WebApp.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SentenceStudio.WebApp\SentenceStudio.WebApp.csproj" />
  </ItemGroup>

</Project>
