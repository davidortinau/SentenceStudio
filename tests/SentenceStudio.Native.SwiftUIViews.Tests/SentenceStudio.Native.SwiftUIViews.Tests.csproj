<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds iOS SwiftUI feature views through the real Microsoft.SwiftUI facade, which needs its
    native bridge and the main thread, so it runs as a small macOS executable like the facade's
    own tests (not under dotnet test). The facade validates node kinds when a view is built (a
    Menu's actions must be Buttons); a view that breaks a rule throws here instead of leaving a
    screen on Loading in the app. Nothing is installed or launched on a device or simulator.

      dotnet build tests/SentenceStudio.Native.SwiftUIViews.Tests/SentenceStudio.Native.SwiftUIViews.Tests.csproj -p:ValidateXcodeVersion=false
      tests/SentenceStudio.Native.SwiftUIViews.Tests/bin/Debug/net11.0-macos/osx-arm64/SentenceStudio.Native.SwiftUIViews.Tests.app/Contents/MacOS/SentenceStudio.Native.SwiftUIViews.Tests

    Exit code 0 when every case passes.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <ApplicationId>com.simplyprofound.sentencestudio.swiftuiviewtests</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.SwiftUI" Version="0.1.0-preview.52" />
    <PackageReference Include="Microsoft.SwiftUI" />
    <ProjectReference Include="../../src/SentenceStudio.Native/SentenceStudio.Native.csproj" />
    <!-- The views under test and the iOS styling they use (SwiftUI facade only, no UIKit). -->
    <Compile Include="../../src/SentenceStudio.Native.iOS/Styling/*.cs" LinkBase="Styling" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/Lookups/RecentLookupsView.cs"
             Link="Features/RecentLookupsView.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/Sam/SamFloatingEntry.cs"
             Link="Features/SamFloatingEntry.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/GlobalUsings.SharedFeatures.cs"
             Link="GlobalUsings.SharedFeatures.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/Vocabulary/VocabularyWordEditView.cs"
             Link="Features/VocabularyWordEditView.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/Vocabulary/VocabularyWordEditView.Examples.cs"
             Link="Features/VocabularyWordEditView.Examples.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/Vocabulary/VocabularyDuplicatesView.cs"
             Link="Features/VocabularyDuplicatesView.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/Vocabulary/VocabularyListView.cs"
             Link="Features/VocabularyListView.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/Browse/*.cs" LinkBase="Features/Browse" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/LearningResources/LearningResourcesView.cs"
             Link="Features/LearningResources/LearningResourcesView.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/LearningResources/LearningResourcesActions.cs"
             Link="Features/LearningResources/LearningResourcesActions.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Features/LearningResources/LearningResourceRowView.cs"
             Link="Features/LearningResources/LearningResourceRowView.cs" />
    <Compile Include="../../src/SentenceStudio.Native.iOS/Platform/NativeResourceDateFormatter.cs"
             Link="Platform/NativeResourceDateFormatter.cs" />
  </ItemGroup>
</Project>
