<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Same local facade feed as src/SentenceStudio.Native.iOS/NuGet.Config. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="swiftui-preview" value="/Users/davidortinau/work/Microsoft.SwiftUI/artifacts" />
    <!-- CoreSync.Sqlite 0.1.129-local4 (Directory.Packages.props) lives in the repository. -->
    <add key="coresync-local" value="../../lib/coresync" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="swiftui-preview">
      <package pattern="Microsoft.SwiftUI" />
    </packageSource>
    <packageSource key="coresync-local">
      <package pattern="CoreSync.Sqlite" />
    </packageSource>
  </packageSourceMapping>
</configuration>
