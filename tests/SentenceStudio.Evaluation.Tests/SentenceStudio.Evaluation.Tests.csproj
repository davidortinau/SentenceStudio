<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Live model evaluation suite built on Microsoft.Extensions.AI.Evaluation.
    It calls a real Azure OpenAI deployment, so every test is gated behind
    SS_RUN_LIVE_EVALS=1 and tagged [Trait("Category", "LiveEval")]. Without the
    environment variable every test reports as skipped and no network call is made.
    CI does not reference this project (ci.yml builds and tests explicit project paths).
    See docs/evaluation/README.md.
  -->
  <PropertyGroup>
    <!-- net10.0 matches the other test projects and the server TFM of SentenceStudio.Shared
         (its mobile TFMs are excluded with -p:IncludeMobileTargets=false). -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The MEAI evaluation libraries mark a few APIs experimental (AIEVAL001). -->
    <NoWarn>$(NoWarn);AIEVAL001;OPENAI001;MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Reporting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The eval drives the real ContentImportService -> AiService -> GetResponseAsync<T> path. -->
    <ProjectReference Include="..\..\src\SentenceStudio.Shared\SentenceStudio.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same Scriban prompt templates the app ships (MAUI raw assets). Copied, not forked:
         a prompt change in the app is picked up by the next eval run (and busts the response cache). -->
    <None Include="..\..\src\SentenceStudio.AppLib\Resources\Raw\FreeTextToVocab.scriban-txt"
          Link="AppTemplates\FreeTextToVocab.scriban-txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\SentenceStudio.AppLib\Resources\Raw\TranslateMissingNativeTerms.scriban-txt"
          Link="AppTemplates\TranslateMissingNativeTerms.scriban-txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
