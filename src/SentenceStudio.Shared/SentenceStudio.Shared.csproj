<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(IncludeMobileTargets)' != 'false'">$(TargetFrameworks);net11.0-ios;net11.0-android;net11.0-maccatalyst;net11.0-macos</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishSelfContained>false</PublishSelfContained>
	</PropertyGroup>

	<ItemGroup>
		<!-- Expose internal helpers (e.g. SyncService.RepairTaintedVocabularyProgressAsync)
		     to the unit-test project so we can write regression tests without widening
		     the public API surface. -->
		<InternalsVisibleTo Include="SentenceStudio.UnitTests" />
	</ItemGroup>

	<!-- IPlanService lives in this project so both the API head (HTTP) and the
	     MAUI Blazor head (in-process via Features:DailyPlanV2) can resolve a
	     single implementation. The DTOs it returns live in Contracts. -->
	<ItemGroup>
		<ProjectReference Include="..\SentenceStudio.Contracts\SentenceStudio.Contracts.csproj" />
		<ProjectReference Include="..\SentenceStudio.Sharing\SentenceStudio.Sharing.csproj" />
	</ItemGroup>

	<!-- ASP.NET Core Identity: server-only (no iOS/Android runtime pack) -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
		<PackageReference Include="CoreSync.PostgreSQL" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
	</ItemGroup>

	<!-- EF Core migrations: server uses PostgreSQL, mobile uses SQLite -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != ''">
		<!-- Mobile: exclude PostgreSQL migrations and design-time factory -->
		<Compile Remove="Migrations\*.cs" />
		<Compile Remove="Data\DesignTimeDbContextFactory.cs" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">
		<!-- Server: exclude SQLite migrations -->
		<Compile Remove="Migrations\Sqlite\**" />
	</ItemGroup>

	<!-- Release notes embedded for all platforms -->
	<ItemGroup>
		<EmbeddedResource Include="..\..\docs\release-notes\*.md" LinkBase="ReleaseNotes" />
	</ItemGroup>

	<!-- Number drill seed content (procedurally-generated activity, not a learning resource) -->
	<ItemGroup>
		<EmbeddedResource Include="..\..\lib\content\numbers\*.json" LinkBase="Numbers" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="CoreSync.Http.Client" />
		<PackageReference Include="CoreSync.Sqlite" />
		<PackageReference Include="ElevenLabs-DotNet" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<!-- Microsoft.Extensions.AI (IChatClient + GetResponseAsync<T>) and the OpenAI client
		     types used by AiService/AiClient/AiClientRegistration used to arrive transitively
		     through Microsoft.Agents.AI(.OpenAI). Those preview-era agent packages were removed
		     with the unused ConversationAgentService path, so the dependency is now explicit.
		     Versions are centrally managed (Directory.Packages.props, "AI / Agents"); this
		     project must NOT reference Microsoft.Agents.AI* — ConversationAgentRemovalTests
		     asserts the Shared assembly has no Microsoft.Agents.AI reference. -->
		<PackageReference Include="Microsoft.Extensions.AI" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="NAudio" />
		<PackageReference Include="NLayer.NAudioSupport" />
		<PackageReference Include="Scriban" />
		<PackageReference Include="sqlite-net-pcl" />
		<PackageReference Include="SQLiteNetExtensions" />
		<PackageReference Include="YoutubeExplode" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Prompts\*.scriban" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Strings\AppResources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources\Strings\AppResources.Designer.cs</LastGenOutput>
			<StronglyTypedFileName>Resources\Strings\AppResources.Designer.cs</StronglyTypedFileName>
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>SentenceStudio.Resources.Strings</StronglyTypedNamespace>
			<StronglyTypedClassName>AppResources</StronglyTypedClassName>
			<LogicalName>SentenceStudio.Resources.Strings.AppResources.resources</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Strings\AppResources.ko.resx">
			<LogicalName>SentenceStudio.Resources.Strings.AppResources.ko.resources</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!--
		ResXFileCodeGenerator emits an indentation-only line between every generated property, so
		AppResources.Designer.cs lands in the tree with one trailing-whitespace line per resource.
		The file is generated INTO the source tree (see StronglyTypedFileName above) and is tracked,
		so every resx edit regenerates it and reintroduces the whitespace, which fails the
		whitespace gate. Formatting the file by hand is not durable: the next localization change
		undoes it.

		This trims the generated file immediately after generation. It is deterministic and
		idempotent, and rewrites only when the content actually changes, so it does not churn
		timestamps or force needless rebuilds. It touches only whitespace at end of line: no code,
		no encoding, no line endings.
	-->
	<UsingTask TaskName="TrimTrailingWhitespace"
	           TaskFactory="RoslynCodeTaskFactory"
	           AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<SourceFile ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Code Type="Fragment" Language="cs"><![CDATA[
if (System.IO.File.Exists(SourceFile))
{
    var original = System.IO.File.ReadAllText(SourceFile);
    var trimmed = System.Text.RegularExpressions.Regex.Replace(original, @"[ \t]+(\r?\n|$)", "$1");

    if (!string.Equals(original, trimmed, System.StringComparison.Ordinal))
    {
        System.IO.File.WriteAllText(SourceFile, trimmed, new System.Text.UTF8Encoding(false));
    }
}
]]></Code>
		</Task>
	</UsingTask>

	<Target Name="TrimGeneratedResourceWhitespace" AfterTargets="CoreResGen">
		<TrimTrailingWhitespace SourceFile="$(MSBuildProjectDirectory)/Resources/Strings/AppResources.Designer.cs"
		                        Condition="Exists('$(MSBuildProjectDirectory)/Resources/Strings/AppResources.Designer.cs')" />
	</Target>

</Project>
