@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject NavigationMemoryService NavMemory
@inject SentenceStudio.Abstractions.IPreferencesService Preferences
@inject IAppState AppState
@inject SentenceStudio.Services.Progress.ProgressCacheService CacheService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@inject IEnumerable<IHostNavItemProvider> HostNavProviders
@inject ILogger<NavMenu> Logger
@implements IDisposable

<nav class="nav flex-column p-2 gap-1">
    @foreach (var item in TopItems)
    {
        var key = item.Key;
        <a class="nav-link nav-link-ss rounded px-3 py-2 @(NavMemory.IsSectionActive(key) ? "active" : "")"
           href="" @onclick="() => NavigateToSection(key)" @onclick:preventDefault title="@item.Label">
            <i class="bi @item.Icon"></i> <span class="nav-label">@item.Label</span>
        </a>
    }

    <hr class="my-2" style="border-color: var(--bs-border-color);" />

    @foreach (var item in BottomItems)
    {
        var key = item.Key;
        <a class="nav-link nav-link-ss rounded px-3 py-2 @(NavMemory.IsSectionActive(key) ? "active" : "")"
           href="" @onclick="() => NavigateToSection(key)" @onclick:preventDefault title="@item.Label">
            <i class="bi @item.Icon"></i> <span class="nav-label">@item.Label</span>
        </a>
    }

    @foreach (var item in _hostItems)
    {
        <a class="nav-link nav-link-ss rounded px-3 py-2 @(IsHostItemActive(item) ? "active" : "")"
           href="@item.Href" @onclick="CloseOffcanvas" title="@item.Label">
            <i class="bi @item.Icon"></i> <span class="nav-label">@item.Label</span>
        </a>
    }

    <a class="nav-link nav-link-ss rounded px-3 py-2 text-danger"
       href="" @onclick="Logout" @onclick:preventDefault title="@Localize["Nav_Logout"]">
        <i class="bi bi-box-arrow-left"></i> <span class="nav-label">@Localize["Nav_Logout"]</span>
    </a>
</nav>

@code {
    private record NavItem(string Key, string Icon, string Label);

    private NavItem[] TopItems => new[]
    {
        new NavItem("dashboard",    "bi-house-door",         Localize["Nav_Dashboard"]),
        new NavItem("activity",     "bi-calendar3",          Localize["Nav_Activity"]),
        new NavItem("resources",    "bi-book",               Localize["Nav_LearningResources"]),
        new NavItem("vocabulary",   "bi-card-text",          Localize["Nav_Vocabulary"]),
        new NavItem("minimal-pairs","bi-soundwave",          Localize["Nav_MinimalPairs"]),
        new NavItem("skills",       "bi-bullseye",           Localize["Nav_Skills"]),
        new NavItem("import-content", "bi-box-arrow-in-down", Localize["Nav_ImportContent"]),
        new NavItem("media-import", "bi-camera-video",       Localize["Nav_MediaImport"]),
    };

    private NavItem[] BottomItems => new[]
    {
        new NavItem("profile",  "bi-person",    Localize["Nav_Profile"]),
        new NavItem("settings", "bi-gear",      Localize["Nav_Settings"]),
        new NavItem("feedback", "bi-chat-dots", Localize["Nav_Feedback"]),
    };

    // Entries the host app adds (the web app's Admin link). Empty on every host that registers none.
    private IReadOnlyList<HostNavItem> _hostItems = [];
    private bool _disposed;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Localize.CultureChanged += OnCultureChanged;
    }

    // Asked only once the page is interactive, so a prerender never spends a host's lookup.
    protected override Task OnInitializedAsync() => LoadHostItemsAsync();

    /// <summary>Asks every host provider for its entries. True when what is drawn changed.</summary>
    private async Task<bool> LoadHostItemsAsync()
    {
        if (!RendererInfo.IsInteractive || !HostNavProviders.Any())
        {
            return false;
        }

        var items = new List<HostNavItem>();
        foreach (var provider in HostNavProviders)
        {
            try
            {
                items.AddRange(await provider.GetItemsAsync());
            }
            catch (Exception ex)
            {
                // A host entry is optional; the learner's navigation must not depend on it.
                Logger.LogWarning(ex, "A host navigation provider failed; its entries are not shown");
            }
        }

        var changed = !items.SequenceEqual(_hostItems);
        _hostItems = items;
        return changed;
    }

    private bool IsHostItemActive(HostNavItem item)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        return path.Equals(item.Href, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(item.Href + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private async Task NavigateToSection(string sectionKey)
    {
        var route = NavMemory.GetSectionRoute(sectionKey);
        Nav.NavigateTo(route);
        await CloseOffcanvas();
    }

    private async Task Logout()
    {
        // Clear all caches to prevent stale cross-user data
        CacheService.InvalidateAll();

        // Clear auth state via the provider (clears JWT, refresh token, notifies Blazor)
        if (AuthStateProvider is IClientAuthStateNotifier nativeAuth)
        {
            await nativeAuth.LogOutAsync();
        }

        // Clear preferences
        Preferences.Set("app_is_authenticated", false);
        Preferences.Remove("active_profile_id");
        AppState.CurrentUserProfile = null;

        // Navigate to auth page
        var baseUri = Nav.BaseUri;
        var isWeb = BlazorHostKind.IsWebHost(baseUri);
        Nav.NavigateTo(isWeb ? "/account-action/SignOut" : "/auth/login", forceLoad: isWeb);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            StateHasChanged();

            // A provider answers from what it already knows, so this costs nothing on most
            // navigations; it is how an entry appears or goes once the host's answer changes.
            if (await LoadHostItemsAsync() && !_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private async Task CloseOffcanvas()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "bootstrap.Offcanvas.getInstance(document.getElementById('mobileNav'))?.hide()");
        }
        catch { /* ignore on desktop where offcanvas doesn't exist */ }
    }

    public void Dispose()
    {
        _disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
        Localize.CultureChanged -= OnCultureChanged;
    }
}
