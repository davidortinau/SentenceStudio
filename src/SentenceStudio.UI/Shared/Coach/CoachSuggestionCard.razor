@implements IDisposable
@inject BlazorLocalizationService Localize
@inject CoachWorkspaceState Coach

@* At most one pending suggestion card is ever mounted, and it exposes exactly ONE action
   pair. A clarification does not add actions: it re-frames the same binary choice in explicit
   terms, so the question appears and the accept label changes, but the learner never sees two
   competing pairs for one decision (LC-SUG-01 / LC-AMB-01).

   A suggestion changes nothing until it is explicitly accepted. Ambiguity leaves the card in
   its pending visual state, rationale and preview intact. *@

@if (Coach.PendingSuggestion is { } suggestion)
{
    var actions = CoachStateMachine.SuggestionActions(
        Coach.State,
        hasPendingSuggestion: true,
        hasClarification: LastClarification is not null);

    <div class="coach-card coach-card-suggestion"
         role="group"
         aria-label="@Localize["Coach_SuggestionLabel"]"
         aria-busy="@(Coach.IsBusy ? "true" : "false")">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-lightbulb" aria-hidden="true"></i>
            @* Rationale is a deterministic ENGLISH fallback the server builds from the same
               numbers as the projection. Whenever the projection is present it is the
               authoritative shape, so the localized summary replaces the fallback rather than
               sitting beside it. Non-focus suggestions have no projection and keep the
               rationale. *@
            <div id="coach-suggestion-rationale" class="coach-message">@Summary(suggestion)</div>
        </div>

        @* The exact set acceptance would apply — the frozen selection, in the server's order.
           It sits between the summary that introduces it and the actions that decide it, so a
           learner reads what they are agreeing to before reaching the buttons. *@
        @if (suggestion.VocabularyFocus is { } focus)
        {
            <div class="mt-2">
                <CoachVocabularyFocus Focus="@focus"
                                      HeadingLevel="4"
                                      HeadingTextKey="Coach_FocusProposed"
                                      IdPrefix="@($"coach-suggestion-focus-{suggestion.SuggestionId}")" />
            </div>
        }

        @* The focused question sits between the rationale it refines and the actions it
           governs, and is described by the rationale so it never reads as a competing offer. *@
        @if (actions.ShowClarification && LastClarification is { } clarification)
        {
            <div class="mt-3 pt-2 border-top">
                <div id="coach-suggestion-clarification"
                     class="coach-message"
                     aria-describedby="coach-suggestion-rationale">@clarification</div>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="button"
                    class="btn btn-ss-primary coach-action flex-grow-1"
                    disabled="@Coach.IsBusy"
                    aria-describedby="@(actions.ShowClarification ? "coach-suggestion-clarification" : "coach-suggestion-rationale")"
                    @onclick="AcceptAsync">
                @if (Coach.State == CoachUiState.Applying)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                @AcceptLabel(suggestion, actions)
            </button>
            <button type="button"
                    class="btn btn-ss-secondary coach-action flex-grow-1"
                    disabled="@Coach.IsBusy"
                    @onclick="RejectAsync">
                @Localize[actions.RejectLabelKey!]
            </button>
        </div>
    </div>
}
else if (showRejectedNote)
{
    @* A rejected suggestion must be visibly resolved, never silently vanish. *@
    <div class="coach-stage-row">
        <i class="bi bi-dash-circle" aria-hidden="true"></i>
        <span>@Localize["Coach_Rejected"]</span>
    </div>
}

@code {
    private bool showRejectedNote;
    private string? lastSuggestionId;

    protected override void OnInitialized()
    {
        Localize.CultureChanged += OnChanged;
        Coach.Changed += OnCoachChanged;
        lastSuggestionId = Coach.PendingSuggestion?.SuggestionId;
    }

    private string? LastClarification => Coach.Messages
        .LastOrDefault(m => m.Kind == CoachMessageKind.Clarification)?.Text;

    /// <summary>
    /// What introduces the suggestion.
    /// </summary>
    /// <remarks>
    /// <c>Rationale</c> is a deterministic English fallback assembled server-side from the same
    /// counts and label as the projection. When the projection is present it is authoritative and
    /// localizable, so the summary is generated from it and the English fallback is suppressed —
    /// showing both would say the same thing twice, in two languages. A suggestion that does not
    /// touch the focus carries no projection and keeps the rationale.
    /// </remarks>
    private string Summary(PendingCoachSuggestionDto suggestion) =>
        suggestion.VocabularyFocus is { } focus
            ? Localize.Get("Coach_FocusSuggestionSummary", FocusLabel(focus))
            : suggestion.Rationale;

    /// <summary>The server's localized label, with a neutral stand-in when it is blank.</summary>
    private string FocusLabel(CoachVocabularyFocusDto focus) =>
        string.IsNullOrWhiteSpace(focus.DisplayLabel)
            ? Localize["Coach_FocusGenericLabel"]
            : focus.DisplayLabel;

    /// <summary>
    /// The server-authored label wins when present so the action reads as the concrete change
    /// ("Include speaking"). A clarification overrides it: the whole point of asking is that the
    /// learner did not commit, so the answer must read as an unambiguous yes.
    /// </summary>
    private string AcceptLabel(PendingCoachSuggestionDto suggestion, CoachSuggestionActions actions)
    {
        if (actions.ShowClarification)
        {
            return Localize[actions.AcceptLabelKey!];
        }

        return string.IsNullOrWhiteSpace(suggestion.AcceptLabel)
            ? Localize[actions.AcceptLabelKey!]
            : suggestion.AcceptLabel;
    }

    private Task AcceptAsync() => Coach.AcceptSuggestionAsync();

    private Task RejectAsync() => Coach.RejectSuggestionAsync();

    private void OnCoachChanged()
    {
        var current = Coach.PendingSuggestion?.SuggestionId;
        if (lastSuggestionId is not null && current is null)
        {
            // Only show the resolved note when nothing was written. An accepted
            // suggestion collapses into the receipt instead.
            showRejectedNote = Coach.State is not (CoachUiState.PlanUpdated or CoachUiState.Applying);
        }
        else if (current is not null)
        {
            showRejectedNote = false;
        }

        lastSuggestionId = current;
        InvokeAsync(StateHasChanged);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Localize.CultureChanged -= OnChanged;
        Coach.Changed -= OnCoachChanged;
    }
}
