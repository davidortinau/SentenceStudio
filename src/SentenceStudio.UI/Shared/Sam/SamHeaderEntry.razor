@*
    Sam's entry in the page header, on every signed-in page except the main pages, which have the
    floating button instead (docs/sam-entry.md, SamEntryPlacementRule). Shown under the same gate
    as the floating button and hidden while the panel is open (SamEntryState). Opens the panel
    through the overlay host's own open path, so session resume, sizing and focus are the same.
    The button itself is SamFab in its header style, so both entries share one name and badge.
*@

@inject SamEntryState Entry
@inject NavigationManager Nav
@implements IDisposable

@if (Entry.IsAvailable && SamEntryPlacementRule.For(Nav) == SamEntryPlacement.Header)
{
    <SamFab Placement="SamEntryPlacement.Header"
            Id="@SamElementIds.HeaderEntry"
            HasUnread="Entry.HasUnread"
            OnOpen="OpenAsync" />
}

@code {
    private volatile bool _disposed;

    protected override void OnInitialized()
    {
        Entry.Changed += OnChanged;
    }

    private Task OpenAsync() => Entry.OpenAsync(SamElementIds.HeaderEntry);

    /// <summary>
    /// The entry state outlives this header, so a notification that lands mid-teardown must not
    /// render into a disposed component.
    /// </summary>
    private void OnChanged()
    {
        if (_disposed) return;

        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Entry.Changed -= OnChanged;
    }
}
