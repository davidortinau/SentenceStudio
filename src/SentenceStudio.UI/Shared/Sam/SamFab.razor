@*
    Sam's entry button, in one of two places (docs/sam-entry.md):
    - Floating: the round button in the bottom-right corner of the main pages, 48px, safe-area-aware.
    - Header: the icon in the PageHeader on every other page (SamHeaderEntry).
    Both share the accessible name, the panel wiring and the unread mark, so they cannot drift apart.
    The header style never carries the sam-fab class: the page's bottom room, the toast position
    and the hide on scroll all key off that class.
*@

@inject BlazorLocalizationService Localize
@inject CoachPersona Persona
@implements IDisposable

@{
    var name = Localize.Get("Coach_OpenNamed", Persona.DisplayName);
    var isHeader = Placement == SamEntryPlacement.Header;
    var cssClass = isHeader
        ? "btn btn-sm btn-icon text-primary-ss sam-header-entry"
        : _hasUnread ? "sam-fab sam-fab--unread" : "sam-fab";
}
<button type="button"
        id="@Id"
        class="@cssClass"
        aria-label="@name"
        title="@(isHeader ? name : null)"
        aria-expanded="false"
        aria-controls="@SamElementIds.Panel"
        @onclick="OnOpen">
    <i class="bi bi-chat-dots-fill" aria-hidden="true" style="@(isHeader ? "font-size: 1.25rem;" : null)"></i>
    @if (_hasUnread)
    {
        <span class="@(isHeader ? "sam-header-entry__badge" : "sam-fab__badge")" aria-label="@Localize["Coach_Unread"]"></span>
    }
</button>

@code {
    [Parameter] public EventCallback OnOpen { get; set; }
    [Parameter] public bool HasUnread { get; set; }
    [Parameter] public string Id { get; set; } = SamElementIds.Fab;

    /// <summary>Floating (the default) or Header; None is treated as Floating.</summary>
    [Parameter] public SamEntryPlacement Placement { get; set; } = SamEntryPlacement.Floating;

    private bool _hasUnread;
    private volatile bool _disposed;

    protected override void OnInitialized()
    {
        Localize.CultureChanged += OnChanged;
        Persona.Changed += OnChanged;
    }

    protected override void OnParametersSet()
    {
        _hasUnread = HasUnread;
    }

    /// <summary>
    /// Both events come from services that outlive this button, so a notification that lands
    /// mid-teardown must not render into a disposed component.
    /// </summary>
    private void OnChanged()
    {
        if (_disposed) return;

        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Localize.CultureChanged -= OnChanged;
        Persona.Changed -= OnChanged;
    }
}
