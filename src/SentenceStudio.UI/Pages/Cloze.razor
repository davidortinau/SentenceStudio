@page "/cloze"
@attribute [Authorize]
@using SentenceStudio.Shared.Services
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IAsyncDisposable

<div class="activity-page-wrapper">

<PageHeader Title='@Localize["Activity_Cloze"]' ShowBack="true" OnBack="GoBack" />

<div class="activity-content">
@if (showSessionSummary)
{
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
        <h2 class="ss-title1 mb-4"><i class="bi bi-journal-check me-2"></i>@Localize["Common_SessionComplete"]</h2>
        <div class="card card-ss p-4" style="min-width: 340px;">
            <div class="d-flex justify-content-around mb-3">
                <div class="text-center">
                    <div class="ss-title2 text-success">@sessionCorrectCount</div>
                    <small class="text-secondary-ss">@Localize["Common_Correct"]</small>
                </div>
                <div class="text-center">
                    <div class="ss-title2 text-danger">@(sessionTotalCount - sessionCorrectCount)</div>
                    <small class="text-secondary-ss">@Localize["Common_Incorrect"]</small>
                </div>
                <div class="text-center">
                    <div class="ss-title2" style="color: var(--bs-primary);">
                        @(sessionTotalCount > 0 ? (int)((float)sessionCorrectCount / sessionTotalCount * 100) : 0)%
                    </div>
                    <small class="text-secondary-ss">@Localize["Common_Accuracy"]</small>
                </div>
            </div>
        </div>
        <button class="btn btn-ss-primary mt-4" @onclick="ContinueAfterSummary">@Localize["Common_ContinuePractice"]</button>
        <button class="btn btn-ss-secondary mt-2" @onclick="GoBack">@Localize["Common_Done"]</button>
    </div>
}
else if (isBusy)
{
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 40vh;">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="ss-body1 text-secondary-ss">@Localize["Cloze_LoadingSentences"]</p>
    </div>
}
else if (sentences.Any())
{
    @* Sentence display with blank *@
    <div class="mb-4 px-3">
        <p class="ss-display" style="line-height: 1.3;">@displaySentence</p>
        @if (!string.IsNullOrEmpty(translationHint))
        {
            <p class="ss-body2 text-secondary-ss mt-2">@translationHint</p>
        }
    </div>

    @* Feedback *@
    @if (showFeedback)
    {
        <div class="alert @(lastWasCorrect ? "alert-success" : "alert-danger") py-2 mb-3">
            @feedbackMessage
        </div>
    }
}
else
{
    <div class="text-center p-5">
        @* A failed load is not "no sentences": the learner is told it failed and nothing was recorded. *@
        <p class="ss-body1 text-secondary-ss" role="@(loadErrorKey is null ? null : "alert")">
            @(loadErrorKey is null ? Localize["Cloze_NoSentences"] : Localize[loadErrorKey])
        </p>
        <button class="btn btn-ss-secondary mt-3" @onclick="GoBack">@Localize["Common_GoBack"]</button>
    </div>
}
</div>

@if (sentences.Any() && !showSessionSummary && !isBusy)
{
<div class="activity-input-bar">
    @* Multiple choice mode *@
    @if (inputMode == "MultipleChoice" && guessOptions != null && guessOptions.Length > 0)
    {
        <div class="d-flex flex-wrap gap-2 mb-2">
            @foreach (var option in guessOptions)
            {
                var opt = option;
                var bgClass = "";
                var borderStyle = "";

                if (hasBeenGraded)
                {
                    if (opt == correctWordAnswer)
                    {
                        bgClass = "bg-success text-white";
                        borderStyle = "border-color: var(--bs-success) !important;";
                    }
                    else if (opt == selectedOption && opt != correctWordAnswer)
                    {
                        bgClass = "bg-danger text-white";
                        borderStyle = "border-color: var(--bs-danger) !important;";
                    }
                }
                else if (opt == selectedOption)
                {
                    borderStyle = "border-color: var(--bs-primary) !important;";
                }

                <button class="btn btn-outline-secondary ss-body1 @bgClass"
                        style="@borderStyle"
                        disabled="@hasBeenGraded"
                        @onclick="() => OnOptionTapped(opt)">
                    @opt
                </button>
            }
        </div>
    }

    @* Input + actions row *@
    <form @onsubmit="SubmitInput" @onsubmit:preventDefault class="d-flex gap-2 mb-2">
        @if (inputMode == "Text")
        {
            <input type="text" class="form-control form-control-ss form-control-lg flex-grow-1"
                   @bind="userInput"
                   placeholder='@Localize["Cloze_TypeMissingWord"]' />
        }
        <button type="button" class="btn btn-ss-secondary" @onclick="ToggleMode">
            @(inputMode == "Text" ? Localize["Cloze_Choices"] : Localize["Cloze_Type"])
        </button>
        <button type="submit" class="btn btn-ss-primary"
                disabled="@hasBeenGraded">
            @Localize["Common_GoLabel"]
        </button>
    </form>

    @* Nav row *@
    <div class="d-flex justify-content-between align-items-center">
        <button class="btn btn-sm btn-ss-secondary" @onclick="PreviousSentence" disabled="@(GetCurrentIndex() <= 0)">
            <i class="bi bi-chevron-left"></i>
        </button>
        <span class="ss-body2 text-secondary-ss">@(GetCurrentIndex() + 1) / @sentences.Count</span>
        <button class="btn btn-sm btn-ss-secondary" @onclick="NextSentence">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
</div>
}

</div>

@code {
    [SupplyParameterFromQuery(Name = "resourceId")]
    public string? ResourceIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "skillId")]
    public string? SkillIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "planItemId")]
    public string? PlanItemId { get; set; }

    [SupplyParameterFromQuery(Name = "DueOnly")]
    public bool DueOnly { get; set; }

    [SupplyParameterFromQuery(Name = "FocusVocabularyIds")]
    public string? FocusVocabularyIdsParam { get; set; }

    [Inject] private ClozureService ClozureSvc { get; set; } = default!;
    [Inject] private UserActivityRepository ActivityRepo { get; set; } = default!;
    [Inject] private VocabularyProgressService ProgressService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ILogger<Cloze> Logger { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IPreferencesService Preferences { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.ProgressCacheService CacheService { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.IProgressService PlanProgressService { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Timer.IActivityTimerService ActivityTimer { get; set; } = default!;
    private SentenceStudio.Services.Timer.ActivityTimerLease? activityTimerLease;

    private bool isBusy;
    // The learner the session was loaded for. Answers are recorded only for this owner, and
    // only while it is still the active profile (fail closed).
    private string _owner = string.Empty;
    // Set when the sentences could not be loaded; shown instead of "No cloze sentences".
    private string? loadErrorKey;
    private bool showSessionSummary;
    private bool showFeedback;
    private bool lastWasCorrect;
    private bool hasBeenGraded;
    private string userInput = "";
    private string displaySentence = "";
    private string translationHint = "";
    private string feedbackMessage = "";
    private string inputMode = "Text";
    private string? selectedOption;
    private string? correctWordAnswer;
    private string[]? guessOptions;

    private int sessionCorrectCount;
    private int sessionTotalCount;

    private List<Challenge> sentences = new();

    protected override async Task OnInitializedAsync()
    {
        Localize.CultureChanged += OnCultureChanged;
        Logger.LogInformation("Cloze initialized — planItemId={PlanItemId}", PlanItemId ?? "(none)");
        activityTimerLease = ActivityTimer.StartSession("Cloze", PlanItemId, ResourceIdParam, SkillIdParam);
        await LoadSentences();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadSentences()
    {
        loadErrorKey = null;
        sentences = new();
        _owner = Preferences.Get("active_profile_id", string.Empty);
        if (string.IsNullOrWhiteSpace(_owner))
        {
            Logger.LogWarning("Activity {ActivityName} opened without an active profile; nothing is loaded.", nameof(Cloze));
            loadErrorKey = "Vocabulary_NoActiveProfile";
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        isBusy = true;
        try
        {
            var focusVocabularyIds = FocusVocabularySelection.ParseFocusVocabularyIds(FocusVocabularyIdsParam);
            if (focusVocabularyIds.Count == 0)
            {
                Logger.LogWarning("Activity {ActivityName} launched without FocusVocabularyIds (planItemId={PlanItemId}); falling back to legacy selection", nameof(Cloze), PlanItemId);
            }

            var resourceId = DueOnly ? "" : (ResourceIdParam ?? "");
            var skillId = SkillIdParam ?? "";

            var result = await ClozureSvc.GetSentences(resourceId, 8, skillId, DueOnly, focusVocabularyIds);
            // Never show a sentence whose answer cannot be blanked: it would show the answer.
            var usable = (result ?? new List<Challenge>())
                .Where(challenge => ClozureAnswerHelper.TryBlankSentence(
                    challenge.SentenceText, challenge.VocabularyWordAsUsed, challenge.VocabularyWord) is not null)
                .ToList();
            if (usable.Any())
            {
                sentences = usable;
                sentences[0].IsCurrent = true;
                SetCurrentChallenge(sentences[0]);
            }
            else
            {
                Toast.ShowWarning(Localize["Cloze_NoSentences"]);
            }
        }
        catch (ClozeGenerationException ex)
        {
            Logger.LogError(ex, "Cloze sentences could not be generated");
            loadErrorKey = "NativeCloze_GenerationFailed";
            Toast.ShowError(Localize["NativeCloze_GenerationFailed"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading cloze sentences");
            loadErrorKey = "NativeActivity_LoadFailed";
            Toast.ShowError(Localize["NativeActivity_LoadFailed"]);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SetCurrentChallenge(Challenge challenge)
    {
        // The conjugated form is blanked, else the dictionary form. Sentences where neither can
        // be blanked were dropped at load, so the answer is never shown before it is given.
        displaySentence = ClozureAnswerHelper.TryBlankSentence(
            challenge.SentenceText, challenge.VocabularyWordAsUsed, challenge.VocabularyWord)
            ?? ClozureAnswerHelper.BlankMarker;
        translationHint = challenge.RecommendedTranslation ?? "";
        correctWordAnswer = challenge.VocabularyWordAsUsed;
        guessOptions = challenge.VocabularyWordGuesses?
            .Split(",").Select(x => x.Trim())
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct()
            .OrderBy(_ => Random.Shared.Next()).ToArray();
        userInput = "";
        selectedOption = null;
        hasBeenGraded = false;
        showFeedback = false;
        feedbackMessage = "";
    }

    private async Task GradeAnswer()
    {
        var current = sentences.FirstOrDefault(s => s.IsCurrent);
        if (current == null) return;

        var answer = inputMode == "MultipleChoice" ? selectedOption : userInput;
        if (string.IsNullOrWhiteSpace(answer)) return;

        var owner = _owner;
        if (!OwnerStillActive())
        {
            Logger.LogWarning("Cloze answer refused: the active profile changed or is absent.");
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        // Use lenient equality so Korean particle mismatches (밥 vs 밥을) don't
        // penalize a user who clearly knows the word. MultipleChoice keeps strict
        // matching since the options are explicit.
        bool isCorrect;
        if (inputMode == "MultipleChoice")
        {
            isCorrect = string.Equals(answer.Trim(), current.VocabularyWordAsUsed?.Trim(), StringComparison.OrdinalIgnoreCase);
        }
        else
        {
            isCorrect = SentenceStudio.Shared.Services.ClozureAnswerHelper.AreAnswersEquivalent(answer, current.VocabularyWordAsUsed);
        }
        hasBeenGraded = true;
        lastWasCorrect = isCorrect;
        showFeedback = true;
        feedbackMessage = isCorrect ? Localize["Cloze_CorrectExclamation"] : string.Format(Localize["Cloze_AnswerWas"], current.VocabularyWordAsUsed);

        sessionTotalCount++;
        if (isCorrect) sessionCorrectCount++;

        // Show the complete sentence on correct answer
        if (isCorrect)
            displaySentence = current.SentenceText ?? "";

        // Record user activity (UTC, the owner's)
        var saveFailed = false;
        try
        {
            var activity = new UserActivity
            {
                Activity = SentenceStudio.Shared.Models.Activity.Clozure.ToString(),
                Input = answer,
                Accuracy = isCorrect ? 100 : 0,
                UserProfileId = owner,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };
            current.UserActivity = activity;
            if (await ActivityRepo.SaveAsync(activity) < 0)
            {
                Logger.LogError("Cloze could not save its UserActivity row.");
                saveFailed = true;
            }

            // Record vocabulary progress if we can find the word
            if (current.Vocabulary?.Any() == true && OwnerStillActive())
            {
                var vocabWord = current.Vocabulary.FirstOrDefault(v =>
                    string.Equals(v.TargetLanguageTerm, current.VocabularyWord, StringComparison.OrdinalIgnoreCase))
                    ?? current.Vocabulary.FirstOrDefault(v =>
                        string.Equals(v.TargetLanguageTerm, current.VocabularyWordAsUsed, StringComparison.OrdinalIgnoreCase))
                    ?? (current.Vocabulary.Count == 1 ? current.Vocabulary.First() : null);

                if (vocabWord != null)
                {
                    var updatedProgress = await ProgressService.RecordAttemptAsync(new VocabularyAttempt
                    {
                        VocabularyWordId = vocabWord.Id,
                        UserId = owner,
                        Activity = "Clozure",
                        InputMode = inputMode,
                        WasCorrect = isCorrect,
                        DifficultyWeight = 1.2f,
                        ContextType = "Sentence",
                        UserInput = answer,
                        ExpectedAnswer = current.VocabularyWordAsUsed
                    });

                    // Handle verification probe for Familiar words
                    if (updatedProgress.IsFamiliar)
                    {
                        await ProgressService.HandleVerificationProbeResultAsync(
                            vocabWord.Id, owner, isCorrect);
                        if (isCorrect)
                            Toast.ShowSuccess(Localize["NativeCloze_FamiliarConfirmed"]);
                        else
                            Toast.ShowInfo(Localize["NativeCloze_FamiliarTricky"]);
                    }

                    CacheService.InvalidateVocabSummary();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error recording cloze activity");
            saveFailed = true;
        }

        if (saveFailed)
            Toast.ShowError(Localize["NativeCommon_SaveFailed"]);

        if (isCorrect)
        {
            StateHasChanged();
            await Task.Delay(1200);
            NextSentence();
        }
    }

    private bool OwnerStillActive() =>
        !string.IsNullOrWhiteSpace(_owner)
        && string.Equals(_owner, Preferences.Get("active_profile_id", string.Empty), StringComparison.Ordinal);

    private void OnOptionTapped(string option)
    {
        if (hasBeenGraded) return;
        selectedOption = option;
        _ = GradeAnswer();
    }

    private async Task SubmitInput()
    {
        await GradeAnswer();
    }

    private void JumpTo(int index)
    {
        if (index < 0 || index >= sentences.Count) return;
        foreach (var s in sentences) s.IsCurrent = false;
        sentences[index].IsCurrent = true;
        SetCurrentChallenge(sentences[index]);
    }

    private void NextSentence()
    {
        var idx = GetCurrentIndex();
        if (idx >= sentences.Count - 1)
        {
            showSessionSummary = true;
            return;
        }
        JumpTo(idx + 1);
    }

    private void PreviousSentence()
    {
        var idx = GetCurrentIndex();
        if (idx > 0) JumpTo(idx - 1);
    }

    private int GetCurrentIndex()
    {
        var current = sentences.FirstOrDefault(s => s.IsCurrent);
        return current != null ? sentences.IndexOf(current) : -1;
    }

    private async Task ContinueAfterSummary()
    {
        showSessionSummary = false;
        sessionCorrectCount = 0;
        sessionTotalCount = 0;
        await LoadSentences();
    }

    private void ToggleMode()
    {
        inputMode = inputMode == "Text" ? "MultipleChoice" : "Text";
    }

    private void GoBack()
    {
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
        NavManager.NavigateTo("/");
    }

    public ValueTask DisposeAsync()
    {
        Localize.CultureChanged -= OnCultureChanged;
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
        return ValueTask.CompletedTask;
    }
}
