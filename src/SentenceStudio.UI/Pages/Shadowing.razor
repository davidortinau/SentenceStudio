@page "/shadowing"
@attribute [Authorize]
@using Microsoft.JSInterop
@using SentenceStudio.Shared.Models
@using SentenceStudio.Services
@using SentenceStudio.Services.Speech
@using SentenceStudio.Services.Timer
@using SentenceStudio.Abstractions
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IAsyncDisposable

<div class="activity-page-wrapper">

<PageHeader Title='@Localize["Activity_Shadowing"]' ShowBack="true" OnBack="GoBack" />

<div class="activity-content">
@if (isBusy)
{
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 40vh;">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="ss-body1 text-secondary-ss">@Localize["Shadowing_GeneratingSentences"]</p>
    </div>
}
else if (sentences.Any())
{
    @* Activity Timer *@
    @if (fromPlan)
    {
        <ActivityTimer IsActive="true" TargetMinutes="targetMinutes" />
    }

    @* Current sentence card *@
    <div class="card card-ss p-4 mb-3 text-center">
        <p class="ss-display mb-2" style="line-height: 1.4;">@currentSentence.TargetLanguageText</p>
        @if (showTranslation && !string.IsNullOrEmpty(currentSentence.NativeLanguageText))
        {
            <p class="ss-body1 text-secondary-ss mb-2">@currentSentence.NativeLanguageText</p>
        }
        @if (!string.IsNullOrEmpty(currentSentence.PronunciationNotes))
        {
            <small class="text-secondary-ss fst-italic">@currentSentence.PronunciationNotes</small>
        }
        @if (!string.IsNullOrEmpty(currentSentence.NativeLanguageText))
        {
            <div class="mt-2">
                <button class="btn btn-sm btn-link text-secondary-ss" @onclick="ToggleTranslation">
                    @(showTranslation ? Localize["Shadowing_HideTranslation"] : Localize["Shadowing_ShowTranslation"]) @Localize["Shadowing_Translation"]
                </button>
            </div>
        }
    </div>

    @* Waveform display *@
    @if (waveformData is not null)
    {
        <WaveformDisplay
            WaveformData="@waveformData"
            Duration="@audioDuration"
            CurrentPosition="@playbackPosition"
            OnPositionChanged="HandleSeek" />
    }
}
else
{
    <div class="text-center p-5">
        <p class="ss-body1 text-secondary-ss">@Localize["Shadowing_NoSentences"]</p>
        <button class="btn btn-ss-secondary mt-3" @onclick="GoBack">@Localize["Common_GoBack"]</button>
    </div>
}
</div> @* end activity-content *@

@if (sentences.Any() && !isBusy)
{
    <div class="activity-footer">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <button class="btn btn-sm btn-ss-secondary" @onclick="PreviousSentence" disabled="@(currentIndex <= 0)">
                <i class="bi bi-chevron-left me-1"></i> @Localize["Shadowing_Prev"]
            </button>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm @(playbackSpeed == 0.6f ? "btn-ss-primary" : "btn-ss-secondary")" @onclick="() => SetPlaybackSpeed(0.6f)"
                        disabled="@isBuffering">@Localize["Shadowing_Slow"]</button>
                <button class="btn btn-ss-primary px-4" @onclick="TogglePlayback"
                        disabled="@isBuffering">
                    @if (isBuffering)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi @(isAudioPlaying ? "bi-pause-fill" : "bi-play-fill")"></i>
                    }
                </button>
                <button class="btn btn-sm @(playbackSpeed == 1.0f ? "btn-ss-primary" : "btn-ss-secondary")" @onclick="() => SetPlaybackSpeed(1.0f)"
                        disabled="@isBuffering">@Localize["Shadowing_Normal"]</button>
            </div>
            <button class="btn btn-sm btn-ss-secondary" @onclick="NextSentence" disabled="@(currentIndex >= sentences.Count - 1)">
                @Localize["Shadowing_Next"] <i class="bi bi-chevron-right ms-1"></i>
            </button>
        </div>
        <div class="text-center">
            <span class="ss-caption1 text-secondary-ss">@(currentIndex + 1) / @sentences.Count</span>
        </div>
    </div>
}

</div> @* end activity-page-wrapper *@

@code {
    [SupplyParameterFromQuery(Name = "resourceId")]
    public string? ResourceIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "skillId")]
    public string? SkillIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "fromPlan")]
    public bool FromPlanParam { get; set; }

    [SupplyParameterFromQuery(Name = "targetMinutes")]
    public int? TargetMinutesParam { get; set; }

    [SupplyParameterFromQuery(Name = "planItemId")]
    public string? PlanItemId { get; set; }

    [Inject] private ShadowingService ShadowingSvc { get; set; } = default!;
    [Inject] private ElevenLabsSpeechService SpeechService { get; set; } = default!;
    [Inject] private SpeechVoicePreferences VoicePrefs { get; set; } = default!;
    [Inject] private UserProfileRepository ProfileRepo { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IFileSystemService FileSystemService { get; set; } = default!;
    [Inject] private IAudioPlayerFactory AudioPlayerFactory { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ILogger<Shadowing> Logger { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.IProgressService PlanProgressService { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Timer.IActivityTimerService ActivityTimer { get; set; } = default!;
    private SentenceStudio.Services.Timer.ActivityTimerLease? activityTimerLease;

    private bool isBusy;
    private bool isBuffering;
    private bool isAudioPlaying;
    private bool _useJsAudio;
    private bool _browserAudioAttempted;
    private bool _disposed;
    private readonly CancellationTokenSource _audioLifetime = new();
    private bool showTranslation;
    private bool fromPlan;
    private int targetMinutes;
    private int currentIndex;
    private float playbackSpeed = 1.0f;
    private double playbackPosition;
    private TimeSpan audioDuration = TimeSpan.Zero;
    private float[]? waveformData;
    private string voiceId = "";

    private List<ShadowingSentence> sentences = new();
    private ShadowingSentence currentSentence = new();
    private readonly UiAudioPlayerSession _nativeAudio = new();
    private IUiAudioPlayer? audioPlayer => _nativeAudio.Player;
    private System.Threading.Timer? _playbackTimer;

    protected override async Task OnInitializedAsync()
    {
        Localize.CultureChanged += OnCultureChanged;
        Logger.LogInformation("🎯 Shadowing initialized — planItemId={PlanItemId}", PlanItemId ?? "(none)");
        activityTimerLease = ActivityTimer.StartSession("Shadowing", PlanItemId, ResourceIdParam, SkillIdParam);
        _useJsAudio = !AudioPlayerFactory.CanPlayLocally;
        fromPlan = FromPlanParam;
        targetMinutes = TargetMinutesParam ?? 15;

        try
        {
            var profile = await ProfileRepo.GetAsync();
            voiceId = VoicePrefs.GetVoiceForLanguage(profile?.TargetLanguage ?? "Korean");

            await LoadSentences();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize shadowing");
            Toast.ShowError("Could not load shadowing exercise.");
        }
    }

    private async Task LoadSentences()
    {
        if (string.IsNullOrEmpty(ResourceIdParam)) return;
        isBusy = true;
        try
        {
            var result = await ShadowingSvc.GetOrGenerateSentencesAsync(
                ResourceIdParam, 10, SkillIdParam ?? "");
            sentences = result ?? new();

            if (sentences.Any())
            {
                currentIndex = 0;
                currentSentence = sentences[0];
                await GenerateAudioForCurrent();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load sentences");
            Toast.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task GenerateAudioForCurrent()
    {
        if (_disposed || string.IsNullOrEmpty(currentSentence.TargetLanguageText)) return;
        isBuffering = true;
        StateHasChanged();

        try
        {
            var vid = !string.IsNullOrEmpty(voiceId) ? voiceId : "echo";
            // Save to temp and prepare for playback
            var cacheDir = Path.Combine(FileSystemService.AppDataDirectory, "Cache");
            Directory.CreateDirectory(cacheDir);
            var tempPath = Path.Combine(cacheDir, $"shadow_{currentIndex}_{Guid.NewGuid():N}.mp3");
            using var stream = await SpeechService.TextToSpeechAsync(
                currentSentence.TargetLanguageText, vid, speed: playbackSpeed);
            if (_disposed) return;
            using (var fs = File.Create(tempPath))
            {
                await stream.CopyToAsync(fs, _audioLifetime.Token);
            }

            await StopAudioAsync();
            if (_disposed) return;

            if (_useJsAudio)
            {
                var bytes = await File.ReadAllBytesAsync(tempPath, _audioLifetime.Token);
                if (_disposed) return;
                _browserAudioAttempted = true;
                await BrowserAudioPlayback.PlayAsync(JS, bytes, _audioLifetime.Token);
                if (_disposed) return;
                var duration = await JS.InvokeAsync<double>("audioInterop.getDuration", _audioLifetime.Token);
                if (!double.IsFinite(duration) || duration <= 0)
                    throw new InvalidOperationException("The browser audio duration is unavailable.");
                if (_disposed) return;
                audioDuration = TimeSpan.FromSeconds(duration);
                isAudioPlaying = true;
            }
            else
            {
                var player = _nativeAudio.CreatePlayer(AudioPlayerFactory, File.OpenRead(tempPath));
                player.PlaybackEnded += (s, e) =>
                {
                    if (!ReferenceEquals(player, audioPlayer)) return;
                    isAudioPlaying = false;
                    StopPlaybackTimer();
                    InvokeAsync(StateHasChanged);
                };
                audioDuration = TimeSpan.FromSeconds(player.Duration);
            }

            // Generate simple placeholder waveform
            waveformData = GeneratePlaceholderWaveform();
            playbackPosition = 0;
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            try
            {
                await StopAudioAsync();
            }
            catch (JSDisconnectedException)
            {
                // Playback failed while the browser disconnected.
            }
            catch (InvalidOperationException) when (_disposed)
            {
                // Browser JS is unavailable during prerender or disposal.
            }
            waveformData = null;
            if (!_disposed)
            {
                Logger.LogError(ex, "Failed to generate audio");
                Toast.ShowError("Audio playback failed.");
            }
        }
        finally
        {
            isBuffering = false;
        }
    }

    private static float[] GeneratePlaceholderWaveform()
    {
        var rng = new Random(42);
        var data = new float[200];
        for (int i = 0; i < data.Length; i++)
            data[i] = (float)(0.3 + rng.NextDouble() * 0.7);
        return data;
    }

    private async Task TogglePlayback()
    {
        if (_useJsAudio)
        {
            if (!isAudioPlaying)
            {
                await GenerateAudioForCurrent();
                if (isAudioPlaying)
                    StartPlaybackTimer();
            }
            else
            {
                await JS.InvokeVoidAsync("audioInterop.stop");
                _browserAudioAttempted = false;
                isAudioPlaying = false;
                StopPlaybackTimer();
            }
            return;
        }

        if (audioPlayer is null)
        {
            await GenerateAudioForCurrent();
            if (audioPlayer is null) return;
            audioPlayer.Play();
            isAudioPlaying = true;
            StartPlaybackTimer();
            return;
        }

        if (isAudioPlaying)
        {
            audioPlayer.Pause();
            isAudioPlaying = false;
            StopPlaybackTimer();
        }
        else
        {
            // If playback completed, seek to start before replaying
            if (audioPlayer.CurrentPosition >= audioPlayer.Duration - 0.1)
            {
                audioPlayer.Seek(0);
            }
            audioPlayer.Play();
            isAudioPlaying = true;
            StartPlaybackTimer();
        }
    }

    private async Task SetPlaybackSpeed(float speed)
    {
        playbackSpeed = speed;
        await StopAudioAsync();
        await GenerateAudioForCurrent();
        if (_useJsAudio)
        {
            if (isAudioPlaying)
                StartPlaybackTimer();
        }
        else if (audioPlayer is not null)
        {
            audioPlayer.Play();
            isAudioPlaying = true;
            StartPlaybackTimer();
        }
    }

    private Task HandleSeek(double position)
    {
        playbackPosition = position;
        if (audioPlayer is not null)
        {
            audioPlayer.Seek(position * audioPlayer.Duration);
        }
        return Task.CompletedTask;
    }

    private async Task NextSentence()
    {
        if (currentIndex >= sentences.Count - 1) return;
        await StopAudioAsync();
        currentIndex++;
        currentSentence = sentences[currentIndex];
        showTranslation = false;
        playbackPosition = 0;
        waveformData = null;
        await GenerateAudioForCurrent();
    }

    private async Task PreviousSentence()
    {
        if (currentIndex <= 0) return;
        await StopAudioAsync();
        currentIndex--;
        currentSentence = sentences[currentIndex];
        showTranslation = false;
        playbackPosition = 0;
        waveformData = null;
        await GenerateAudioForCurrent();
    }

    private void StartPlaybackTimer()
    {
        StopPlaybackTimer();
        _playbackTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                if (audioPlayer is not null && isAudioPlaying)
                {
                    var duration = audioPlayer.Duration;
                    if (duration > 0)
                    {
                        playbackPosition = audioPlayer.CurrentPosition / duration;

                        // Auto-stop when playback reaches the end
                        if (audioPlayer.CurrentPosition >= duration - 0.05)
                        {
                            isAudioPlaying = false;
                            playbackPosition = 1.0;
                            StopPlaybackTimer();
                        }
                    }
                    await InvokeAsync(StateHasChanged);
                }
                else if (_useJsAudio && isAudioPlaying)
                {
                    // For JS audio, estimate position based on elapsed time
                    if (audioDuration.TotalSeconds > 0)
                    {
                        playbackPosition = Math.Min(1.0, playbackPosition + (0.1 / audioDuration.TotalSeconds));
                        if (playbackPosition >= 1.0)
                        {
                            isAudioPlaying = false;
                            StopPlaybackTimer();
                        }
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch (ObjectDisposedException)
            {
                // Component disposed during timer callback — ignore
            }
        }, null, 0, 100);
    }

    private void StopPlaybackTimer()
    {
        _playbackTimer?.Dispose();
        _playbackTimer = null;
    }

    private void ToggleTranslation() => showTranslation = !showTranslation;

    private async Task StopAudioAsync()
    {
        StopPlaybackTimer();
        _nativeAudio.Stop();
        isAudioPlaying = false;
        if (_browserAudioAttempted)
        {
            _browserAudioAttempted = false;
            await JS.InvokeVoidAsync("audioInterop.stop");
        }
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private void GoBack()
    {
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
        NavManager.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        try
        {
            _audioLifetime.Cancel();
        }
        finally
        {
            try
            {
                Localize.CultureChanged -= OnCultureChanged;
            }
            finally
            {
                try
                {
                    ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
                }
                finally
                {
                    try
                    {
                        StopPlaybackTimer();
                    }
                    finally
                    {
                        isAudioPlaying = false;
                        try
                        {
                            _nativeAudio.Dispose();
                        }
                        finally
                        {
                            try
                            {
                                if (_browserAudioAttempted)
                                {
                                    _browserAudioAttempted = false;
                                    try
                                    {
                                        await JS.InvokeVoidAsync("audioInterop.stop");
                                    }
                                    catch (Exception ex)
                                    {
                                        Logger.LogWarning(ex, "Failed to stop shadowing browser audio during disposal");
                                    }
                                }
                            }
                            finally
                            {
                                _audioLifetime.Dispose();
                            }
                        }
                    }
                }
            }
        }
    }
}
