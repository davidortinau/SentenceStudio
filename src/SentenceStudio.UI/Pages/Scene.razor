@page "/scene"
@attribute [Authorize]
@using SentenceStudio.Shared.Models
@using SentenceStudio.Services
@using SentenceStudio.Services.Timer
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IAsyncDisposable

<div class="activity-page-wrapper">

<PageHeader Title='@Localize["Activity_DescribeScene"]' ShowBack="true" OnBack="GoBack">
    <ToolbarActions>
        <button class="btn btn-sm btn-icon text-secondary-ss" @onclick="OpenGallery" title='@Localize["Scene_ImageGallery"]' aria-label='@Localize["Scene_ImageGallery"]'>
            <i class="bi bi-images" style="font-size: 1.25rem;"></i>
        </button>
    </ToolbarActions>
</PageHeader>

@if (isBusy && string.IsNullOrEmpty(imageUrl))
{
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 40vh;">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="ss-body1 text-secondary-ss">@Localize["Scene_LoadingScene"]</p>
    </div>
}
else if (!string.IsNullOrEmpty(imageUrl))
{
    @if (fromPlan)
    {
        <ActivityTimer IsActive="true" TargetMinutes="targetMinutes" />
    }

    @* Scrollable content area *@
    <div class="activity-content">
        <div class="row g-3">
            @* Scene image *@
            <div class="col-md-6">
                <div class="card card-ss p-2 text-center">
                    <img src="@imageUrl" alt='@Localize["NativeScene_SceneImage"]' class="img-fluid rounded" style="max-height: 400px; object-fit: contain;" />
                </div>
            </div>

            @* Graded sentences *@
            <div class="col-md-6">
                <h3 class="ss-title3 mb-3">@Localize["Scene_Results"]</h3>
                @if (gradedSentences.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var sentence in gradedSentences)
                        {
                            var color = sentence.Accuracy >= 80 ? "success" : sentence.Accuracy >= 50 ? "warning" : "danger";
                            <div class="card card-ss p-3" style="border-left: 4px solid var(--bs-@color);">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <p class="ss-body1 fw-bold mb-0">@sentence.Answer</p>
                                    <span class="badge bg-@color">@((int)sentence.Accuracy)%</span>
                                </div>
                                @if (!string.IsNullOrEmpty(sentence.AccuracyExplanation))
                                {
                                    <small class="text-secondary-ss">@sentence.AccuracyExplanation</small>
                                }
                                @if (!string.IsNullOrEmpty(sentence.RecommendedSentence))
                                {
                                    <div class="mt-1">
                                        <small class="text-success"><i class="bi bi-lightbulb me-1"></i>@sentence.RecommendedSentence</small>
                                    </div>
                                }

                                @if (expandedSentenceIndex == gradedSentences.IndexOf(sentence))
                                {
                                    <div class="mt-2 pt-2 border-top border-secondary-subtle">
                                        @if (sentence.Fluency > 0)
                                        {
                                            <small class="d-block text-secondary-ss">@Localize["Writing_Fluency"]: @((int)sentence.Fluency)%</small>
                                        }
                                        @if (!string.IsNullOrEmpty(sentence.FluencyExplanation))
                                        {
                                            <small class="d-block text-secondary-ss">@sentence.FluencyExplanation</small>
                                        }
                                        @if (!string.IsNullOrEmpty(sentence.GrammarNotes))
                                        {
                                            <small class="d-block text-secondary-ss mt-1"><i class="bi bi-pencil me-1"></i>@sentence.GrammarNotes</small>
                                        }
                                    </div>
                                }

                                <button class="btn btn-sm btn-link p-0 mt-1 text-secondary-ss text-start"
                                        @onclick="() => ToggleExpand(gradedSentences.IndexOf(sentence))">
                                    @(expandedSentenceIndex == gradedSentences.IndexOf(sentence) ? "Less ▲" : "More ▼")
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-secondary-ss ss-body2">@Localize["Scene_SubmitDescription"]</p>
                }
            </div>
        </div>
    </div>

    @* Sticky input bar — always anchored to bottom of viewport *@
    <div class="activity-input-bar">
        <form @onsubmit="SubmitDescription" @onsubmit:preventDefault class="d-flex gap-2 align-items-center">
            <input type="text" class="form-control form-control-ss flex-grow-1"
                   @bind="userInput"
                   placeholder='@Localize["Scene_DescribeWhatYouSee"]' />
            <button type="button" class="btn btn-ss-secondary btn-sm" @onclick="LoadNewScene" title='@Localize["Scene_LoadingScene"]'>
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button type="submit" class="btn btn-ss-primary"
                    disabled="@isGrading" title='@Localize["Writing_Grade"]' aria-label='@Localize["Writing_Grade"]'>
                @if (isGrading)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <i class="bi bi-send"></i>
                }
            </button>
        </form>
    </div>
}
else
{
    <div class="text-center p-5">
        <p class="ss-body1 text-secondary-ss">@Localize["Scene_NoSceneImages"]</p>
        <button class="btn btn-ss-primary mt-2" @onclick="OpenGallery"><i class="bi bi-images me-1"></i> @Localize["Scene_BrowseGallery"]</button>
        <button class="btn btn-ss-secondary mt-2 ms-2" @onclick="GoBack">@Localize["Common_GoBack"]</button>
    </div>
}

</div> @* end activity-page-wrapper *@

@* ─── Image Gallery Overlay ─── *@
@if (showGallery)
{
    <div class="scene-gallery-backdrop" @onclick="CloseGallery"></div>
    <div class="scene-gallery-overlay">
        @* Header *@
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
            <h2 class="ss-title2 mb-0">@Localize["Scene_ImageGallery"]</h2>
            <div class="d-flex gap-1">
                @if (isSelecting)
                {
                    <button class="btn btn-sm btn-ss-danger" @onclick="DeleteSelectedImages"
                            disabled="@(!selectedImageIds.Any())">
                        <i class="bi bi-trash me-1"></i> @string.Format(Localize["Scene_Delete"], selectedImageIds.Count)
                    </button>
                }
                <button class="btn btn-sm btn-icon text-secondary-ss" @onclick="ToggleSelectMode" title='@Localize["NativeScene_SelectMultiple"]' aria-label='@Localize["NativeScene_SelectMultiple"]'>
                    <i class="bi bi-check2-square" style="font-size: 1.25rem;"></i>
                </button>
                <button class="btn btn-sm btn-icon text-secondary-ss" @onclick="CloseGallery" title='@Localize["Common_Cancel"]'>
                    <i class="bi bi-x-lg" style="font-size: 1.25rem;"></i>
                </button>
            </div>
        </div>

        @* Add image bar *@
        <div class="d-flex gap-2 p-3 border-bottom">
            <input type="url" class="form-control form-control-ss flex-grow-1"
                   @bind="newImageUrl" placeholder='@Localize["Scene_PasteImageURL"]' />
            <button class="btn btn-ss-primary" @onclick="AddImage"
                    disabled="@string.IsNullOrWhiteSpace(newImageUrl)">
                <i class="bi bi-plus-lg me-1"></i> @Localize["Scene_AddImage"]
            </button>
        </div>

        @* Image grid *@
        <div class="scene-gallery-grid p-3">
            @if (isLoadingGallery)
            {
                <div class="text-center p-4">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (!galleryImages.Any())
            {
                <div class="text-center p-4">
                    <p class="text-secondary-ss ss-body2">No cached images yet. Paste a URL above to add one.</p>
                </div>
            }
            else
            {
                @foreach (var img in galleryImages)
                {
                    var isActive = img.Url == imageUrl;
                    var isChecked = selectedImageIds.Contains(img.Id);
                    <div class="scene-gallery-item @(isActive ? "active" : "") @(isChecked ? "selected" : "")"
                         @onclick="() => OnGalleryItemClick(img)">
                        <img src="@img.Url" alt="@(img.Description ?? "Scene")" loading="lazy" />
                        @if (isActive)
                        {
                            <span class="scene-gallery-active-badge">@Localize["Scene_Current"]</span>
                        }
                        @if (isSelecting)
                        {
                            <div class="scene-gallery-checkbox">
                                <i class="bi @(isChecked ? "bi-check-circle-fill text-primary" : "bi-circle")"
                                   style="font-size: 1.25rem;"></i>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "fromPlan")]
    public bool FromPlanParam { get; set; }

    [SupplyParameterFromQuery(Name = "targetMinutes")]
    public int? TargetMinutesParam { get; set; }

    [SupplyParameterFromQuery(Name = "planItemId")]
    public string? PlanItemId { get; set; }

    [SupplyParameterFromQuery(Name = "resourceId")]
    public string? ResourceIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "skillId")]
    public string? SkillIdParam { get; set; }

    [Inject] private SceneImageService SceneSvc { get; set; } = default!;
    [Inject] private TeacherService TeacherSvc { get; set; } = default!;
    [Inject] private UserProfileRepository ProfileRepo { get; set; } = default!;
    [Inject] private UserActivityRepository ActivityRepo { get; set; } = default!;
    [Inject] private LearningResourceRepository ResourceRepo { get; set; } = default!;
    [Inject] private VocabularyProgressService ProgressService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ILogger<Scene> Logger { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IPreferencesService Preferences { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.IProgressService PlanProgressService { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.ProgressCacheService CacheService { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Timer.IActivityTimerService ActivityTimer { get; set; } = default!;
    private SentenceStudio.Services.Timer.ActivityTimerLease? activityTimerLease;

    private bool isBusy;
    private bool isGrading;
    // The learner the page was opened for. Grades are recorded and words scored only for this
    // owner, and only while it is still the active profile (fail closed).
    private string _owner = string.Empty;
    // Bumped when the scene changes and when the learner leaves, so a grade that was in flight
    // lands nowhere and records nothing.
    private long _generation;
    private bool _leaving;
    private bool fromPlan;
    private int targetMinutes;
    private string imageUrl = "";
    private string sceneDescription = "";
    private string userInput = "";
    private string targetLanguage = "Korean";
    private string nativeLanguage = "English";
    private int expandedSentenceIndex = -1;
    private List<Sentence> gradedSentences = new();
    private List<VocabularyWord> userVocabulary = new();

    // Gallery state
    private bool showGallery;
    private bool isLoadingGallery;
    private bool isSelecting;
    private string newImageUrl = "";
    private List<SceneImage> galleryImages = new();
    private HashSet<string> selectedImageIds = new();
    private string? currentSceneId;

    protected override async Task OnInitializedAsync()
    {
        Localize.CultureChanged += OnCultureChanged;
        Logger.LogInformation("🎯 Scene initialized — planItemId={PlanItemId}, resourceId={ResourceId}, skillId={SkillId}",
            PlanItemId ?? "(none)", ResourceIdParam ?? "(none)", SkillIdParam ?? "(none)");
        activityTimerLease = ActivityTimer.StartSession("SceneDescription", PlanItemId, ResourceIdParam, SkillIdParam);
        fromPlan = FromPlanParam;
        targetMinutes = TargetMinutesParam ?? 10;

        _owner = Preferences.Get("active_profile_id", string.Empty);
        if (string.IsNullOrWhiteSpace(_owner))
        {
            Logger.LogWarning("Activity {ActivityName} opened without an active profile; nothing is loaded.", nameof(Scene));
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        try
        {
            var profile = await ProfileRepo.GetByIdAsync(_owner);
            targetLanguage = profile?.TargetLanguage ?? "Korean";
            nativeLanguage = profile?.NativeLanguage ?? "English";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Describe a Scene could not read the learner's languages; using the defaults.");
        }

        try
        {
            // Only the owner's words (those in the owner's resources) can be scored.
            userVocabulary = await ResourceRepo.GetAllVocabularyWordsWithResourcesAsync(_owner) ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Describe a Scene could not load vocabulary; grades will not score words.");
            userVocabulary = new();
        }

        await LoadNewScene();
    }

    private async Task LoadNewScene()
    {
        if (!OwnerStillActive())
        {
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        isBusy = true;
        try
        {
            var scene = await SceneSvc.GetRandomAsync();
            if (scene is not null)
            {
                // A grade in flight belongs to the scene it was written for.
                _generation++;
                imageUrl = scene.Url ?? "";
                sceneDescription = scene.Description ?? "";
                currentSceneId = scene.Id;
            }
            else
            {
                Toast.ShowWarning(Localize["NativeScene_NoImagesFound"]);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load scene");
            Toast.ShowError(Localize["NativeScene_LoadFailed"]);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SubmitDescription()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isGrading) return;

        var owner = _owner;
        if (!OwnerStillActive())
        {
            Logger.LogWarning("Describe a Scene grade refused: the active profile changed or is absent.");
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        var input = userInput.Trim();
        var scene = sceneDescription;
        var generation = _generation;
        userInput = "";
        isGrading = true;
        StateHasChanged();

        try
        {
            GradeResponse grade;
            try
            {
                grade = await TeacherSvc.GradeDescription(input, scene, targetLanguage, nativeLanguage);
            }
            catch (Exception ex)
            {
                // No grade: nothing is shown as a score and nothing is recorded.
                Logger.LogError(ex, "Error grading description");
                if (!IsSuperseded(generation, owner))
                    Toast.ShowError(Localize["NativeScene_GradeFailed"]);
                return;
            }

            // Leaving the page, another scene, or a profile change while the grade was in
            // flight supersedes it: the late result is not shown and nothing is recorded.
            if (IsSuperseded(generation, owner))
            {
                Logger.LogInformation("Describe a Scene grade discarded: superseded while it was in flight.");
                return;
            }

            var sentence = new Sentence
            {
                Answer = input,
                Accuracy = grade.Accuracy,
                AccuracyExplanation = grade.AccuracyExplanation,
                Fluency = grade.Fluency,
                FluencyExplanation = grade.FluencyExplanation,
                RecommendedSentence = grade.GrammarNotes?.RecommendedTranslation ?? grade.RecommendedTranslation,
                GrammarNotes = grade.GrammarNotes?.Explanation
            };
            gradedSentences.Insert(0, sentence);

            var saveFailed = false;
            var saved = await ActivityRepo.SaveAsync(new UserActivity
            {
                Activity = SentenceStudio.Shared.Models.Activity.SceneDescription.ToString(),
                Input = input,
                Accuracy = grade.Accuracy,
                Fluency = grade.Fluency,
                UserProfileId = owner,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            });
            if (saved < 0)
            {
                Logger.LogError("Describe a Scene could not save its UserActivity row.");
                saveFailed = true;
            }

            // Record vocabulary progress via shared extraction pipeline, for the owner's words only.
            if (userVocabulary.Count > 0 && OwnerStillActive())
            {
                try
                {
                    await ProgressService.ExtractAndScoreVocabularyAsync(
                        grade.VocabularyAnalysis, userVocabulary, owner,
                        activity: "SceneDescription", difficultyWeight: 1.5f);
                    CacheService.InvalidateVocabSummary();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Describe a Scene could not score vocabulary for a grade.");
                    saveFailed = true;
                }
            }

            var labelKey = grade.Accuracy >= 80 ? "NativeScene_GradeExcellent"
                : grade.Accuracy >= 50 ? "NativeScene_GradeGood"
                : "NativeScene_GradeKeepPracticing";
            Toast.ShowSuccess(Localize.Get(labelKey, (int)grade.Accuracy));
            if (saveFailed)
                Toast.ShowError(Localize["NativeCommon_SaveFailed"]);
        }
        finally
        {
            isGrading = false;
        }
    }

    private bool OwnerStillActive() =>
        !string.IsNullOrWhiteSpace(_owner)
        && string.Equals(_owner, Preferences.Get("active_profile_id", string.Empty), StringComparison.Ordinal);

    private bool IsSuperseded(long generation, string owner) =>
        _leaving || generation != _generation
        || !string.Equals(owner, _owner, StringComparison.Ordinal) || !OwnerStillActive();

    private void ToggleExpand(int index)
    {
        expandedSentenceIndex = expandedSentenceIndex == index ? -1 : index;
    }

    // ─── Gallery methods ───

    private async Task OpenGallery()
    {
        showGallery = true;
        isLoadingGallery = true;
        isSelecting = false;
        selectedImageIds.Clear();
        StateHasChanged();

        try
        {
            galleryImages = await SceneSvc.ListAsync() ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load gallery images");
            Toast.ShowError(Localize["NativeScene_GalleryLoadFailed"]);
        }
        finally
        {
            isLoadingGallery = false;
        }
    }

    private void CloseGallery()
    {
        showGallery = false;
        isSelecting = false;
        selectedImageIds.Clear();
        newImageUrl = "";
    }

    private void ToggleSelectMode()
    {
        isSelecting = !isSelecting;
        if (!isSelecting)
            selectedImageIds.Clear();
    }

    private async Task OnGalleryItemClick(SceneImage img)
    {
        if (isSelecting)
        {
            if (!selectedImageIds.Add(img.Id))
                selectedImageIds.Remove(img.Id);
        }
        else
        {
            _generation++;
            imageUrl = img.Url ?? "";
            sceneDescription = img.Description ?? "";
            currentSceneId = img.Id;
            gradedSentences.Clear();
            expandedSentenceIndex = -1;
            CloseGallery();
        }
    }

    private async Task AddImage()
    {
        if (string.IsNullOrWhiteSpace(newImageUrl)) return;

        var url = newImageUrl.Trim();
        newImageUrl = "";

        try
        {
            var sceneImage = new SceneImage { Url = url };
            await SceneSvc.SaveAsync(sceneImage);
            galleryImages = await SceneSvc.ListAsync() ?? new();
            Toast.ShowSuccess(Localize["NativeScene_ImageAdded"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add image");
            Toast.ShowError(Localize["NativeScene_ImageSaveFailed"]);
        }
    }

    private async Task DeleteSelectedImages()
    {
        if (!selectedImageIds.Any()) return;

        var toDelete = galleryImages.Where(i => selectedImageIds.Contains(i.Id)).ToList();
        try
        {
            foreach (var img in toDelete)
            {
                await SceneSvc.DeleteAsync(img);
            }

            galleryImages = await SceneSvc.ListAsync() ?? new();
            selectedImageIds.Clear();
            isSelecting = false;

            // If we deleted the current image, clear the scene
            if (toDelete.Any(i => i.Url == imageUrl))
            {
                _generation++;
                imageUrl = "";
                sceneDescription = "";
            }

            Toast.ShowSuccess(Localize.Get("NativeScene_Deleted", toDelete.Count));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete images");
            Toast.ShowError(Localize["NativeScene_DeleteFailed"]);
        }
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private void GoBack()
    {
        _leaving = true;
        _generation++;
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
        NavManager.NavigateTo("/");
    }

    public ValueTask DisposeAsync()
    {
        _leaving = true;
        _generation++;
        Localize.CultureChanged -= OnCultureChanged;
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
        return ValueTask.CompletedTask;
    }
}
