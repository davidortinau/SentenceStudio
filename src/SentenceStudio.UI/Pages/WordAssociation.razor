@page "/word-association"
@attribute [Authorize]
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IDisposable

<div class="activity-page-wrapper">

<PageHeader Title='@Localize["Activity_WordAssociation"]' ShowBack="true" OnBack="GoBack" />

<div class="activity-content">
@if (showSessionSummary)
{
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
        <h2 class="ss-title1 mb-4"><i class="bi bi-trophy me-2"></i>@Localize["WordAssoc_RoundComplete"]</h2>
        <div class="card card-ss p-4" style="min-width: 340px;">
            <div class="d-flex justify-content-around mb-3">
                <div class="text-center">
                    <div class="ss-title2 text-success">@totalRelated</div>
                    <small class="text-secondary-ss">@Localize["WordAssoc_Related"]</small>
                </div>
                <div class="text-center">
                    <div class="ss-title2 text-danger">@(totalClueCount - totalRelated)</div>
                    <small class="text-secondary-ss">@Localize["WordAssoc_NotRelated"]</small>
                </div>
                <div class="text-center">
                    <div class="ss-title2" style="color: var(--bs-primary);">@totalScore</div>
                    <small class="text-secondary-ss">@Localize["WordAssoc_Score"]</small>
                </div>
            </div>
        </div>

        @if (highScoreType == "alltime")
        {
            <div class="alert alert-success mt-3 text-center">
                <i class="bi bi-star-fill me-1"></i> @Localize["WordAssoc_NewAllTimeHigh"]
            </div>
        }
        else if (highScoreType == "weekly")
        {
            <div class="alert alert-info mt-3 text-center">
                <i class="bi bi-calendar-star me-1"></i> @Localize["WordAssoc_BestWeek"]
            </div>
        }

        <button class="btn btn-ss-primary mt-4" @onclick="PlayAgain">@Localize["Common_PlayAgain"]</button>
        <button class="btn btn-ss-secondary mt-2" @onclick="GoBack">@Localize["Common_Done"]</button>
    </div>
}
else if (isBusy)
{
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 40vh;">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="ss-body1 text-secondary-ss">@Localize["WordAssoc_LoadingVocab"]</p>
    </div>
}
else if (words.Any())
{
    <div class="mb-4 px-3">
        <p class="ss-body2 text-secondary-ss mb-1">@string.Format(Localize["WordAssoc_Word"], currentWordIndex + 1, words.Count)</p>
        <p class="ss-display" style="line-height: 1.3;">@currentWord?.TargetLanguageTerm</p>
        @if (!string.IsNullOrEmpty(currentWord?.NativeLanguageTerm))
        {
            <p class="ss-body1 text-secondary-ss mt-1">@currentWord.NativeLanguageTerm</p>
        }
    </div>

    @* Clue list *@
    <div class="px-3">
        @if (currentClues.Count == 0 && !isGrading)
        {
            <p class="ss-body2 text-secondary-ss fst-italic">
                @Localize["WordAssoc_WriteClues"]
                <br /><small class="text-secondary-ss">@Localize["WordAssoc_ClueBonus"]</small>
            </p>
        }

        @foreach (var clue in currentClues)
        {
            <div class="d-flex align-items-start gap-2 mb-2">
                @if (clue.Graded)
                {
                    <span class="badge @(clue.Related ? "bg-success" : "bg-danger") mt-1">
                        @if (clue.Related)
                        {<i class="bi bi-check-circle-fill"></i>}
                        else
                        {<i class="bi bi-x-circle-fill"></i>}
                    </span>
                    <div class="flex-grow-1">
                        <span class="ss-body1">@clue.Text</span>
                        @if (clue.IsCloze && clue.Related)
                        {
                            <span class="badge bg-info ms-1">2x</span>
                        }
                        @if (!string.IsNullOrEmpty(clue.Explanation))
                        {
                            <br /><small class="text-secondary-ss">@clue.Explanation</small>
                        }
                        @if (!string.IsNullOrEmpty(clue.CorrectedText) && clue.CorrectedText != clue.Text)
                        {
                            <br /><small class="text-muted fst-italic">@Localize.Get("WordAssoc_Corrected", clue.CorrectedText)</small>
                        }
                    </div>
                }
                else
                {
                    <span class="badge bg-secondary mt-1"><i class="bi bi-clock"></i></span>
                    <span class="ss-body1 flex-grow-1">@clue.Text</span>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveClue(clue)">
                        <i class="bi bi-x"></i>
                    </button>
                }
            </div>
        }

        @if (isGrading)
        {
            <div class="d-flex align-items-center gap-2 mt-2">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ss-body2 text-secondary-ss">@Localize["WordAssoc_GradingClues"]</span>
            </div>
        }

        @if (currentClues.Any(c => c.Graded))
        {
            var wordScore = currentClues.Where(c => c.Graded).Sum(c => c.Related ? (c.IsCloze ? 2 : 1) : 0);
            var wordMax = currentClues.Where(c => c.Graded).Sum(c => c.IsCloze ? 2 : 1);
            <div class="mt-3 ss-body1-strong">
                @string.Format(Localize["WordAssoc_WordScore"], wordScore, wordMax)
            </div>
        }
    </div>
}
else
{
    <div class="text-center p-5">
        <p class="ss-body1 text-secondary-ss">@Localize["WordAssoc_NoVocab"]</p>
        <button class="btn btn-ss-secondary mt-3" @onclick="GoBack">@Localize["Common_GoBack"]</button>
    </div>
}
</div>

@if (words.Any() && !showSessionSummary && !isBusy)
{
<div class="activity-input-bar">
    <form @onsubmit="AddClue" @onsubmit:preventDefault class="d-flex gap-2 mb-2">
        <input type="text" class="form-control form-control-ss form-control-lg flex-grow-1"
               @bind="userInput"
               @bind:event="oninput"
               disabled="@isGrading"
               placeholder='@Localize["WordAssoc_TypeClue"]' />
        <button type="submit" class="btn btn-ss-primary">
            <i class="bi bi-plus-lg"></i>
        </button>
    </form>

    @if (currentClues.Any(c => !c.Graded))
    {
        <div class="d-flex justify-content-center mb-2">
            <button class="btn btn-ss-primary w-100" @onclick="GradeCurrentWord" disabled="@isGrading">
                <i class="bi bi-check2-all me-1"></i> @Localize["WordAssoc_GradeClues"]
            </button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <button class="btn btn-sm btn-ss-secondary" @onclick="PreviousWord" disabled="@(currentWordIndex <= 0 || isGrading)">
            <i class="bi bi-chevron-left"></i>
        </button>
        <span class="ss-body2 text-secondary-ss">@(currentWordIndex + 1) / @words.Count</span>
        @if (currentWordIndex < words.Count - 1)
        {
            <button class="btn btn-sm btn-ss-secondary" @onclick="NextWord" disabled="@(isGrading || currentClues.Any(c => !c.Graded))">
                @Localize["WordAssoc_Next"]
            </button>
        }
        else
        {
            <button class="btn btn-sm btn-ss-primary" @onclick="FinishRound" disabled="@(isGrading || currentClues.Any(c => !c.Graded))">
                @Localize["WordAssoc_FinishRound"]
            </button>
        }
    </div>
</div>
}

</div>

@code {
    [SupplyParameterFromQuery(Name = "resourceId")]
    public string? ResourceIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "resourceIds")]
    public string? ResourceIdsParam { get; set; }

    [SupplyParameterFromQuery(Name = "skillId")]
    public string? SkillIdParam { get; set; }

    [Inject] private WordAssociationService WordAssocSvc { get; set; } = default!;
    [Inject] private UserActivityRepository ActivityRepo { get; set; } = default!;
    [Inject] private VocabularyProgressService ProgressService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ILogger<WordAssociation> Logger { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IPreferencesService Preferences { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.ProgressCacheService CacheService { get; set; } = default!;

    private bool isBusy;
    private bool isGrading;
    private bool showSessionSummary;
    private string userInput = "";
    private int currentWordIndex;
    private string? highScoreType;

    private List<VocabularyWord> words = new();
    private VocabularyWord? currentWord => currentWordIndex < words.Count ? words[currentWordIndex] : null;

    // Per-word clue storage: wordIndex → list of clues
    private Dictionary<int, List<ClueEntry>> allClues = new();
    private List<ClueEntry> currentClues => allClues.TryGetValue(currentWordIndex, out var list) ? list : new();

    // Round totals (computed after finish)
    private int totalScore;
    private int totalRelated;
    private int totalClueCount;

    // The learner the round was loaded for. Grades, attempts and scores are recorded
    // only for this owner, and only while it is still the active profile (fail closed).
    private string _owner = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Localize.CultureChanged += OnCultureChanged;
        await LoadWords();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadWords()
    {
        isBusy = true;
        try
        {
            _owner = Preferences.Get("active_profile_id", string.Empty);
            if (string.IsNullOrWhiteSpace(_owner))
            {
                Logger.LogWarning("Word Association opened without an active profile; no round is loaded.");
                words = new();
                allClues.Clear();
                Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
                return;
            }

            var resourceIds = ResourceIdsParam ?? ResourceIdParam ?? "";
            words = await WordAssocSvc.GetRoundWordsAsync(_owner, resourceIds, 5);

            if (words.Any())
            {
                currentWordIndex = 0;
                allClues.Clear();
                for (int i = 0; i < words.Count; i++)
                    allClues[i] = new List<ClueEntry>();
            }
            else
            {
                Toast.ShowWarning(Localize["WordAssoc_NoResourceVocab"]);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading vocabulary words");
            Toast.ShowError(Localize["WordAssoc_LoadFailed"]);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void AddClue()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isGrading) return;

        if (!allClues.ContainsKey(currentWordIndex))
            allClues[currentWordIndex] = new List<ClueEntry>();

        allClues[currentWordIndex].Add(new ClueEntry { Text = userInput.Trim() });
        userInput = "";
    }

    private void RemoveClue(ClueEntry clue)
    {
        if (allClues.TryGetValue(currentWordIndex, out var list))
            list.Remove(clue);
    }

    private async Task GradeCurrentWord()
    {
        if (isGrading) return;
        var clues = currentClues.Where(c => !c.Graded).ToList();
        if (clues.Count == 0) return;
        var word = currentWord;
        if (word is null) return;

        var userId = _owner;
        if (!OwnerStillActive())
        {
            Logger.LogWarning("Word Association grading refused: the active profile changed or is absent.");
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        isGrading = true;
        StateHasChanged();

        try
        {
            var nativeLanguage = Preferences.Get("native_language", "English");
            var targetLanguage = Preferences.Get("target_language", "Korean");

            var clueTexts = clues.Select(c => c.Text).ToList();
            WordAssociationGradeResponse result;
            try
            {
                result = await WordAssocSvc.GradeCluesAsync(word, clueTexts, nativeLanguage, targetLanguage);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error grading clues");
                Toast.ShowError(Localize["WordAssoc_GradeFailed"]);
                return;
            }

            // A grade that lands after the profile changed is discarded: nothing is recorded.
            if (!OwnerStillActive())
            {
                Logger.LogWarning("Word Association grade discarded: the active profile changed while grading.");
                return;
            }

            // No verdicts is a failed grade, not a wrong answer: keep the clues pending and
            // record nothing, so the learner can grade again.
            var entries = result?.Entries ?? new List<ClueGrade>();
            if (entries.Count == 0)
            {
                Logger.LogWarning("Word Association grading returned no verdicts.");
                Toast.ShowError(Localize["WordAssoc_GradeFailed"]);
                return;
            }

            // Apply grades
            for (int i = 0; i < clues.Count && i < entries.Count; i++)
            {
                clues[i].Graded = true;
                clues[i].Related = entries[i].Related;
                clues[i].IsCloze = entries[i].IsCloze;
                clues[i].Explanation = entries[i].Explanation;
                clues[i].CorrectedText = entries[i].CorrectedText;
            }

            await RecordGradeAsync(userId, word, clueTexts);
        }
        finally
        {
            isGrading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Records the graded word for its owner: one vocabulary attempt (correct when at
    /// least half the graded clues are related) and a WordAssociation activity row.
    /// </summary>
    private async Task RecordGradeAsync(string userId, VocabularyWord word, List<string> clueTexts)
    {
        var graded = allClues.TryGetValue(words.IndexOf(word), out var list)
            ? list.Where(c => c.Graded).ToList()
            : new List<ClueEntry>();
        var relatedCount = graded.Count(c => c.Related);
        var wasCorrect = graded.Count > 0 && (float)relatedCount / graded.Count >= 0.5f;
        var saveFailed = false;

        try
        {
            var updatedProgress = await ProgressService.RecordAttemptAsync(new VocabularyAttempt
            {
                VocabularyWordId = word.Id,
                UserId = userId,
                Activity = "WordAssociation",
                InputMode = "Text",
                WasCorrect = wasCorrect,
                DifficultyWeight = 1.0f,
                ContextType = "Association"
            });

            // Handle verification probe for Familiar words
            if (updatedProgress.IsFamiliar && OwnerStillActive())
            {
                await ProgressService.HandleVerificationProbeResultAsync(
                    word.Id, userId, wasCorrect);
                if (wasCorrect)
                    Toast.ShowSuccess(Localize["Writing_ProbeConfirmed"]);
                else
                    Toast.ShowInfo(Localize["Writing_ProbeTricky"]);
            }

            CacheService.InvalidateVocabSummary();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Word Association could not record a vocabulary attempt.");
            saveFailed = true;
        }

        if (OwnerStillActive())
        {
            var saved = await ActivityRepo.SaveAsync(new UserActivity
            {
                Activity = "WordAssociation",
                Input = string.Join("; ", clueTexts),
                Accuracy = graded.Count > 0 ? (double)relatedCount / graded.Count * 100 : 0,
                UserProfileId = userId,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            });
            if (saved < 0)
            {
                Logger.LogError("Word Association could not save its UserActivity row.");
                saveFailed = true;
            }
        }

        if (saveFailed)
            Toast.ShowError(Localize["NativeCommon_SaveFailed"]);
    }

    private async Task NextWord()
    {
        if (currentWordIndex < words.Count - 1)
        {
            currentWordIndex++;
            userInput = "";
        }
    }

    private async Task PreviousWord()
    {
        if (currentWordIndex > 0)
        {
            currentWordIndex--;
            userInput = "";
        }
    }

    private async Task FinishRound()
    {
        // Grade any remaining ungraded clues
        if (currentClues.Any(c => !c.Graded))
            await GradeCurrentWord();

        // Calculate totals across all words
        totalScore = 0;
        totalRelated = 0;
        totalClueCount = 0;

        foreach (var (_, clues) in allClues)
        {
            foreach (var c in clues.Where(c => c.Graded))
            {
                totalClueCount++;
                if (c.Related)
                {
                    totalRelated++;
                    totalScore += c.IsCloze ? 2 : 1;
                }
            }
        }

        // Save score and check for high scores
        var userId = _owner;
        var wordIds = words.Select(w => w.Id).ToList();

        if (!OwnerStillActive())
        {
            Logger.LogWarning("Word Association round not saved: the active profile changed or is absent.");
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        // Check high score BEFORE saving (so we compare against previous scores)
        highScoreType = await WordAssocSvc.CheckHighScoreAsync(userId, totalScore);

        if (!await WordAssocSvc.SaveRoundScoreAsync(userId, totalScore, totalClueCount, wordIds))
            Toast.ShowError(Localize["NativeCommon_SaveFailed"]);

        showSessionSummary = true;
    }

    private async Task PlayAgain()
    {
        showSessionSummary = false;
        highScoreType = null;
        totalScore = 0;
        totalRelated = 0;
        totalClueCount = 0;
        userInput = "";
        await LoadWords();
    }

    private bool OwnerStillActive() =>
        !string.IsNullOrWhiteSpace(_owner)
        && string.Equals(_owner, Preferences.Get("active_profile_id", string.Empty), StringComparison.Ordinal);

    private void GoBack() => NavManager.NavigateTo("/");

    void IDisposable.Dispose()
    {
        Localize.CultureChanged -= OnCultureChanged;
    }

    private class ClueEntry
    {
        public string Text { get; set; } = "";
        public bool Graded { get; set; }
        public bool Related { get; set; }
        public bool IsCloze { get; set; }
        public string? Explanation { get; set; }
        public string? CorrectedText { get; set; }
    }
}
