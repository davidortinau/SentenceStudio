@page "/how-do-you-say"
@attribute [Authorize]
@using SentenceStudio.Abstractions
@using SentenceStudio.Services.Speech
@using Microsoft.JSInterop
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IAsyncDisposable

<PageHeader Title='@Localize["Activity_HowDoYouSay"]' ShowBack="true" OnBack="GoBack" />

@* Input area *@
<div class="card card-ss p-3 mb-4">
    <div class="mb-3">
        <label class="form-label text-secondary-ss">@string.Format(Localize["HowDoYouSay_EnterPhrase"], targetLanguage)</label>
        <input type="text" class="form-control form-control-ss form-control-lg"
               @bind="phrase" @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               placeholder='@Localize["HowDoYouSay_TypePhrase"]' />
    </div>

    @if (availableVoices.Any())
    {
        <div class="mb-3">
            <label class="form-label text-secondary-ss">@Localize["HowDoYouSay_Voice"]</label>
            <select class="form-select form-control-ss" @onchange="OnVoiceChanged">
                @foreach (var voice in availableVoices)
                {
                    <option value="@voice.VoiceId" selected="@(voice.VoiceId == selectedVoiceId)">
                        @voice.Name @(voice.Gender != null ? $"({voice.Gender})" : "")
                    </option>
                }
            </select>
        </div>
    }

    <button class="btn btn-ss-primary w-100" @onclick="SubmitPhrase"
            disabled="@(isBusy || string.IsNullOrWhiteSpace(phrase))">
        @if (isBusy)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
            <span>@Localize["HowDoYouSay_Generating"]</span>
        }
        else
        {
            <span><i class="bi bi-volume-up me-1"></i> @Localize["HowDoYouSay_Speak"]</span>
        }
    </button>
</div>

@* History *@
@if (isLoadingHistory)
{
    <div class="d-flex justify-content-center p-3">
        <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
    </div>
}
else if (history.Any())
{
    <h3 class="ss-title3 mb-3">@Localize["HowDoYouSay_History"]</h3>
    <div class="d-flex flex-column gap-2">
        @foreach (var item in history)
        {
            var h = item;
            var isPlaying = currentPlayingItem?.Id == h.Id && isAudioPlaying;
            var isRestoring = restoringItemId == h.Id;

            <div class="card card-ss p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="flex-grow-1">
                        <p class="ss-body1 fw-bold mb-0">@h.Phrase</p>
                        <small class="text-secondary-ss">@FormatCreatedAt(h.CreatedAt)</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm @(isPlaying ? "btn-ss-primary" : "btn-ss-secondary")"
                                aria-label='@(isPlaying ? Localize["NativeShadowing_Pause"] : Localize["NativeShadowing_Play"])'
                                aria-busy="@(isRestoring ? "true" : "false")"
                                @onclick="() => PlayHistoryItem(h)">
                            @if (isRestoring) { <span class="spinner-border spinner-border-sm"></span> }
                            else if (isPlaying) { <i class="bi bi-pause-fill"></i> } else { <i class="bi bi-play-fill"></i> }
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                                aria-label='@Localize["Common_Delete"]'
                                @onclick="() => DeleteHistoryItem(h)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Inject] private ElevenLabsSpeechService SpeechService { get; set; } = default!;
    [Inject] private StreamHistoryRepository HistoryRepo { get; set; } = default!;
    [Inject] private UserProfileRepository ProfileRepo { get; set; } = default!;
    [Inject] private SentenceStudio.Services.SpeechVoicePreferences VoicePrefs { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Speech.IVoiceDiscoveryService VoiceDiscovery { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IFileSystemService FileSystemService { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IConnectivityService Connectivity { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Plans.IPlanDateContext LearnerClock { get; set; } = default!;
    [Inject] private IAudioPlayerFactory AudioPlayerFactory { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ILogger<HowDoYouSay> Logger { get; set; } = default!;

    private string phrase = "";
    private string targetLanguage = "Korean";
    private string selectedVoiceId = "";
    private bool isBusy;
    private bool isLoadingHistory = true;
    private bool isAudioPlaying;
    private bool _useJsAudio;
    private bool _browserAudioAttempted;
    private bool _disposed;
    private readonly CancellationTokenSource _audioLifetime = new();
    private CancellationTokenSource? _audioRequestCts;
    private int _audioGeneration;

    private List<VoiceInfo> availableVoices = new();
    private List<StreamHistory> history = new();
    private StreamHistory? currentPlayingItem;
    private string? restoringItemId;
    private readonly UiAudioPlayerSession _nativeAudio = new();
    private UiSpeechClipCache? _clipCache;

    // The page's existing voice settings (stability, similarity, speed).
    private const float Stability = 0.5f;
    private const float SimilarityBoost = 0.75f;
    private const float SpeechSpeed = 0.85f;
    private const string ClipFilePrefix = "phrase";

    private UiSpeechClipCache ClipCache =>
        _clipCache ??= new UiSpeechClipCache(HistoryRepo, FileSystemService, Logger);

    private Func<string, CancellationToken, Task<Stream>> SynthesizerFor(string text) =>
        (voice, token) => SpeechService.TextToSpeechAsync(text, voice, Stability, SimilarityBoost, SpeechSpeed,
            cancellationToken: token);

    /// <summary>History times are stored in UTC; show them in the learner's time zone.</summary>
    private string FormatCreatedAt(DateTime createdAtUtc) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(createdAtUtc, DateTimeKind.Utc), LearnerClock.TimeZone)
            .ToString("g", Localize.Culture);

    protected override async Task OnInitializedAsync()
    {
        Localize.CultureChanged += OnCultureChanged;
        _useJsAudio = !AudioPlayerFactory.CanPlayLocally;
        var profile = await ProfileRepo.GetAsync();
        targetLanguage = profile?.TargetLanguage ?? "Korean";

        await Task.WhenAll(
            LoadVoices(),
            LoadHistory()
        );
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadVoices()
    {
        try
        {
            var voices = await VoiceDiscovery.GetVoicesForLanguageAsync(targetLanguage);
            availableVoices = voices?.ToList() ?? new();
            selectedVoiceId = VoicePrefs.GetVoiceForLanguage(targetLanguage);
            if (string.IsNullOrEmpty(selectedVoiceId) && availableVoices.Any())
                selectedVoiceId = availableVoices.First().VoiceId;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load voices");
        }
    }

    private async Task LoadHistory()
    {
        isLoadingHistory = true;
        try
        {
            var items = await HistoryRepo.GetAllStreamHistoryAsync();
            history = items?.OrderByDescending(h => h.CreatedAt).ToList() ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load history");
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private async Task SubmitPhrase()
    {
        if (_disposed || string.IsNullOrWhiteSpace(phrase) || isBusy) return;

        isBusy = true;
        CancellationToken playbackToken = default;
        var playbackStarted = false;
        try
        {
            var voiceId = selectedVoiceId;
            if (string.IsNullOrEmpty(voiceId))
            {
                Toast.ShowWarning(Localize["NativeHowDoYouSay_SelectVoice"]);
                return;
            }

            var text = phrase.Trim();
            playbackToken = await BeginAudioRequestAsync();
            // The owner's cached clip of this phrase in this voice plays without a
            // new synthesis or a second history entry.
            var clip = await ClipCache.GetOrCreateAsync(text, voiceId, Connectivity.IsInternetAvailable,
                ClipFilePrefix, SynthesizerFor(text), playbackToken);
            if (_disposed || playbackToken.IsCancellationRequested) return;
            switch (clip.Status)
            {
                case UiSpeechClipStatus.Offline:
                    Toast.ShowWarning(Localize["OfflineAudioUnavailable"]);
                    return;
                case UiSpeechClipStatus.Failed:
                    Toast.ShowError(Localize["NativeHowDoYouSay_GenerateFailed"]);
                    return;
            }

            // Play it
            playbackStarted = true;
            if (_useJsAudio)
            {
                _browserAudioAttempted = true;
                await BrowserAudioPlayback.PlayAsync(JS, clip.Audio!, playbackToken);
            }
            else
            {
                _nativeAudio.CreatePlayer(AudioPlayerFactory, new MemoryStream(clip.Audio!)).Play();
            }
            if (_disposed || playbackToken.IsCancellationRequested) return;
            currentPlayingItem = clip.Entry;
            isAudioPlaying = true;

            // A new entry goes to the top of the history; a reused or re-pointed
            // entry keeps its place.
            if (clip.Entry is { } stored)
            {
                var index = history.FindIndex(h => h.Id == stored.Id);
                if (index >= 0)
                    history[index] = stored;
                else
                    history.Insert(0, stored);
            }

            phrase = "";
            Toast.ShowSuccess(Localize["NativeHowDoYouSay_Generated"]);
        }
        catch (OperationCanceledException) when (_disposed || playbackToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (!_disposed && !playbackToken.IsCancellationRequested)
            {
                _nativeAudio.Stop();
                Logger.LogError(ex, "Failed to generate speech");
                Toast.ShowError(Localize[playbackStarted
                    ? "NativeHowDoYouSay_PlaybackError" : "NativeHowDoYouSay_GenerateFailed"]);
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task PlayHistoryItem(StreamHistory item)
    {
        if (_disposed) return;

        CancellationToken playbackToken = default;
        try
        {
            var ownedItem = await HistoryRepo.GetStreamHistoryAsync(item.Id);
            if (ownedItem is null)
            {
                await LoadHistory();
                if (currentPlayingItem?.Id == item.Id)
                    await StopAudioAsync();
                Toast.ShowWarning(Localize["HowDoYouSay_AudioUnavailable"]);
                return;
            }

            if (currentPlayingItem?.Id == item.Id && isAudioPlaying)
            {
                await StopAudioAsync();
                return;
            }

            playbackToken = await BeginAudioRequestAsync();
            if (_disposed || playbackToken.IsCancellationRequested) return;
            ownedItem = await HistoryRepo.GetStreamHistoryAsync(item.Id);
            if (ownedItem is null)
            {
                await LoadHistory();
                Toast.ShowWarning(Localize["HowDoYouSay_AudioUnavailable"]);
                return;
            }

            // A synced entry whose clip was made on another device (or before a
            // reinstall) is synthesized again in the entry's own voice, and the
            // same entry points at the new clip (no second entry).
            if (UiSpeechClipCache.Resolve(FileSystemService.AppDataDirectory, ownedItem.AudioFilePath) is null)
            {
                restoringItemId = ownedItem.Id;
                StateHasChanged();
            }
            UiSpeechClip clip;
            try
            {
                clip = await ClipCache.GetForEntryAsync(ownedItem,
                    !string.IsNullOrEmpty(selectedVoiceId)
                        ? selectedVoiceId : VoicePrefs.GetVoiceForLanguage(targetLanguage),
                    Connectivity.IsInternetAvailable, ClipFilePrefix,
                    SynthesizerFor(ownedItem.Phrase ?? string.Empty), playbackToken);
            }
            finally
            {
                if (restoringItemId == ownedItem.Id)
                    restoringItemId = null;
            }
            if (_disposed || playbackToken.IsCancellationRequested) return;
            switch (clip.Status)
            {
                case UiSpeechClipStatus.Offline:
                    Toast.ShowWarning(Localize["OfflineAudioUnavailable"]);
                    return;
                case UiSpeechClipStatus.Failed:
                    Toast.ShowWarning(Localize["NativeHowDoYouSay_FileNotFound"]);
                    return;
            }

            if (_useJsAudio)
            {
                _browserAudioAttempted = true;
                await BrowserAudioPlayback.PlayAsync(JS, clip.Audio!, playbackToken);
            }
            else
            {
                _nativeAudio.CreatePlayer(AudioPlayerFactory, new MemoryStream(clip.Audio!)).Play();
            }
            if (_disposed || playbackToken.IsCancellationRequested) return;
            var playing = clip.Entry ?? ownedItem;
            var index = history.FindIndex(h => h.Id == playing.Id);
            if (index >= 0)
                history[index] = playing;
            currentPlayingItem = playing;
            isAudioPlaying = true;
        }
        catch (OperationCanceledException) when (_disposed || playbackToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (!_disposed && !playbackToken.IsCancellationRequested)
            {
                _nativeAudio.Stop();
                Logger.LogError(ex, "Failed to play audio");
                Toast.ShowError(Localize["NativeHowDoYouSay_PlaybackError"]);
            }
        }
    }

    private async Task DeleteHistoryItem(StreamHistory item)
    {
        try
        {
            if (currentPlayingItem?.Id == item.Id)
            {
                try
                {
                    await StopAudioAsync();
                }
                catch (JSDisconnectedException ex)
                {
                    Logger.LogWarning(ex,
                        "How Do You Say browser audio stop was not confirmed: JS circuit disconnected; continuing deletion");
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex,
                        "How Do You Say audio stop was not confirmed; continuing deletion");
                }
            }

            var ownedItem = await HistoryRepo.GetStreamHistoryAsync(item.Id);
            if (ownedItem is null)
            {
                await LoadHistory();
                throw new InvalidOperationException("History item is unavailable for the active user.");
            }

            var deletedRows = await HistoryRepo.DeleteStreamHistoryAsync(ownedItem);
            if (deletedRows <= 0)
                throw new InvalidOperationException($"History item {item.Id} was not deleted from storage.");

            history.RemoveAll(h => h.Id == ownedItem.Id);

            // Audio files are retained: another profile or cached entry may
            // reference the same path, and row ownership cannot establish
            // exclusive file ownership.
            Toast.ShowSuccess(Localize["Deleted"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete history item");
            Toast.ShowError(Localize["NativeHowDoYouSay_DeleteFailed"]);
        }
    }

    private void OnVoiceChanged(ChangeEventArgs e)
    {
        selectedVoiceId = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(selectedVoiceId))
            VoicePrefs.SetVoiceForLanguage(targetLanguage, selectedVoiceId);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitPhrase();
    }

    private async Task<CancellationToken> BeginAudioRequestAsync()
    {
        var generation = _audioGeneration + 1;
        await StopAudioAsync();
        if (_disposed || _audioGeneration != generation)
            throw new OperationCanceledException();

        _audioRequestCts = CancellationTokenSource.CreateLinkedTokenSource(_audioLifetime.Token);
        return _audioRequestCts.Token;
    }

    private async Task StopAudioAsync()
    {
        _audioGeneration++;
        var request = _audioRequestCts;
        _audioRequestCts = null;
        request?.Cancel();
        request?.Dispose();
        try
        {
            _nativeAudio.Stop();
            if (_browserAudioAttempted)
            {
                _browserAudioAttempted = false;
                await JS.InvokeVoidAsync("audioInterop.stop");
            }
        }
        finally
        {
            currentPlayingItem = null;
            isAudioPlaying = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _audioLifetime.Cancel();
        Localize.CultureChanged -= OnCultureChanged;
        try
        {
            await StopAudioAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "How Do You Say audio stop was not confirmed during disposal");
        }
        finally
        {
            _audioLifetime.Dispose();
        }
    }

    private void GoBack() => NavManager.NavigateTo("/");
}
