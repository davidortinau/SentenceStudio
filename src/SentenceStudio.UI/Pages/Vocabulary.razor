    /// <summary>
    /// Merge for one group: folds the other copies into its keeper (the first copy by merge
    /// preference that no one else uses). A review group merges the same way (the learner chose
    /// to). Copies someone else uses stay, but the learner's history and links on them move to
    /// the keeper; a group with no keeper only says why. A refused merge says why (2026-11-14:
    /// 먹다 said "No merge was needed" when refused).
    /// </summary>
    private async Task MergeDuplicateGroup(VocabularyDuplicateGroup group)
    {
        if (group.EffectiveRisk == VocabularyDuplicateRisk.Blocked && group.KeeperId is null)
        {
            Toast.ShowInfo(Localize[group.MergeBlockedReason ?? "Vocabulary_DuplicatesAllShared"]);
            return;
        }

        var chosen = ChosenDuplicateCopies(group).Select(w => w.Word.Id).ToList();
        var keeperId = DuplicateKeeperOf(group);
        if (chosen.Count < 2 || string.IsNullOrEmpty(keeperId))
        {
            Toast.ShowInfo(Localize[chosen.Count < 2 ? "Vocabulary_DuplicatesChooseTwo"
                : group.MergeBlockedReason ?? "Vocabulary_DuplicatesAllShared"]);
            return;
        }

        isCleanupRunning = true;
        cleanupStatus = $"Merging group: {group.NormalizedTerm}...";
        StateHasChanged();

        try
        {
            var deleteIds = chosen.Where(id => id != keeperId).ToList();
            var result = await ResourceRepo.MergeVocabularyWordsWithResultAsync(keeperId, deleteIds, default, ActiveUserId);
            if (!result.Changed)
            {
                var refused = MergeRefusal(group.DisplayTerm, result.RefusalKey);
                cleanupResults.Add(refused);
                Toast.ShowWarning(refused);
            }
            else
            {
                // What is left of the group starts with every copy chosen.
                excludedDuplicateWordIds.ExceptWith(group.Words.Select(w => w.Word.Id));
                cleanupResults.Add($"Merged '{group.DisplayTerm}': kept 1, removed {result.Deleted}");
                CacheService.InvalidateVocabSummary();
                await LoadData();
                Toast.ShowSuccess($"Merged {result.Deleted} duplicate record(s) for '{group.DisplayTerm}'.");
            }
            await LoadDuplicateGroupsAsync(append: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error merging duplicate group {Term}", group.NormalizedTerm);
            cleanupResults.Add($"Error merging '{group.DisplayTerm}': {ex.Message}");
        }
        finally
        {
            isCleanupRunning = false;
            StateHasChanged();
        }
    }

    private bool IsDuplicateCopyIncluded(string wordId) => !excludedDuplicateWordIds.Contains(wordId);

    private void ToggleDuplicateCopy(string wordId)
    {
        if (!excludedDuplicateWordIds.Remove(wordId))
            excludedDuplicateWordIds.Add(wordId);
    }

    /// <summary>The copies Merge all must not take: skipped groups and left-out copies (shared rule).</summary>
    private IReadOnlySet<string> DuplicateLeftOut => VocabularyDuplicatePolicy.LeftOut(duplicateGroups,
        group => group.Words, group => skippedDuplicateTerms.Contains(group.NormalizedTerm),
        info => IsDuplicateCopyIncluded(info.Word.Id), info => info.Word.Id);

    /// <summary>The copies Merge all will remove: the scan's count less the ones left out here.</summary>
    private int DuplicateMergeAllCopyCount => Math.Max(0, duplicateSafeCopyCount
        - VocabularyDuplicatePolicy.CopiesLeftOut(duplicateGroups.SelectMany(group => group.MergeParts),
            DuplicateLeftOut));

    /// <summary>The copies the group's Merge takes (shared rule: the chosen ones in a group of three or more).</summary>
    private IReadOnlyList<VocabularyDuplicateWordInfo> ChosenDuplicateCopies(VocabularyDuplicateGroup group) =>
        VocabularyDuplicatePolicy.ChosenCopies(group.Words, info => IsDuplicateCopyIncluded(info.Word.Id));

    /// <summary>The copy Merge keeps (shared rule); empty when none can be kept.</summary>
    private string DuplicateKeeperOf(VocabularyDuplicateGroup group) =>
        VocabularyDuplicatePolicy.KeeperOf(group.Words, info => IsDuplicateCopyIncluded(info.Word.Id),
            info => info.UsedByOthers, info => info.Word.Id == group.RecommendedKeeperId)?.Word.Id
            ?? string.Empty;

    /// <summary>
    /// Edit on a copy (Captain 2026-11-14: "go directly to a vocabulary word so that I can modify
    /// the entry"): the word editor opens and returns to this panel (BuildEditUrl).
    /// </summary>
    private void EditDuplicateCopy(string wordId) => NavManager.NavigateTo(BuildEditUrl(wordId));

    /// <summary>Skip: the review group leaves the panel until it is opened again; nothing changes.</summary>
    private void SkipDuplicateGroup(VocabularyDuplicateGroup group) =>
        skippedDuplicateTerms.Add(group.NormalizedTerm);

    /// <summary>
    /// Merge all (Captain 2026-11-14: "I almost always do all of them at once with no review"):
    /// every safe group on every page in one step. A panel focused on one word merges only its
    /// own safe group.
    /// </summary>
    private async Task MergeAllSafeDuplicates()
    {
        if (isCleanupRunning || DuplicateMergeAllCopyCount == 0)
            return;
        isCleanupRunning = true;
        cleanupTotal = 0;
        cleanupProgress = 0;
        cleanupStatus = Localize["Vocabulary_DuplicatesMerging"];
        cleanupResults.Clear();
        StateHasChanged();

        try
        {
            // A panel focused on one word merges only that word's group.
            // Never the copies left out or skipped here.
            var merged = await ResourceRepo.MergeSafeDuplicateGroupsAsync(default, ActiveUserId,
                duplicateFocusLabel, DuplicateLeftOut);
            var message = merged.Refused.Count > 0
                ? string.Format(Localize["Vocabulary_DuplicatesMergedAllWithRefusals"],
                    merged.MergedGroups, merged.RemovedCopies, merged.Refused.Count)
                : merged.MergedGroups > 0
                    ? string.Format(Localize["Vocabulary_DuplicatesMergedAll"], merged.MergedGroups, merged.RemovedCopies)
                    : Localize["Vocabulary_DuplicatesNothingSafe"];
            cleanupResults.Add(message);
            foreach (var (term, key) in merged.Refused)
                cleanupResults.Add(MergeRefusal(term, key));
            if (merged.MergedGroups > 0)
            {
                CacheService.InvalidateVocabSummary();
                await LoadData();
            }
            await LoadDuplicateGroupsAsync(append: false);
            if (merged.Refused.Count > 0)
                Toast.ShowWarning(message);
            else
                Toast.ShowSuccess(message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error merging all safe duplicate groups");
            cleanupResults.Add(string.Format(Localize["Vocabulary_CleanupError"], ex.Message));
            await ReloadAfterFailedMergeAsync();
        }
        finally
        {
            isCleanupRunning = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// After a merge failed partway: the words and the duplicate counts are read again, so the
    /// panel does not offer groups that already merged. A failure here is logged and shown.
    /// </summary>
    private async Task ReloadAfterFailedMergeAsync()
    {
        try
        {
            CacheService.InvalidateVocabSummary();
            await LoadData();
            await LoadDuplicateGroupsAsync(append: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reloading vocabulary after a failed duplicate merge");
            cleanupResults.Add(string.Format(Localize["Vocabulary_CleanupError"], ex.Message));
        }
    }

    private string MergeRefusal(string term, string? key) =>
        string.Format(Localize["Vocabulary_DuplicatesMergeRefused"], term,
            Localize[key ?? "Vocabulary_MergeRefusedNothingToMove"]);

    /// <summary>The review groups to show (loaded, not skipped).</summary>
    private List<VocabularyDuplicateGroup> ReviewDuplicateGroups => duplicateGroups
        .Where(g => g.EffectiveRisk == VocabularyDuplicateRisk.Review && !skippedDuplicateTerms.Contains(g.NormalizedTerm))
        .ToList();

    private List<VocabularyDuplicateGroup> BlockedDuplicateGroups => duplicateGroups
        .Where(g => g.EffectiveRisk == VocabularyDuplicateRisk.Blocked)
        .ToList();

    /// <summary>
    /// Review and blocked groups not loaded yet: they come before the safe ones, which are never
    /// listed, so Show more stops once they are all in.
    /// </summary>
    private int RemainingDuplicateGroupCount => Math.Max(0, duplicateReviewGroupCount + duplicateBlockedGroupCount
        - duplicateGroups.Count(g => g.EffectiveRisk != VocabularyDuplicateRisk.Safe));

    /// <summary>The word editor's names for the lexical types.</summary>
    private static string LexicalTypeKey(LexicalUnitType type) => type switch
    {
        LexicalUnitType.Phrase => "Vocabulary_FilterTypePhrase",
        LexicalUnitType.Sentence => "Vocabulary_FilterTypeSentence",
        LexicalUnitType.Unknown => "VocabWordEdit_Unknown",
        LexicalUnitType.Idiom => "NativeResources_LexicalIdiom",
        _ => "Vocabulary_FilterTypeWord"
    };

    /// <summary>What merging a review group would drop.</summary>
    private string DuplicateDifferences(VocabularyDuplicateGroup group) => string.Join(", ",
        (group.Differences ?? []).Select(difference => Localize[$"Vocabulary_DuplicateDifference{difference}"]));

    /// <summary>
    /// What a copy shows under its meaning: its language and kind, its base form when the copies'
    /// differ, then its memory aids, so the learner sees what a merge keeps.
    /// </summary>
    private string DuplicateCopyDetails(VocabularyDuplicateGroup group, VocabularyDuplicateWordInfo wordInfo)
    {
        var word = wordInfo.Word;
        var differences = group.Differences ?? [];
        var lines = new List<string>();
        if (differences.Contains(VocabularyDuplicateDifference.BaseForm))
            lines.Add($"{Localize["VocabWordEdit_Lemma"]}: {(string.IsNullOrWhiteSpace(word.Lemma) ? Localize["VocabWordEdit_NotSet"] : word.Lemma.Trim())}");
        // Every copy's language and kind (Captain 2026-11-14: "I need to see language too").
        lines.Insert(0, $"{(string.IsNullOrWhiteSpace(word.Language) ? Localize["VocabWordEdit_NotSet"] : word.Language)} | {Localize[LexicalTypeKey(word.LexicalUnitType)]}");
        lines.Add(GetMemoryAidSummary(wordInfo));
        return string.Join("\n", lines);
    }

    // ===== POPULATE LEMMAS =====

    private class LemmaResponse
    {
        public List<LemmaItem> Lemmas { get; set; } = new();
    }

    private class LemmaItem
    {
        public int Id { get; set; }
        public string Lemma { get; set; } = "";
    }

    private async Task PopulateLemmas()
    {
        showCleanupPanel = true;
        showDuplicatePanel = false;
        isCleanupRunning = true;
        cleanupTitle = "Populate Lemmas";
        cleanupResults.Clear();
        StateHasChanged();

        try
        {
            var wordsNeedingLemma = allWords
                .Where(w => string.IsNullOrWhiteSpace(w.Word.Lemma))
                .Select(w => w.Word)
                .ToList();

            cleanupTotal = wordsNeedingLemma.Count;
            cleanupProgress = 0;
            cleanupStatus = $"Processing {cleanupTotal} words missing lemmas...";
            StateHasChanged();

            if (cleanupTotal == 0)
            {
                cleanupResults.Add("All words already have lemmas.");
                isCleanupRunning = false;
                StateHasChanged();
                return;
            }

            int updated = 0;
            int batchSize = 50;
            var batches = wordsNeedingLemma
                .Select((word, index) => new { word, index })
                .GroupBy(x => x.index / batchSize)
                .Select(g => g.Select(x => x.word).ToList())
                .ToList();

            foreach (var batch in batches)
            {
                cleanupStatus = $"Processing batch {cleanupProgress / batchSize + 1} of {batches.Count}...";
                StateHasChanged();

                try
                {
                    var wordList = string.Join("\n", batch.Select((w, i) =>
                        $"{i + 1}. {w.TargetLanguageTerm} ({w.NativeLanguageTerm})"));

                    var prompt = $@"For each word below, return its dictionary form (lemma). If the word is already in dictionary form, return it unchanged. Return ONLY a JSON object with a ""lemmas"" array where each item has ""id"" (the number) and ""lemma"" (the dictionary form in the target language).

Words:
{wordList}

Return JSON like: {{""lemmas"": [{{""id"": 1, ""lemma"": ""dictionary form""}}, ...]}}";

                    var response = await AiSvc.SendPrompt<LemmaResponse>(prompt);

                    if (response?.Lemmas != null)
                    {
                        var lemmaUpdates = new Dictionary<string, string>();
                        foreach (var item in response.Lemmas)
                        {
                            var idx = item.Id - 1; // 0-based index
                            if (idx >= 0 && idx < batch.Count && !string.IsNullOrWhiteSpace(item.Lemma))
                            {
                                lemmaUpdates[batch[idx].Id] = item.Lemma;
                            }
                        }

                        if (lemmaUpdates.Any())
                        {
                            int batchUpdated = await ResourceRepo.BulkUpdateLemmasAsync(lemmaUpdates, ActiveUserId);
                            updated += batchUpdated;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error processing lemma batch");
                    cleanupResults.Add($"Batch error: {ex.Message}");
                }

                cleanupProgress += batch.Count;
                StateHasChanged();

                await Task.Delay(500);
            }

            cleanupResults.Add($"Lemma population complete: updated {updated} of {cleanupTotal} words");

            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error populating lemmas");
            cleanupResults.Add($"Error: {ex.Message}");
        }
        finally
        {
            isCleanupRunning = false;
            StateHasChanged();
        }
    }

    // ===== FIX SWAPPED LANGUAGES =====
    private static bool IsEnglish(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        return text.All(c => c <= 127 || char.IsWhiteSpace(c));
    }

    private static bool IsKorean(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        return text.Any(c =>
            (c >= 0xAC00 && c <= 0xD7AF) ||  // Hangul Syllables
            (c >= 0x1100 && c <= 0x11FF) ||   // Hangul Jamo
            (c >= 0x3130 && c <= 0x318F));    // Hangul Compatibility Jamo
    }

    private async Task FixSwappedLanguages()
    {
        showCleanupPanel = true;
        showDuplicatePanel = false;
        isCleanupRunning = true;
        cleanupTitle = Localize["Vocabulary_FixSwappedTitle"];
        cleanupResults.Clear();
        cleanupStatus = Localize["Vocabulary_FixSwappedScanning"];
        StateHasChanged();

        try
        {
            int swappedCount = 0;
            int mergedCount = 0;

            var wordsToSwap = new List<(string Id, string NewTarget, string NewNative)>();
            var wordsToMerge = new List<(string FromId, string ToId)>();

            foreach (var item in allWords)
            {
                var word = item.Word;
                if (string.IsNullOrWhiteSpace(word.TargetLanguageTerm) ||
                    string.IsNullOrWhiteSpace(word.NativeLanguageTerm))
                    continue;

                bool targetIsEnglish = IsEnglish(word.TargetLanguageTerm);
                bool nativeIsKorean = IsKorean(word.NativeLanguageTerm);

                if (targetIsEnglish && nativeIsKorean)
                {
                    var swappedTarget = word.NativeLanguageTerm;
                    var swappedNative = word.TargetLanguageTerm;

                    var existingWord = await ResourceRepo.FindDuplicateVocabularyWordAsync(swappedTarget, swappedNative);

                    if (existingWord != null && existingWord.Id != word.Id)
                    {
                        wordsToMerge.Add((word.Id, existingWord.Id));
                    }
                    else
                    {
                        wordsToSwap.Add((word.Id, swappedTarget, swappedNative));
                    }
                }
            }

            cleanupTotal = wordsToSwap.Count + wordsToMerge.Count;
            cleanupProgress = 0;
            cleanupStatus = string.Format(Localize["Vocabulary_FixSwappedFixing"], cleanupTotal);
            StateHasChanged();

            // B66/B69: only words recorded to the learner change. A swapped copy folds into the
            // existing word through the owner-checked merge, which runs its checks and writes in
            // one transaction, keeps the copy's progress, history and memory aids on the keeper,
            // moves only the learner's links, and changes nothing when either word is not the
            // learner's. A term swap updates only a word recorded to the learner.
            var userId = ActiveUserId;
            var keptCount = 0;
            var failedCount = 0;
            foreach (var (fromId, toId) in wordsToMerge)
            {
                var merged = await ResourceRepo.MergeVocabularyWordsWithResultAsync(
                    toId, new List<string> { fromId }, default, userId);
                if (merged.Changed)
                    mergedCount++;
                else
                    keptCount++;
                cleanupProgress++;
                StateHasChanged();
            }

            foreach (var (id, newTarget, newNative) in wordsToSwap)
            {
                // An expected refusal (no longer the learner's) is kept; a technical failure is
                // reported as an error, never as a refusal (review finding 4).
                switch (await ResourceRepo.UpdateVocabularyWordTermsAsync(id, newTarget, newNative, userId))
                {
                    case VocabularyWordTermsUpdateResult.Updated:
                        swappedCount++;
                        break;
                    case VocabularyWordTermsUpdateResult.NotLearnersOwn:
                        keptCount++;
                        break;
                    default:
                        failedCount++;
                        break;
                }
                cleanupProgress++;
                StateHasChanged();
            }

            cleanupResults.Add(string.Format(Localize["Vocabulary_FixSwappedComplete"], swappedCount, mergedCount));
            if (keptCount > 0)
                cleanupResults.Add(string.Format(Localize["Vocabulary_FixSwappedKept"], keptCount));
            if (failedCount > 0)
            {
                cleanupResults.Add(string.Format(Localize["Vocabulary_FixSwappedFailed"], failedCount));
                Toast.ShowError(string.Format(Localize["Vocabulary_FixSwappedFailed"], failedCount));
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fixing swapped languages");
            cleanupResults.Add(string.Format(Localize["Vocabulary_FixSwappedError"], ex.Message));
        }
        finally
        {
            isCleanupRunning = false;
            StateHasChanged();
        }
    }

    // ===== ASSIGN ORPHANED WORDS =====
    private async Task AssignOrphanedWords()
    {
        showCleanupPanel = true;
        showDuplicatePanel = false;
        isCleanupRunning = true;
        cleanupTitle = "Assign Orphaned Words";
        cleanupResults.Clear();
        cleanupStatus = "Finding orphaned words...";
        StateHasChanged();

        try
        {
            var orphanedWords = await ResourceRepo.GetOrphanedVocabularyWordsAsync();

            if (!orphanedWords.Any())
            {
                cleanupResults.Add("No orphaned words found.");
                isCleanupRunning = false;
                StateHasChanged();
                return;
            }

            cleanupStatus = $"Assigning {orphanedWords.Count} orphaned words...";
            StateHasChanged();

            var allResources = availableResources;
            var generalResource = allResources.FirstOrDefault(r =>
                r.Title == "General Vocabulary" && r.MediaType == "Vocabulary List");

            if (generalResource == null)
            {
                generalResource = new LearningResource
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = "General Vocabulary",
                    Description = "Catch-all vocabulary list for words without a specific learning resource",
                    MediaType = "Vocabulary List",
                    Language = "Korean",
                    Tags = "general,unassigned",
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
                await ResourceRepo.SaveResourceAsync(generalResource);
            }

            var orphanIds = orphanedWords.Select(w => w.Id).ToList();
            await ResourceRepo.BulkAssociateWordsWithResourceAsync(generalResource.Id, orphanIds);

            cleanupResults.Add($"Assigned {orphanIds.Count} orphaned word(s) to 'General Vocabulary'");

            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error assigning orphaned words");
            cleanupResults.Add($"Error: {ex.Message}");
        }
        finally
        {
            isCleanupRunning = false;
            StateHasChanged();
        }
    }

    private class VocabularyCardItem
    {
        public VocabularyWord Word { get; set; } = null!;
        public List<LearningResource> AssociatedResources { get; set; } = new();
        public SentenceStudio.Shared.Models.VocabularyProgress? Progress { get; set; }
        public double EncodingScore { get; set; }
        public string EncodingLabel { get; set; } = "Basic";

        public bool IsKnown => Progress?.IsKnown ?? false;
        public bool IsLearning => Progress?.IsLearning ?? false;
        public bool IsOrphaned => !AssociatedResources.Any();

        public string StatusText => Progress?.Status switch
        {
            LearningStatus.Known => "Known",
            LearningStatus.Familiar => "Familiar",
            LearningStatus.Learning => "Learning",
            _ => "Unknown"
        };
    }

    private string BuildEditUrl(string id, string? initialTargetTerm = null)
    {
        var queryParts = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchQuery))
            queryParts.Add($"returnQuery={Uri.EscapeDataString(searchQuery)}");

        if (!string.IsNullOrWhiteSpace(duplicateFocusLabel))
            queryParts.Add($"returnDuplicateTerm={Uri.EscapeDataString(duplicateFocusLabel)}");

        if (!string.IsNullOrWhiteSpace(focusedDuplicateWordId))
            queryParts.Add($"returnFocusWordId={Uri.EscapeDataString(focusedDuplicateWordId)}");

        // The duplicate panel over all words comes back too (Edit on one of its copies), with the
        // groups skipped and the copies left out, so Merge all still leaves them alone.
        if (showDuplicatePanel && string.IsNullOrWhiteSpace(duplicateFocusLabel))
            queryParts.Add("returnDuplicates=all");
        if (showDuplicatePanel && skippedDuplicateTerms.Count > 0)
            queryParts.Add($"returnSkipped={Uri.EscapeDataString(JoinIds(skippedDuplicateTerms))}");
        if (showDuplicatePanel && excludedDuplicateWordIds.Count > 0)
            queryParts.Add($"returnLeftOut={Uri.EscapeDataString(JoinIds(excludedDuplicateWordIds))}");

        if (!string.IsNullOrWhiteSpace(initialTargetTerm))
            queryParts.Add($"initialTargetTerm={Uri.EscapeDataString(initialTargetTerm)}");

        return queryParts.Count == 0
            ? $"/vocabulary/edit/{id}"
            : $"/vocabulary/edit/{id}?{string.Join("&", queryParts)}";
    }

    private async Task LoadDuplicateGroupsAsync(bool append)
    {
        var result = await ResourceRepo.FindDuplicateVocabularyGroupsAsync(
            duplicateFocusLabel,
            append ? duplicateGroups.Count : 0,
            duplicatePageSize,
            default,
            ActiveUserId);

        if (append)
            duplicateGroups.AddRange(result.Groups);
        else
            duplicateGroups = result.Groups.ToList();

        duplicateTotalGroupCount = result.TotalGroupCount;
        duplicateExtraRecordCount = result.ExtraRecordCount;
        duplicateSafeGroupCount = result.SafeGroupCount;
        duplicateSafeCopyCount = result.SafeCopyCount;
        duplicateReviewGroupCount = result.ReviewGroupCount;
        duplicateBlockedGroupCount = result.BlockedGroupCount;

        // Safe groups merge together and are not listed, so a count of the loaded ones would mislead.
        cleanupStatus = duplicateTotalGroupCount > 0
            ? $"Found {duplicateTotalGroupCount} group(s) of duplicate words with {duplicateExtraRecordCount} extra record(s)."
            : string.IsNullOrWhiteSpace(duplicateFocusLabel)
                ? "No duplicates found."
                : $"No duplicates found for '{duplicateFocusLabel}'.";
    }

    private bool IsFocusedDuplicateGroup(VocabularyDuplicateGroup group) =>
        !string.IsNullOrWhiteSpace(duplicateFocusNormalizedTerm)
        && group.NormalizedTerm == duplicateFocusNormalizedTerm;

    private async Task ScrollCleanupPanelIntoViewAsync()
    {
        try
        {
            await Task.Yield();
            await JS.InvokeVoidAsync("eval",
                "(() => { const el = document.getElementById('vocabulary-cleanup-panel'); if (!el) return; el.scrollIntoView({behavior:'smooth',block:'start'}); const main = document.querySelector('main.main-content'); if (main) main.scrollTop = el.offsetTop - 80; })()");
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            // Navigation interrupted the pending scroll; safe to ignore.
        }
    }

