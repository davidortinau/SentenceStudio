@page "/reading"
@attribute [Authorize]
@using SentenceStudio.Shared.Models
@using SentenceStudio.Models
@using SentenceStudio.Services
@using SentenceStudio.Services.Speech
@using SentenceStudio.Shared.Services
@using SentenceStudio.Services.Timer
@using SentenceStudio.Abstractions
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IAsyncDisposable

<div class="reading-page">
    @* ── Fixed header ── *@
    <div class="reading-page__header">
        <PageHeader Title='@Localize["Activity_Reading"]' ShowBack="true" OnBack="GoBack" />
        @if (resource is not null && sentences.Any())
        {
            <div class="d-flex align-items-center px-3 pb-2">
                <h2 class="ss-title2 mb-0">@resource.Title</h2>
            </div>
        }
    </div>

    @* ── Scrollable content ── *@
    <div class="reading-page__content">
        @if (isBusy)
        {
            <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 40vh;">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <p class="ss-body1 text-secondary-ss">@Localize["Reading_LoadingPassage"]</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="text-center p-5">
                <i class="bi bi-exclamation-triangle fs-1 text-warning-ss d-block mb-3"></i>
                <p class="ss-body1 text-secondary-ss">@errorMessage</p>
                <button class="btn btn-ss-secondary mt-3" @onclick="GoBack">@Localize["Common_GoBack"]</button>
            </div>
        }
        else if (resource is not null && sentences.Any())
        {
            @* Activity Timer (daily plan mode) *@
            @if (fromPlan)
            {
                <ActivityTimer IsActive="true" TargetMinutes="targetMinutes" />
            }

            @* Audio generation progress banner *@
            @if (isGeneratingAudio)
            {
                <div class="audio-gen-banner d-flex align-items-center gap-3 mb-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="flex-grow-1">
                        <div class="ss-body2 mb-1">@AudioStatusText</div>
                        @if (audioGenProgress > 0)
                        {
                            <div class="progress" style="height: 4px;">
                                <div class="progress-bar" style="width: @((audioGenProgress * 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (audioFailed)
            {
                @* Generation stopped with a failure: keep the reason visible; reading works without audio. *@
                <div class="audio-gen-banner d-flex align-items-center gap-3 mb-3" role="status">
                    <i class="bi bi-exclamation-triangle text-warning-ss"></i>
                    <div class="ss-body2 flex-grow-1">@AudioStatusText</div>
                </div>
            }

            @* Reading passage — no card wrapper, sits on page background *@
            <div class="interactive-text-wrapper" style="font-size: @(fontSize)px;">
                <InteractiveText
                    Sentences="@sentences"
                    VocabularyWords="@vocabularyWords"
                FocusVocabularyIds="@readingFocusVocabularyIds"
                SelectedSentenceIndex="@currentSentenceIndex"
                OnWordClicked="HandleWordClicked"
                    OnVocabularyWordClicked="HandleVocabularyWordClicked"
                    OnSentenceClicked="HandleSentenceClicked"
                    OnSentenceDoubleClicked="HandleSentenceDoubleClicked" />
            </div>
        }
        else
        {
            <div class="text-center p-5">
                <p class="ss-body1 text-secondary-ss">@Localize["Reading_NoContent"]</p>
                <button class="btn btn-ss-secondary mt-3" @onclick="GoBack">@Localize["Common_GoBack"]</button>
            </div>
        }
    </div>

    @* Word lookup offcanvas (bottom) *@
    @if (showWordPanel)
    {
        <div class="offcanvas offcanvas-bottom show" tabindex="-1"
             style="height: auto; max-height: 45vh; border-radius: var(--bs-border-radius-xl) var(--bs-border-radius-xl) 0 0;">
            <div class="offcanvas-header pb-1">
                <h4 class="ss-title2 mb-0" style="color: var(--bs-primary);">@selectedWord</h4>
                <button type="button" class="btn-close" @onclick="CloseWordPanel"></button>
            </div>
            <div class="offcanvas-body pt-1">
                @if (isTranslating)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                        <span class="ss-body2 text-secondary-ss">@Localize["Reading_LookingUpDef"]</span>
                    </div>
                }
                else if (translationUnavailable)
                {
                    <p class="ss-body1 mb-2">@Localize["Reading_TranslationUnavailable"]</p>
                }
                else if (!string.IsNullOrEmpty(wordDefinition))
                {
                    <p class="ss-body1 mb-2">@wordDefinition</p>
                }
                @if (selectedVocabWord is not null)
                {
                    <span class="badge bg-success text-white mb-2">
                        <i class="bi bi-check-circle me-1"></i>@Localize["Reading_InYourVocab"]
                    </span>
                }
                else if (!isTranslating && !translationUnavailable && !string.IsNullOrEmpty(wordDefinition))
                {
                    @if (isSavingWord)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            <span class="ss-body2">@Localize["Reading_Saving"]</span>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-ss-primary" @onclick="SaveWordToVocabulary">
                            <i class="bi bi-bookmark-plus me-1"></i> @Localize["Reading_RememberThisWord"]
                        </button>
                    }
                }
            </div>
        </div>
        <div class="offcanvas-backdrop fade show" @onclick="CloseWordPanel"></div>
    }

    @* ── Fixed footer: transport + font slider ── *@
    @if (resource is not null && sentences.Any() && (isAudioLoaded || sentences.Any()))
    {
        <div class="reading-page__footer">
            <div class="d-flex align-items-center gap-2">
                @* Prev / Play-Pause / Next *@
                <button class="btn btn-sm btn-icon" @onclick="PreviousSentence" disabled="@(!isAudioLoaded)">
                    <i class="bi bi-skip-backward-fill"></i>
                </button>
                <button class="btn btn-sm btn-ss-primary" @onclick="TogglePlayback" disabled="@(!isAudioLoaded && !isGeneratingAudio)">
                    @if (isAudioPlaying) { <i class="bi bi-pause-fill"></i> } else { <i class="bi bi-play-fill"></i> }
                </button>
                <button class="btn btn-sm btn-icon" @onclick="NextSentence" disabled="@(!isAudioLoaded)">
                    <i class="bi bi-skip-forward-fill"></i>
                </button>

                @* Sentence counter *@
                <span class="ss-caption1 text-secondary-ss text-nowrap">
                    @if (currentSentenceIndex >= 0)
                    {
                        @($"{currentSentenceIndex + 1} / {sentences.Count}")
                    }
                    else
                    {
                        @($"— / {sentences.Count}")
                    }
                </span>

                @* Time display *@
                @if (isAudioLoaded)
                {
                    <span class="ss-caption1 text-secondary-ss ms-auto text-nowrap">
                        @FormatTime(currentAudioTime) / @FormatTime(audioDuration)
                    </span>
                }
                else
                {
                    <span class="ms-auto"></span>
                }

                @* Speed selector *@
                <select class="form-select form-select-sm" style="width: 72px;"
                        value="@playbackSpeed" @onchange="OnSpeedChanged">
                    <option value="0.5">0.5×</option>
                    <option value="0.75">0.75×</option>
                    <option value="1">1.0×</option>
                    <option value="1.25">1.25×</option>
                    <option value="1.5">1.5×</option>
                    <option value="2">2.0×</option>
                </select>

                @* Font size slider *@
                <span class="d-none d-md-inline-flex align-items-center gap-1 ms-2 border-start ps-2" style="border-color: var(--bs-border-color) !important;">
                    <i class="bi bi-fonts ss-caption1 text-secondary-ss"></i>
                    <input type="range" class="form-range" style="width: 64px;"
                           min="14" max="40" step="2" value="@fontSize"
                           @oninput="OnFontSizeChanged" />
                </span>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "resourceId")]
    public string? ResourceIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "skillId")]
    public string? SkillIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "fromPlan")]
    public bool FromPlanParam { get; set; }

    [SupplyParameterFromQuery(Name = "targetMinutes")]
    public int? TargetMinutesParam { get; set; }

    [SupplyParameterFromQuery(Name = "planItemId")]
    public string? PlanItemId { get; set; }

    [SupplyParameterFromQuery(Name = "FocusVocabularyIds")]
    public string? FocusVocabularyIdsParam { get; set; }

    [Inject] private LearningResourceRepository ResourceRepo { get; set; } = default!;
    [Inject] private ElevenLabsSpeechService SpeechService { get; set; } = default!;
    [Inject] private TranslationService TranslationSvc { get; set; } = default!;
    [Inject] private UserActivityRepository ActivityRepo { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ILogger<Reading> Logger { get; set; } = default!;
    [Inject] private ILogger<TimestampedAudioManager> AudioManagerLogger { get; set; } = default!;
    [Inject] private IAudioPlayerFactory AudioPlayerFactory { get; set; } = default!;
    [Inject] private ILogger<SentenceTimingCalculator> TimingCalcLogger { get; set; } = default!;
    [Inject] private IActivityTimerService ActivityTimer { get; set; } = default!;
    private ActivityTimerLease? activityTimerLease;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IPreferencesService Preferences { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.IProgressService PlanProgressService { get; set; } = default!;

    // Content state
    private bool isBusy;
    private bool fromPlan;
    private int targetMinutes;
    private string errorMessage = "";
    private int fontSize = 20;
    private float playbackSpeed = 1.0f;
    private LearningResource? resource;
    private List<string> sentences = new();
    private List<VocabularyWord> vocabularyWords = new();
    private HashSet<string> readingFocusVocabularyIds = new(StringComparer.Ordinal);

    // Audio state
    private TimestampedAudioManager? _audioManager;
    private SentenceTimingCalculator? _timingCalculator;
    private bool isGeneratingAudio;
    // Status is kept as a resource key (plus optional detail) so it is shown localized.
    private string audioGenStatusKey = "";
    private string? audioGenStatusDetail;
    private bool audioFailed;
    private double audioGenProgress;
    private bool isAudioLoaded;
    private bool isAudioPlaying;
    private double currentAudioTime;
    private double audioDuration;
    private int currentSentenceIndex = -1;
    private bool _useJsAudio;
    private bool _browserAudioAttempted;
    private bool _disposed;
    private bool _disposeStarted;
    private readonly CancellationTokenSource _audioLifetime = new();
    private DotNetObjectReference<Reading>? _dotNetRef;

    // Word lookup state
    private bool showWordPanel;
    private bool isTranslating;
    private bool isSavingWord;
    private string selectedWord = "";
    private string wordDefinition = "";
    private bool translationUnavailable;
    private VocabularyWord? selectedVocabWord;
    // Each tap or close starts a new lookup; a slower earlier lookup never replaces it.
    private long _lookupGeneration;

    // The learner the passage was loaded for. Lookups and activity rows are recorded only
    // for this owner, and only while it is still the active profile (fail closed).
    private string _owner = string.Empty;

    private string AudioStatusText => string.IsNullOrEmpty(audioGenStatusKey)
        ? string.Empty
        : audioGenStatusDetail is null
            ? Localize[audioGenStatusKey]
            : Localize.Get(audioGenStatusKey, audioGenStatusDetail);

    // Preferences tracking
    private bool hasShownJumpHint;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Reading initialized — planItemId={PlanItemId}, resourceId={ResourceId}, skillId={SkillId}",
            PlanItemId ?? "(none)", ResourceIdParam ?? "(none)", SkillIdParam ?? "(none)");
        activityTimerLease = ActivityTimer.StartSession("Reading", PlanItemId, ResourceIdParam, SkillIdParam);
        fromPlan = FromPlanParam;
        targetMinutes = TargetMinutesParam ?? 15;

        // Load persisted preferences
        fontSize = (int)Preferences.Get("ReadingActivity_FontSize", 20.0);
        playbackSpeed = Preferences.Get("ReadingActivity_PlaybackSpeed", 1.0f);
        hasShownJumpHint = Preferences.Get("ReadingActivity_HasShownJumpHint", false);

        await LoadResource();
    }

    private async Task LoadResource()
    {
        if (string.IsNullOrEmpty(ResourceIdParam)) return;
        isBusy = true;
        try
        {
            _owner = Preferences.Get("active_profile_id", string.Empty);
            if (string.IsNullOrWhiteSpace(_owner))
            {
                Logger.LogWarning("Activity {ActivityName} opened without an active profile; nothing is loaded.", nameof(Reading));
                errorMessage = Localize["Vocabulary_NoActiveProfile"];
                return;
            }

            resource = await ResourceRepo.GetResourceAsync(ResourceIdParam, _owner);
            if (resource is null)
            {
                errorMessage = Localize["Reading_ResourceNotFound"];
                return;
            }

            vocabularyWords = resource.Vocabulary ?? new();
            var focusVocabularyIds = FocusVocabularySelection.ParseFocusVocabularyIds(FocusVocabularyIdsParam);
            if (focusVocabularyIds.Count == 0)
            {
                Logger.LogWarning("Activity {ActivityName} launched without FocusVocabularyIds (planItemId={PlanItemId}); falling back to legacy selection", nameof(Reading), PlanItemId);
                readingFocusVocabularyIds = new HashSet<string>(StringComparer.Ordinal);
            }
            else
            {
                var resourceFocusWords = FocusVocabularySelection.SelectFocusWords(vocabularyWords, focusVocabularyIds);
                readingFocusVocabularyIds = resourceFocusWords.Select(w => w.Id).ToHashSet(StringComparer.Ordinal);
                Logger.LogInformation("Reading resource contains {FocusOverlapCount} planned focus vocabulary words (planItemId={PlanItemId})", readingFocusVocabularyIds.Count, PlanItemId);
            }

            if (!string.IsNullOrEmpty(resource.Transcript))
            {
                sentences = SentenceTimingCalculator.SplitIntoSentences(resource.Transcript);
                // Remove paragraph break markers for display
                sentences = sentences.Where(s => s != "PARAGRAPH_BREAK").ToList();
            }
            else
            {
                errorMessage = Localize["Reading_NoTranscript"];
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load reading resource");
            errorMessage = Localize["NativeActivity_LoadFailed"];
        }
        finally
        {
            isBusy = false;
        }

        // Start audio generation in background (non-blocking)
        _ = InitializeAudioAsync();
    }

    private async Task InitializeAudioAsync()
    {
        if (_disposed || resource?.Transcript is null) return;

        isGeneratingAudio = true;
        audioFailed = false;
        SetAudioStatus("Reading_AudioInitializing");
        audioGenProgress = 0.1;
        await InvokeAsync(StateHasChanged);

        try
        {
            _timingCalculator = new SentenceTimingCalculator(TimingCalcLogger);
            _audioManager = new TimestampedAudioManager(_timingCalculator, AudioPlayerFactory, AudioManagerLogger);

            SetAudioStatus("Reading_AudioGenerating");
            audioGenProgress = 0.3;
            await InvokeAsync(StateHasChanged);

            var result = await SpeechService.GenerateTimestampedAudioAsync(resource);
            if (_disposed) return;

            if (result is not null)
            {
                SetAudioStatus("Reading_AudioProcessing");
                audioGenProgress = 0.7;
                await InvokeAsync(StateHasChanged);

                var timestampedAudio = new TimestampedAudio
                {
                    AudioData = result.AudioData.ToArray(),
                    Characters = result.Characters,
                    FullTranscript = resource.Transcript,
                    Duration = result.Duration.TotalSeconds
                };

                SetAudioStatus("Reading_AudioLoading");
                audioGenProgress = 0.9;
                await InvokeAsync(StateHasChanged);

                await _audioManager.LoadAudioAsync(timestampedAudio);
                if (_disposed) return;

                _useJsAudio = !AudioPlayerFactory.CanPlayLocally;
                if (_useJsAudio)
                {
                    Logger.LogInformation("Using browser audio for reading");
                    var base64 = Convert.ToBase64String(timestampedAudio.AudioData);
                    _browserAudioAttempted = true;
                    var browserDuration = await JS.InvokeAsync<double>(
                        "audioInterop.loadFromBase64", _audioLifetime.Token, base64, "audio/mpeg");
                    if (!double.IsFinite(browserDuration) || browserDuration <= 0)
                        throw new InvalidOperationException("The browser could not load the reading audio.");
                    if (_disposed) return;
                }
                else if (!_audioManager.HasNativePlayer)
                {
                    Logger.LogWarning("Native reading audio is unavailable on this device");
                    SetAudioStatus("Reading_AudioFailed");
                    audioFailed = true;
                    return;
                }

                _audioManager.SentenceChanged += OnSentenceChanged;
                _audioManager.ProgressUpdated += OnProgressUpdated;
                _audioManager.PlaybackEnded += OnPlaybackEnded;

                // Use audio manager's sentence list (cleaned of PARAGRAPH_BREAK)
                var audioSentences = _audioManager.GetSentences()
                    .Where(s => s != "PARAGRAPH_BREAK").ToList();
                if (audioSentences.Any())
                {
                    sentences = audioSentences;
                }

                audioDuration = timestampedAudio.Duration;
                isAudioLoaded = true;
                SetAudioStatus(string.Empty);

                Logger.LogInformation("Audio loaded: {Duration:F1}s, {SentenceCount} sentences",
                    audioDuration, sentences.Count);
            }
            else
            {
                Logger.LogWarning("Failed to generate timestamped audio");
                SetAudioStatus("Reading_AudioFailed");
                audioFailed = true;
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing audio");
            SetAudioStatus("Reading_AudioError", ex.Message);
            audioFailed = true;
            if (_browserAudioAttempted)
            {
                _browserAudioAttempted = false;
                try
                {
                    await JS.InvokeVoidAsync("audioInterop.stop");
                }
                catch (JSDisconnectedException)
                {
                    // The browser disconnected before audio could load.
                }
                catch (InvalidOperationException)
                {
                    // JS interop is unavailable during prerender.
                }
            }
        }
        finally
        {
            isGeneratingAudio = false;
            audioGenProgress = 0;
            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private void SetAudioStatus(string key, string? detail = null)
    {
        audioGenStatusKey = key;
        audioGenStatusDetail = detail;
    }

    // ── Audio event handlers (fire on background threads) ──

    private void OnSentenceChanged(object? sender, int sentenceIndex)
    {
        if (currentSentenceIndex != sentenceIndex)
        {
            currentSentenceIndex = sentenceIndex;
            _ = InvokeAsync(async () =>
            {
                StateHasChanged();
                // Auto-scroll current sentence into view
                await Task.Yield(); // let DOM update
                await JS.InvokeVoidAsync("eval",
                    "document.querySelector('.sentence--selected')?.scrollIntoView({behavior:'smooth',block:'center'})");
            });
        }
    }

    private void OnProgressUpdated(object? sender, double time)
    {
        currentAudioTime = time;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnPlaybackEnded(object? sender, EventArgs e)
    {
        isAudioPlaying = false;
        currentSentenceIndex = -1;
        _ = InvokeAsync(StateHasChanged);
    }

    // ── Audio controls ──

    private async Task TogglePlayback()
    {
        if (isGeneratingAudio)
        {
            Toast.ShowError(Localize["Reading_AudioStillLoading"]);
            return;
        }
        if (!isAudioLoaded || _audioManager is null)
        {
            Toast.ShowError(Localize["Reading_NoAudio"]);
            return;
        }

        if (isAudioPlaying)
        {
            if (_useJsAudio)
            {
                await JS.InvokeVoidAsync("audioInterop.pause");
                await StopJsTimeTracking();
            }
            else
            {
                _audioManager.Pause();
            }
            isAudioPlaying = false;
        }
        else
        {
            var startIndex = currentSentenceIndex >= 0 ? currentSentenceIndex : 0;
            if (_useJsAudio)
            {
                if (!await JsPlayFromSentence(startIndex)) return;
            }
            else
            {
                await _audioManager.PlayFromSentenceAsync(startIndex);
            }
            isAudioPlaying = true;
            currentSentenceIndex = startIndex;
        }
    }

    private async Task PreviousSentence()
    {
        if (_audioManager is null || !isAudioLoaded) return;
        if (currentSentenceIndex > 0)
        {
            currentSentenceIndex--;
            if (isAudioPlaying)
            {
                if (_useJsAudio)
                {
                    if (!await JsPlayFromSentence(currentSentenceIndex))
                        isAudioPlaying = false;
                }
                else
                    await _audioManager.PreviousSentenceAsync();
            }
        }
    }

    private async Task NextSentence()
    {
        if (_audioManager is null || !isAudioLoaded) return;
        if (currentSentenceIndex < sentences.Count - 1)
        {
            currentSentenceIndex++;
            if (isAudioPlaying)
            {
                if (_useJsAudio)
                {
                    if (!await JsPlayFromSentence(currentSentenceIndex))
                        isAudioPlaying = false;
                }
                else
                    await _audioManager.NextSentenceAsync();
            }
        }
    }

    private void OnSpeedChanged(ChangeEventArgs e)
    {
        if (float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var speed))
        {
            playbackSpeed = speed;
            Preferences.Set("ReadingActivity_PlaybackSpeed", playbackSpeed);
        }
    }

    private void OnFontSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            fontSize = size;
            Preferences.Set("ReadingActivity_FontSize", (double)fontSize);
        }
    }

    // ── JS interop audio fallback (webapp) ──

    private async Task<bool> JsPlayFromSentence(int sentenceIndex)
    {
        if (_disposed || _audioManager?.GetCurrentAudio() is null) return false;

        try
        {
            var sentenceInfo = _timingCalculator?.GetSentenceTimingInfo(
                sentenceIndex,
                _audioManager.GetCurrentAudio()!.Characters,
                _audioManager.GetCurrentAudio()!.FullTranscript);

            if (sentenceInfo != null)
                await JS.InvokeVoidAsync("audioInterop.seekTo", _audioLifetime.Token, sentenceInfo.StartTime);

            await JS.InvokeVoidAsync("audioInterop.play", _audioLifetime.Token);
            if (!await JS.InvokeAsync<bool>("audioInterop.isPlaying", _audioLifetime.Token))
                throw new InvalidOperationException("The browser did not start reading audio playback.");
            await StartJsTimeTracking();
            return true;
        }
        catch (OperationCanceledException) when (_disposed)
        {
            return false;
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Logger.LogError(ex, "Failed to play reading audio");
                Toast.ShowError(Localize["AudioPlaybackError"]);
            }
            return false;
        }
    }

    private async Task StartJsTimeTracking()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("audioInterop.startTimeTracking", _audioLifetime.Token, _dotNetRef, 50);
    }

    private async Task StopJsTimeTracking()
    {
        await JS.InvokeVoidAsync("audioInterop.stopTimeTracking");
    }

    [JSInvokable]
    public void OnJsTimeUpdate(double currentTime)
    {
        if (_disposed) return;
        currentAudioTime = currentTime;
        // Update sentence highlighting based on current time
        if (_audioManager != null)
        {
            var newIndex = _audioManager.GetSentenceIndexAtTime(currentTime);
            if (newIndex >= 0 && newIndex != currentSentenceIndex)
            {
                currentSentenceIndex = newIndex;
                _ = InvokeAsync(async () =>
                {
                    StateHasChanged();
                    await Task.Yield();
                    await JS.InvokeVoidAsync("eval",
                        "document.querySelector('.sentence--selected')?.scrollIntoView({behavior:'smooth',block:'center'})");
                });
                return;
            }
        }
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnJsPlaybackEnded()
    {
        if (_disposed) return;
        isAudioPlaying = false;
        currentSentenceIndex = -1;
        _ = InvokeAsync(StateHasChanged);
    }

    // ── Word interaction ──

    private async Task HandleWordClicked(string word)
    {
        var cleanWord = word.Trim().TrimEnd('.', ',', '!', '?', ':', ';', '"', '\'');
        var lookup = ++_lookupGeneration;
        selectedWord = cleanWord;
        selectedVocabWord = null;
        wordDefinition = "";
        isTranslating = false;
        translationUnavailable = false;
        showWordPanel = true;
        isSavingWord = false;

        // Check local vocabulary first
        var localWord = vocabularyWords?.FirstOrDefault(v =>
            v.TargetLanguageTerm?.Equals(cleanWord, StringComparison.OrdinalIgnoreCase) == true);

        if (localWord is not null && !string.IsNullOrEmpty(localWord.NativeLanguageTerm))
        {
            selectedVocabWord = localWord;
            wordDefinition = localWord.NativeLanguageTerm;
            return;
        }

        var owner = _owner;
        if (!OwnerStillActive())
        {
            Logger.LogWarning("Reading lookup refused: the active profile changed or is absent.");
            translationUnavailable = true;
            return;
        }

        // AI translation with sentence context
        isTranslating = true;
        StateHasChanged();

        string definition;
        var translated = false;
        try
        {
            string? context = currentSentenceIndex >= 0 && currentSentenceIndex < sentences.Count
                ? sentences[currentSentenceIndex] : null;

            // Reads the owner's vocabulary or asks the AI; the lookup is not saved as a word.
            definition = await TranslationSvc.TranslateAsync(cleanWord, context, owner);
            translated = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Translation failed for: {Word}", cleanWord);
            definition = string.Empty;
        }

        // Every lookup whose translation returned is recorded, even if the panel closed or
        // another word was tapped meanwhile; never after leaving or for another profile,
        // and never when the translation failed.
        if (translated && !_disposed && OwnerStillActive()
            && string.Equals(owner, _owner, StringComparison.Ordinal))
        {
            await RecordActivityAsync(owner, $"Dictionary lookup: {cleanWord}");
        }

        // A later tap or close supersedes this lookup: its result is not shown.
        if (lookup != _lookupGeneration)
            return;

        isTranslating = false;
        if (string.IsNullOrEmpty(definition))
            translationUnavailable = true;
        else
            wordDefinition = definition;
    }

    private Task HandleVocabularyWordClicked(VocabularyWord vw)
    {
        _lookupGeneration++;
        isTranslating = false;
        translationUnavailable = false;
        selectedWord = vw.TargetLanguageTerm ?? "";
        selectedVocabWord = vw;
        wordDefinition = vw.NativeLanguageTerm ?? "";
        showWordPanel = true;
        isSavingWord = false;
        return Task.CompletedTask;
    }

    private Task HandleSentenceClicked(int index)
    {
        currentSentenceIndex = index == currentSentenceIndex ? -1 : index;
        return Task.CompletedTask;
    }

    private async Task HandleSentenceDoubleClicked(int sentenceIndex)
    {
        if (_audioManager is null || !isAudioLoaded) return;

        if (!hasShownJumpHint)
        {
            Toast.ShowSuccess(Localize["Reading_JumpHint"]);
            hasShownJumpHint = true;
            Preferences.Set("ReadingActivity_HasShownJumpHint", true);
        }

        currentSentenceIndex = sentenceIndex;
        if (_useJsAudio)
        {
            if (!await JsPlayFromSentence(sentenceIndex)) return;
        }
        else
            await _audioManager.PlayFromSentenceAsync(sentenceIndex);
        isAudioPlaying = true;
    }

    private async Task SaveWordToVocabulary()
    {
        if (string.IsNullOrEmpty(selectedWord) || string.IsNullOrEmpty(wordDefinition) || translationUnavailable) return;

        var owner = _owner;
        if (!OwnerStillActive())
        {
            Logger.LogWarning("Reading save word refused: the active profile changed or is absent.");
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        isSavingWord = true;
        StateHasChanged();

        try
        {
            var newWord = new VocabularyWord
            {
                TargetLanguageTerm = selectedWord,
                NativeLanguageTerm = wordDefinition,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            var result = await ResourceRepo.SaveWordAsync(newWord, owner);
            if (result > 0)
            {
                // Associate with current resource
                if (!string.IsNullOrEmpty(resource?.Id))
                {
                    await ResourceRepo.AddVocabularyToResourceAsync(resource.Id, newWord.Id, owner);
                    vocabularyWords ??= new();
                    vocabularyWords.Add(newWord);
                }

                selectedVocabWord = newWord;
                Toast.ShowSuccess(Localize.Get("Reading_WordSaved", selectedWord));

                await RecordActivityAsync(owner, $"Added vocabulary: {selectedWord}");
            }
            else
            {
                Toast.ShowError(Localize["Reading_CouldNotSaveWord"]);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save word: {Word}", selectedWord);
            Toast.ShowError(Localize["Reading_ErrorSavingWord"]);
        }
        finally
        {
            isSavingWord = false;
        }
    }

    private void CloseWordPanel()
    {
        _lookupGeneration++;
        isTranslating = false;
        translationUnavailable = false;
        showWordPanel = false;
        selectedWord = "";
        wordDefinition = "";
        selectedVocabWord = null;
        isSavingWord = false;
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    // ── Navigation ──

    private async Task GoBack()
    {
        _disposed = true;
        _audioLifetime.Cancel();
        if (_browserAudioAttempted)
        {
            _browserAudioAttempted = false;
            try
            {
                await JS.InvokeVoidAsync("audioInterop.stop");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to stop reading browser audio during navigation");
            }
        }
        else if (_audioManager is not null)
        {
            _audioManager.Stop();
        }
        isAudioPlaying = false;

        // Pause timer
        if (fromPlan && ActivityTimer.IsActive)
        {
            if (activityTimerLease is not null)
                ActivityTimer.Pause(activityTimerLease);
        }

        // Report plan progress
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);

        // Record reading session
        if (resource is not null && OwnerStillActive())
        {
            await RecordActivityAsync(_owner, $"Reading session: {resource.Title}");
        }

        NavManager.NavigateTo("/");
    }

    // ── Owner ──

    private bool OwnerStillActive() =>
        !string.IsNullOrWhiteSpace(_owner)
        && string.Equals(_owner, Preferences.Get("active_profile_id", string.Empty), StringComparison.Ordinal);

    /// <summary>Writes one Reading UserActivity row for the owner; logs when it is not saved.</summary>
    private async Task RecordActivityAsync(string owner, string input)
    {
        var saved = await ActivityRepo.SaveAsync(new UserActivity
        {
            Activity = Activity.Reading.ToString(),
            Input = input,
            Accuracy = 100,
            Fluency = 100,
            UserProfileId = owner,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        });
        if (saved < 0)
            Logger.LogError("Reading could not save a UserActivity row.");
    }

    // ── Utilities ──

    private static string FormatTime(double seconds)
    {
        if (seconds < 0 || double.IsNaN(seconds)) seconds = 0;
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1 ? ts.ToString(@"h\:mm\:ss") : ts.ToString(@"m\:ss");
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposeStarted) return;
        _disposeStarted = true;
        _disposed = true;
        try
        {
            _audioLifetime.Cancel();
        }
        finally
        {
            try
            {
                Localize.CultureChanged -= OnCultureChanged;
            }
            finally
            {
                try
                {
                    ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
                }
                finally
                {
                    try
                    {
                        if (_browserAudioAttempted)
                        {
                            _browserAudioAttempted = false;
                            try
                            {
                                await JS.InvokeVoidAsync("audioInterop.stop");
                            }
                            catch (Exception ex)
                            {
                                Logger.LogWarning(ex, "Failed to stop reading browser audio during disposal");
                            }
                        }
                    }
                    finally
                    {
                        try
                        {
                            var manager = _audioManager;
                            _audioManager = null;
                            if (manager is not null)
                            {
                                try
                                {
                                    manager.SentenceChanged -= OnSentenceChanged;
                                    manager.ProgressUpdated -= OnProgressUpdated;
                                    manager.PlaybackEnded -= OnPlaybackEnded;
                                }
                                finally
                                {
                                    manager.Dispose();
                                }
                            }
                        }
                        finally
                        {
                            try
                            {
                                _dotNetRef?.Dispose();
                                _dotNetRef = null;
                            }
                            finally
                            {
                                _audioLifetime.Dispose();
                            }
                        }
                    }
                }
            }
        }
    }
}
