@page "/auth/login"
@attribute [AllowAnonymous]
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IDisposable

<div class="d-flex vh-100 align-items-center justify-content-center">
    <div class="w-100" style="max-width: 440px; padding: 1rem;">
        <div class="text-center mb-4">
            <h1 class="text-primary-ss fs-3 fw-bold">
                <i class="bi bi-translate me-2"></i>SentenceStudio
            </h1>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
        <h2 class="card-title text-center mb-4">@Localize["Login_SignIn"]</h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-3" role="alert">
                @errorMessage
            </div>
        }

        <div class="mb-3">
            <label class="form-label" for="email">@Localize["Common_Email"]</label>
            <input type="email" id="email" class="form-control"
                   @bind="email" @bind:event="oninput" placeholder='@Localize["Common_EmailPlaceholder"]' disabled="@isBusy" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">@Localize["Common_Password"]</label>
            <div class="input-group">
                <input type="@(showPassword ? "text" : "password")" id="password" class="form-control"
                       @bind="password" @bind:event="oninput" placeholder='@Localize["Common_PasswordPlaceholder"]' disabled="@isBusy" />
                <button class="btn btn-outline-secondary" type="button" @onclick="() => showPassword = !showPassword" disabled="@isBusy">
                    <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
            </div>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="rememberMe" @bind="rememberMe" disabled="@isBusy" />
            <label class="form-check-label" for="rememberMe">
                @Localize["Common_RememberMe"]
            </label>
        </div>

        <div class="d-grid gap-2 mb-3">
            <button class="btn btn-primary w-100" @onclick="HandleLogin" disabled="@(!CanSubmit)">
                @if (isBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>@Localize["Login_SigningIn"]</span>
                }
                else
                {
                    <span>@Localize["Login_SignIn"]</span>
                }
            </button>
        </div>

        <hr />
        <div class="text-center">
            <p class="mb-2">
                <a href="/auth/forgot-password">@Localize["Login_ForgotPassword"]</a>
            </p>
            <p>
                @Localize["Login_NoAccountCreateOne"]
                <a href="/auth/register">@Localize["Login_CreateOne"]</a>
            </p>
        </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IPreferencesService Preferences { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ILogger<LoginPage> Logger { get; set; } = default!;

    private string email = "";
    private string password = "";
    private string? errorMessage;
    private bool isBusy;
    private bool showPassword;
    private bool rememberMe;

    protected override void OnInitialized()
    {
        Localize.CultureChanged += OnCultureChanged;
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private bool CanSubmit => !isBusy
        && !string.IsNullOrWhiteSpace(email)
        && !string.IsNullOrWhiteSpace(password);

    private async Task HandleLogin()
    {
        if (!CanSubmit) return;

        isBusy = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await AuthService.SignInAsync(email.Trim(), password);

            if (result is not null)
            {
                Logger.LogInformation("Signed in as {User}",
                    SentenceStudio.Shared.Diagnostics.AuthLogRedaction.MaskUserName(result.UserName));

                Preferences.Set("app_is_authenticated", true);
                
                if (rememberMe)
                {
                    Preferences.Set("remember_me", true);
                    Preferences.Set("remember_email", email.Trim());
                }

                // Always route to "/" — MainLayout consults IPostLoginRouter to decide
                // whether to keep the user on the dashboard, defer for in-flight initial
                // sync, or redirect to /onboarding. Centralising the decision there means
                // a fresh-install-with-server-data login no longer short-circuits to
                // /onboarding just because the local "is_onboarded" preference is unset.
                // (issue #187)
                var returnUrl = "/";

                // Publish the new principal to Blazor BEFORE navigating.
                //
                // This page signs in through IAuthService directly, which updates the auth service
                // but tells Blazor nothing — CascadingAuthenticationState still holds the previous
                // (anonymous) principal, so AuthorizeRouteView would send the learner straight back
                // to NotAuthorized -> RedirectToLogin. That defect was invisible for as long as the
                // navigation below forced a full document load, because WebViewManager rebuilt the
                // whole page context and re-read the auth state from scratch. Forcing a document
                // load is not an acceptable way to publish an auth state change, so the state
                // change is published properly instead.
                //
                // NotifySignedIn re-publishes from the auth service's warm token cache — no
                // secure-storage read, no network. Notably NOT LogInSilentlyAsync: that re-runs the
                // silent sign-in, which ignores the cache, and on failure republishes the current
                // principal — anonymous, here — which would bounce the learner back to this page
                // with no error shown.
                if (AuthStateProvider is SentenceStudio.Services.MauiAuthenticationStateProvider mauiAuth)
                {
                    mauiAuth.NotifySignedIn();
                }

                // If the sign-in returned a userId|token pair, the server still has to write the
                // auth cookie and the browser has to leave this page for it to happen. See
                // PostSignInNavigation.AutoSignInUrl for why the two hosts differ here.
                var autoSignInUrl = PostSignInNavigation.AutoSignInUrl(result.AccessToken, returnUrl);

                if (autoSignInUrl is not null)
                {
                    // Always a full load: the whole point is to leave the page so the server can
                    // set the auth cookie. This branch only ever happens on the web host.
                    NavManager.NavigateTo(autoSignInUrl, forceLoad: true);
                }
                else
                {
                    // forceLoad ONLY on the web host. Inside a BlazorWebView a forced load makes
                    // WebViewManager.AttachToPageAsync dispose the current PageContext (destroying
                    // the WebViewRenderer) and build a brand-new DI scope for the new document.
                    // That gains nothing here — there is no cookie and no server round-trip — and
                    // it opens a window in which a render batch is still travelling to a renderer
                    // the JS side has already discarded, which surfaces as
                    // "There is no browser renderer with ID 3" and leaves the DOM showing the
                    // pre-login shell (no Sam FAB) until the app is restarted.
                    // See SentenceStudio.WebUI.Services.BlazorHostKind and dotnet/maui#28339.
                    //
                    // Routed through PostSignInNavigation because NotifySignedIn above is
                    // synchronous: MainLayout re-runs the post-login routing decision on the
                    // authentication transition and a fresh install is sent to /onboarding before
                    // control returns here. Navigating unconditionally would bounce that learner
                    // straight back to the dashboard and lose their onboarding.
                    var routed = PostSignInNavigation.RouteAfterSignIn(
                        NavManager,
                        returnUrl,
                        forceLoad: BlazorHostKind.ShouldForceLoadAfterSignIn(NavManager.BaseUri));

                    if (!routed)
                    {
                        Logger.LogInformation(
                            "Post-login routing already moved away from the sign-in page; leaving it in place.");
                    }
                }
            }
            else
            {
                errorMessage = Localize["Login_InvalidCredentials"];
            }
        }
        catch (NotSupportedException)
        {
            errorMessage = Localize["Login_NotAvailable"];
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Login connectivity error");
            errorMessage = Localize["Login_ConnectionError"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login failed");
            errorMessage = Localize["Login_UnexpectedError"];
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Localize.CultureChanged -= OnCultureChanged;
    }
}
