@page "/numberdrill"
@attribute [Authorize]
@using SentenceStudio.Abstractions
@using SentenceStudio.Services.Numbers
@using SentenceStudio.Shared.Models.Numbers
@using Microsoft.EntityFrameworkCore
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@inject NumberSessionService SessionService
@inject ApplicationDbContext Db
@inject UserProfileRepository ProfileRepo
@inject SentenceStudio.Abstractions.IPreferencesService Preferences
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ILogger<NumberDrill> Logger
@inject IAudioPlayerFactory AudioPlayerFactory
@inject ElevenLabsSpeechService SpeechService
@inject StreamHistoryRepository StreamHistoryRepo
@inject SentenceStudio.Services.SpeechVoicePreferences VoicePrefs
@inject SentenceStudio.Abstractions.IConnectivityService Connectivity
@inject SentenceStudio.Abstractions.IFileSystemService FileSystemService
@inject ToastService Toast
@inject SentenceStudio.Services.Timer.IActivityTimerService ActivityTimer
@inject SentenceStudio.Services.Plans.IPlanDateContext LearnerClock
@implements IAsyncDisposable

<div class="activity-page-wrapper">
    <PageHeader Title='@Localize["PlanItemNumberDrillTitle"]' ShowBack="true" OnBack="GoBack" />
    
    <div class="activity-content">
        @if (state == State.Loading)
        {
            <div class="d-flex justify-content-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Localize["Common_Loading"]</span>
                </div>
            </div>
        }
        else if (state == State.Gate)
        {
            @* ============ NOT AVAILABLE (non-Korean learner or no active owner) ============ *@
            <div class="mx-auto text-center p-4" style="max-width: 640px;" id="numberdrill-gate">
                <p class="ss-body1 text-secondary-ss mb-3">@Localize[gateKey]</p>
                <button type="button" class="btn btn-ss-secondary" @onclick="GoBack">@Localize["Common_GoBack"]</button>
            </div>
        }
        else if (state == State.Setup)
        {
            @* ============ SETUP CARD ============ *@
            <div class="mx-auto" style="max-width: 640px;">
                <div class="card card-ss p-4">
                    <h3 class="ss-title3 mb-3">@Localize["NumberDrill_ChooseDrill"]</h3>
                    
                    @* Context picker *@
                    <div class="mb-4">
                        <label class="ss-body2 fw-semibold mb-2 d-block">@Localize["NumberDrill_Context"]</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var ctx in availableContexts)
                            {
                                <button type="button" 
                                        class="btn @(selectedContext == ctx.Code ? "btn-ss-primary" : "btn-outline-secondary")"
                                        @onclick="() => OnContextSelected(ctx.Code)">
                                    <i class="bi @GetContextIcon(ctx.Code)"></i> @ctx.DisplayName
                                </button>
                            }
                            <button type="button" 
                                    class="btn @(selectedContext == null ? "btn-ss-primary" : "btn-outline-secondary")"
                                    @onclick="() => OnContextSelected(null)">
                                <i class="bi bi-asterisk"></i> @Localize["NumberDrill_AnyContext"]
                            </button>
                        </div>
                    </div>
                    
                    @* Sub-mode picker *@
                    <div class="mb-4">
                        <label class="ss-body2 fw-semibold mb-2 d-block">@Localize["NumberDrill_Mode"]</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var mode in availableSubModes.Where(m => IsValidCombo(selectedContext, m.Code)))
                            {
                                <button type="button" 
                                        class="btn @(selectedSubMode == mode.Code ? "btn-ss-primary" : "btn-outline-secondary")"
                                        data-submode="@mode.Code"
                                        @onclick="() => selectedSubMode = mode.Code">
                                    @mode.DisplayName
                                </button>
                            }
                        </div>
                    </div>
                    
                    @* Item count *@
                    <div class="mb-4">
                        <label class="ss-body2 fw-semibold mb-2 d-block">@Localize.Get("NumberDrill_Items", itemCount)</label>
                        <div class="d-flex gap-2 align-items-center">
                            <button type="button" class="btn btn-outline-secondary" aria-label='@Localize["NumberDrill_FewerItems"]'
                                    @onclick="() => itemCount = Math.Max(5, itemCount - 5)">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span class="ss-body1">@itemCount</span>
                            <button type="button" class="btn btn-outline-secondary" aria-label='@Localize["NumberDrill_MoreItems"]'
                                    @onclick="() => itemCount = Math.Min(20, itemCount + 5)">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                    
                    @* Due only toggle *@
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="dueOnlyCheck" @bind="dueOnly">
                        <label class="form-check-label ss-body2" for="dueOnlyCheck">
                            @Localize["NumberDrill_DueOnly"]
                        </label>
                    </div>
                    
                    @* Start button *@
                    <button type="button" class="btn btn-ss-primary w-100" @onclick="StartSessionAsync"
                            disabled="@(isBusy || string.IsNullOrEmpty(selectedSubMode))">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-play-fill me-1"></i> @Localize["NumberDrill_StartSession"]
                    </button>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-warning mt-3 mb-0" role="alert">
                            <i class="bi bi-exclamation-triangle me-1"></i>@errorMessage
                        </div>
                    }
                </div>
            </div>
        }
        else if (state == State.InSession && currentItem != null)
        {
            @* ============ ITEM CARD ============ *@
            <div class="mx-auto" style="max-width: 640px;">
                @* System color chip *@
                <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="chip-system-@(currentItem.System.ToString().ToLower()) px-3 py-1 rounded-pill small fw-semibold">
                            @currentItem.System
                        </span>
                        <span class="text-secondary-ss small">
                            <i class="bi @GetContextIcon(currentItem.ContextCode)"></i> @currentItem.ContextCode
                        </span>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-warning mb-3" role="alert" id="numberdrill-error">
                            <i class="bi bi-exclamation-triangle me-1"></i>@errorMessage
                        </div>
                    }

                    @if (!showFeedback)
                    {
                        @* Prompt area *@
                        @if (selectedSubMode == "ListenAndType")
                        {
                            <div class="text-center my-4">
                                <button type="button" class="btn btn-lg btn-ss-primary" @onclick="PlayAudioAsync" disabled="@isPlayingAudio">
                                    <i class="bi @(isPlayingAudio ? "bi-volume-mute" : "bi-volume-up") me-2"></i>
                                    @(isPlayingAudio ? Localize["NumberDrillPlaying"] : Localize["NumberDrill_Play"])
                                </button>
                            </div>
                        }
                        else if (selectedSubMode == "ReadAndProduce")
                        {
                            <div class="text-center my-4">
                                <div class="ss-display mb-2" style="font-size: 3rem; color: var(--bs-primary);">
                                    @currentItem.DisplayPrompt
                                </div>
                            </div>
                        }
                        else if (selectedSubMode == "TapTheCounter")
                        {
                            @* TapTheCounter UI: sentence frame + counter chips *@
                            <div class="text-center my-4">
                                @* Noun cue (if available) *@
                                @if (!string.IsNullOrEmpty(currentItem.NounCue))
                                {
                                    <div class="ss-body2 text-secondary-ss mb-3">
                                        <i class="bi bi-tag me-1"></i>@currentItem.NounCue
                                    </div>
                                }
                                
                                @* Sentence frame with blank counter *@
                                <div class="ss-display mb-4" style="font-size: 2.5rem;">
                                    @{
                                        var parts = currentItem.DisplayPrompt.Split("___");
                                        @parts[0]
                                        <span class="counter-blank">___</span>
                                        @(parts.Length > 1 ? parts[1] : "")
                                    }
                                </div>
                                
                                @* Counter chips *@
                                @if (currentItem.CounterChoices != null && currentItem.CounterChoices.Any())
                                {
                                    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                                        @foreach (var choice in currentItem.CounterChoices)
                                        {
                                            <button type="button" 
                                                    class="counter-chip @GetCounterChipClass(choice)"
                                                    @onclick="() => TapCounter(choice)"
                                                    disabled="@isBusy">
                                                <span class="counter-chip-text">@choice</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (selectedSubMode == "ListenAndPlace")
                        {
                            @* ListenAndPlace UI: audio button + 3 time cards *@
                            <div class="text-center my-4">
                                @* Audio button *@
                                <div class="mb-4">
                                    <button type="button" 
                                            class="btn btn-primary btn-lg" 
                                            @onclick="PlayAudioAsync"
                                            disabled="@(isBusy || isPlayingAudio)">
                                        <i class="bi bi-volume-up-fill me-2" style="font-size: 1.5rem;"></i>
                                        @(isPlayingAudio ? Localize["NumberDrillPlaying"] : Localize["NumberDrillPlayAudio"])
                                    </button>
                                </div>
                                
                                @* Instruction caption *@
                                <div class="ss-body1 text-secondary-ss mb-4">
                                    @Localize["NumberDrillListenAndPlaceInstructions"]
                                </div>
                                
                                @* Time cards (3 choices) *@
                                @if (currentItem.CounterChoices != null && currentItem.CounterChoices.Any())
                                {
                                    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                                        @foreach (var choice in currentItem.CounterChoices)
                                        {
                                            <button type="button" 
                                                    class="time-card @GetTimeCardClass(choice)"
                                                    @onclick="() => TapTimeCard(choice)"
                                                    disabled="@isBusy">
                                                <span class="time-card-text">@choice</span>
                                            </button>
                                        }
                                    </div>
                                }
                                
                                @* Replay audio button (smaller, always available) *@
                                <div class="mt-4">
                                    <button type="button" 
                                            class="btn btn-outline-secondary btn-sm" 
                                            @onclick="PlayAudioAsync"
                                            disabled="@(isBusy || isPlayingAudio)">
                                        <i class="bi bi-arrow-clockwise me-1"></i>@Localize["NumberDrillReplayAudio"]
                                    </button>
                                </div>
                            </div>
                        }
                    }
                                    
                    @if (selectedSubMode == "Disambiguate")
                    {
                        @* Disambiguate UI: two paired prompts with choice strips. The cards stay
                           after Submit so each prompt's hint shows with its result. *@
                        <div class="paired-prompt-container my-4">
                            @* Prompt A *@
                            <div class="paired-prompt-card mb-3 @GetDisambiguateCardClass(true)">
                                <div class="ss-body2 text-secondary-ss mb-2">@Localize["NumberDrill_PromptA"]</div>
                                <div class="ss-title3 mb-3">@currentItem.PromptA</div>
                                    
                                @if (currentItem.ChoicesA != null)
                                {
                                    <div class="choice-strip">
                                        @foreach (var choice in currentItem.ChoicesA)
                                        {
                                            <button type="button"
                                                    class="btn @(selectedAnswerA == choice ? "btn-ss-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SelectAnswerA(choice)"
                                                    disabled="@(showFeedback || isBusy)">
                                                @choice
                                            </button>
                                        }
                                    </div>
                                }
                                
                                @* Hint after feedback *@
                                @if (showFeedback && !string.IsNullOrEmpty(currentItem.HintA))
                                {
                                    <div class="mt-3 p-2 bg-secondary-subtle rounded" id="numberdrill-hint-a">
                                        <i class="bi bi-info-circle me-1"></i>
                                        <small class="ss-body2">@currentItem.HintA</small>
                                    </div>
                                }
                            </div>
                        
                            @* Prompt B *@
                            <div class="paired-prompt-card mb-3 @GetDisambiguateCardClass(false)">
                                <div class="ss-body2 text-secondary-ss mb-2">@Localize["NumberDrill_PromptB"]</div>
                                <div class="ss-title3 mb-3">@currentItem.PromptB</div>

                                @if (currentItem.ChoicesB != null)
                                {
                                    <div class="choice-strip">
                                        @foreach (var choice in currentItem.ChoicesB)
                                        {
                                            <button type="button"
                                                    class="btn @(selectedAnswerB == choice ? "btn-ss-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SelectAnswerB(choice)"
                                                    disabled="@(showFeedback || isBusy)">
                                                @choice
                                            </button>
                                        }
                                    </div>
                                }

                                @* Hint after feedback *@
                                @if (showFeedback && !string.IsNullOrEmpty(currentItem.HintB))
                                {
                                    <div class="mt-3 p-2 bg-secondary-subtle rounded" id="numberdrill-hint-b">
                                        <i class="bi bi-info-circle me-1"></i>
                                        <small class="ss-body2">@currentItem.HintB</small>
                                    </div>
                                }
                            </div>

                            @* Submit button (only when both selected and no feedback yet) *@
                            @if (!showFeedback)
                            {
                                <button type="button"
                                        class="btn btn-ss-primary w-100 mt-3"
                                        @onclick="SubmitBothAsync"
                                        disabled="@(isBusy || string.IsNullOrEmpty(selectedAnswerA) || string.IsNullOrEmpty(selectedAnswerB))">
                                    @if (isBusy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    @Localize["NumberDrillSubmitBoth"]
                                </button>
                            }
                        </div>
                    }

                    @if (!showFeedback)
                    {
                        @* Hint accordion (NOT for TapTheCounter, Disambiguate, or ListenAndPlace — those have inline hints) *@
                        @if (IsTextEntry && currentItem.Hints.Any())
                        {
                            <details class="mb-3">
                                <summary class="ss-body2 text-secondary-ss" style="cursor: pointer;">
                                    <i class="bi bi-lightbulb me-1"></i>@Localize["NumberDrill_ShowHint"]
                                </summary>
                                <ul class="mt-2 mb-0">
                                    @foreach (var hint in currentItem.Hints)
                                    {
                                        <li class="ss-body2 text-secondary-ss">@hint</li>
                                    }
                                </ul>
                            </details>
                        }
                        
                        @* Input field (only for text-entry sub-modes) *@
                        @if (IsTextEntry)
                        {
                            var placeholder = GetInputPlaceholder();
                            <form @onsubmit="SubmitAnswerAsync" @onsubmit:preventDefault>
                                <input type="text" 
                                       class="form-control form-control-ss mb-3" 
                                       @bind="userAnswer"
                                       @bind:event="oninput"
                                       @ref="answerInput"
                                       placeholder="@placeholder"
                                       aria-label="@placeholder"
                                       disabled="@isBusy"
                                       autocomplete="off" />
                                
                                <button type="submit" class="btn btn-ss-primary w-100" disabled="@(isBusy || string.IsNullOrWhiteSpace(userAnswer))">
                                    @if (isBusy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    @Localize["Common_Submit"]
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        @* Feedback panel *@
                        @if (lastGrade != null)
                        {
                            <div class="alert @(lastGrade.IsCorrect ? "alert-success" : "alert-danger") mb-3" id="numberdrill-feedback">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi @(lastGrade.IsCorrect ? "bi-check-circle-fill" : "bi-x-circle-fill") fs-4"></i>
                                    <span class="ss-title3">@lastGrade.Verdict</span>
                                </div>
                                
                                @* Show user input vs correct answer *@
                                @if (!string.IsNullOrEmpty(lastGrade.UserAnswer))
                                {
                                    <div class="ss-body2 mb-2">
                                        <strong>@Localize["NumberDrill_YouTyped"]</strong> @lastGrade.UserAnswer
                                    </div>
                                }
                                
                                @* Always show BOTH the digit form and the Korean word form
                                   so learners reinforce the digit↔word mapping in either
                                   direction (right or wrong, ListenAndType or ReadAndProduce). *@
                                @if (currentItem != null && !string.IsNullOrEmpty(currentItem.DigitDisplay))
                                {
                                    <div class="ss-body2 mb-1">
                                        <strong>@Localize["NumberDrill_Number"]</strong> @currentItem.DigitDisplay
                                    </div>
                                }
                                <div class="ss-body2 mb-2">
                                    <strong>@Localize["NumberDrill_Korean"]</strong> @lastGrade.CanonicalAnswer
                                </div>
                                
                                @if (!lastGrade.IsCorrect && !string.IsNullOrEmpty(lastGrade.ErrorClass))
                                {
                                    <div class="ss-body2 mb-2">
                                        <i class="bi bi-info-circle me-1"></i>
                                        <strong>@lastGrade.ErrorClass:</strong> @lastGrade.Tip
                                    </div>
                                }
                                
                                @if (lastAttemptResult != null && lastAttemptResult.Snapshot != null)
                                {
                                    <div class="small opacity-75">
                                        @Localize.Get("NumberDrill_MasteryProgress",
                                            lastAttemptResult.Snapshot.CorrectCount,
                                            lastAttemptResult.Snapshot.TotalCount,
                                            FormatReviewDate(lastAttemptResult.Snapshot.NextDueDate))
                                    </div>
                                }
                            </div>
                            
                            @* Override button (grader edge-case escape hatch) *@
                            @if (!lastGrade.IsCorrect)
                            {
                                <div class="text-center mt-3 mb-3">
                                    <button class="btn btn-outline-success btn-sm" 
                                            id="numberdrill-override"
                                            @onclick="OverrideAsCorrect"
                                            disabled="@_overriding">
                                        <i class="bi bi-check2 me-1"></i>@Localize["NumberDrill_IWasCorrect"]
                                    </button>
                                </div>
                            }
                            
                            <button type="button" class="btn btn-ss-primary w-100" @onclick="NextItemAsync"
                                    id="numberdrill-next" disabled="@(isBusy || _overrideInFlight)">
                                @if (currentIndex < session!.Items.Count - 1)
                                {
                                    <span>@Localize["Common_Next"] <i class="bi bi-arrow-right ms-1"></i></span>
                                }
                                else
                                {
                                    <span>@Localize["NumberDrill_Finish"] <i class="bi bi-check-lg ms-1"></i></span>
                                }
                            </button>
                        }
                    }
            </div>
        }
        else if (state == State.Summary && sessionSummary != null)
        {
            @* ============ SUMMARY SCREEN ============ *@
            <div class="mx-auto" style="max-width: 640px;">
                <div class="card card-ss p-4 text-center" id="numberdrill-summary">
                    <h2 class="ss-title1 mb-4"><i class="bi bi-check-circle me-2 text-success"></i>@Localize["NumberDrill_SessionComplete"]</h2>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="ss-title2 text-success" id="numberdrill-summary-correct">@sessionSummary.CorrectCount/@sessionSummary.TotalItems</div>
                            <div class="text-secondary-ss small">@Localize["Common_Correct"]</div>
                        </div>
                        <div class="col-6">
                            <div class="ss-title2" id="numberdrill-summary-median">@Localize.Get("NumberDrill_Milliseconds", sessionSummary.MedianLatencyMs)</div>
                            <div class="text-secondary-ss small">@Localize["NumberDrill_MedianTime"]</div>
                        </div>
                    </div>
                    
                    @if (sessionSummary.ErrorClassBreakdown.Any())
                    {
                        <div class="text-start mb-4" id="numberdrill-summary-patterns">
                            <h4 class="ss-title3 mb-2">@Localize["NumberDrill_PatternsToReview"]</h4>
                            @foreach (var kvp in sessionSummary.ErrorClassBreakdown
                                .OrderByDescending(x => x.Value).ThenBy(x => x.Key, StringComparer.Ordinal))
                            {
                                <div class="d-flex justify-content-between py-1">
                                    <span class="ss-body2">@kvp.Key</span>
                                    <span class="badge bg-warning text-dark">@kvp.Value</span>
                                </div>
                            }
                        </div>
                    }
                    
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-ss-primary flex-fill" @onclick="TryAgain">
                            <i class="bi bi-arrow-clockwise me-1"></i>@Localize["NumberDrill_AnotherRound"]
                        </button>
                        <button type="button" class="btn btn-ss-secondary flex-fill" @onclick="GoBack">
                            <i class="bi bi-check-lg me-1"></i>@Localize["Common_Done"]
                        </button>
                    </div>
                </div>
            </div>
        }
    </div> @* end activity-content *@
    
    @if (state == State.InSession && currentItem != null)
    {
        <div class="activity-footer d-flex justify-content-between align-items-center">
            <span id="drill-progress" class="ss-body1 text-secondary-ss">@(currentIndex + 1) / @session!.Items.Count</span>
            <span id="drill-correct-count" class="badge bg-success rounded-pill px-3"><i class="bi bi-check-lg me-1"></i>@Localize.Get("NumberDrill_CorrectCount", correctCount)</span>
        </div>
    }
    
</div> @* end activity-page-wrapper *@

@code {
    private const string LanguageCode = "ko";
    private ActivityTimerLease? activityTimerLease;

    [Parameter]
    [SupplyParameterFromQuery]
    public bool DueOnly { get; set; } = true;
    
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ResourceId { get; set; }
    
    [Parameter]
    [SupplyParameterFromQuery]
    public string? PlanItemId { get; set; }
    
    private enum State { Loading, Gate, Setup, InSession, Summary }
    
    private State state = State.Loading;
    private string gateKey = "NativeActivity_LaunchUnavailable";
    private bool isBusy;
    private bool isPlayingAudio;
    private string? errorMessage;

    // The learner this page was opened for. Every read and write is bound to it
    // and refused when the active profile is absent or has changed.
    private string? _ownerId;
    
    // Setup state
    private List<NumberContext> availableContexts = new();
    private List<NumberSubMode> availableSubModes = new();
    private string? selectedContext;
    private string selectedSubMode = "ListenAndType";
    private int itemCount = 10;
    private bool dueOnly = false;
    
    // Session state
    private NumberSession? session;
    private int currentIndex = 0;
    private NumberItem? currentItem;
    private string userAnswer = "";
    private ElementReference answerInput;
    private DateTime itemStartTime;
    private bool showFeedback;
    private bool _overriding;  // Double-tap protection for override button
    private bool _overrideInFlight;
    private SentenceStudio.Services.Numbers.GradeResult? lastGrade;
    private NumberAttemptResult? lastAttemptResult;

    // Auto-advance after a tapped choice or an override. Next, Back, Another
    // round or a newer auto-advance during the pause supersedes it.
    private TimeSpan _autoAdvanceDelay = TimeSpan.FromMilliseconds(1500);
    private long _advance;
    
    // TapTheCounter state
    private string? selectedCounter;
    private string? correctCounter;
    
    // Disambiguate state
    private string? selectedAnswerA;
    private string? selectedAnswerB;
    private bool isCorrectA;
    private bool isCorrectB;
    
    // Summary state
    private NumberSessionSummary? sessionSummary;
    
    // Audio playback
    private readonly UiAudioPlayerSession _nativeAudio = new();
    private readonly CancellationTokenSource _audioLifetime = new();
    private bool _browserAudioAttempted;
    private bool _disposed;
    private UiSpeechClipCache? _clipCache;
    
    // Aggregated stats
    private int correctCount = 0;
    private int totalCount = 0;
    
    private IJSObjectReference? jsModule;
    
    private bool IsTextEntry =>
        selectedSubMode != "TapTheCounter" && selectedSubMode != "Disambiguate" && selectedSubMode != "ListenAndPlace";

    private UiSpeechClipCache ClipCache =>
        _clipCache ??= new UiSpeechClipCache(StreamHistoryRepo, FileSystemService, Logger);

    protected override async Task OnInitializedAsync()
    {
        Localize.CultureChanged += OnCultureChanged;
        Logger.LogInformation("NumberDrill initialized — planItemId={PlanItemId}", PlanItemId ?? "(none)");
        
        // Layer 4: Defense-in-depth — NumberDrill ignores ResourceId
        if (!string.IsNullOrEmpty(ResourceId))
        {
            Logger.LogWarning("NumberDrill received ResourceId '{ResourceId}' — ignoring (NumberDrill is vocabulary-driven)", ResourceId);
            ResourceId = null;
        }
        
        try
        {
            var owner = ActiveOwnerId();
            var profile = string.IsNullOrWhiteSpace(owner) ? null : await ProfileRepo.GetByIdAsync(owner);
            if (profile is null)
            {
                Logger.LogWarning("NumberDrill refused: no active learner profile.");
                Gate("NativeActivity_LaunchUnavailable");
                return;
            }
            // The drill, its items, grader and audio are Korean only.
            if (!string.Equals(profile.TargetLanguage, "Korean", StringComparison.OrdinalIgnoreCase))
            {
                Gate("NumberDrill_KoreanOnly");
                return;
            }
            _ownerId = profile.Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Number Drill could not read the learner's profile.");
            Gate("NumberDrill_LoadFailed");
            return;
        }

        activityTimerLease = ActivityTimer.StartSession("NumberDrill", PlanItemId, ResourceId, null);
        state = State.Setup;
        await LoadSetupDataAsync();
    }

    private void Gate(string key)
    {
        gateKey = key;
        state = State.Gate;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SentenceStudio.UI/Pages/NumberDrill.razor.js");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load NumberDrill.razor.js — focus helper will be unavailable");
            }
        }
        
        // Focus input when showing new item
        if (state == State.InSession && !showFeedback && currentItem != null && IsTextEntry)
        {
            try
            {
                await answerInput.FocusAsync();
            }
            catch { /* ignore if element not ready */ }
        }
    }
    
    private async Task LoadSetupDataAsync()
    {
        try
        {
            isBusy = true;
            
            availableContexts = await Db.NumberContexts
                .Where(c => c.IsActive)
                .OrderBy(c => c.SortOrder)
                .ToListAsync();
            
            // The table has no sort column; keep the seed order.
            availableSubModes = NumberSubModeOrder.InSeedOrder(await Db.NumberSubModes
                .Where(m => m.IsActive && m.Phase <= 2)
                .ToListAsync());
            
            // Default to first sub-mode if available
            if (availableSubModes.Any() && string.IsNullOrEmpty(selectedSubMode))
            {
                selectedSubMode = availableSubModes[0].Code;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Number Drill could not load its setup.");
            errorMessage = Localize["NumberDrill_LoadFailed"];
        }
        finally
        {
            isBusy = false;
        }
    }
    
    private void OnContextSelected(string? contextCode)
    {
        selectedContext = contextCode;
        
        // Reset sub-mode if it becomes invalid for the new context
        if (!string.IsNullOrEmpty(selectedSubMode) && !IsValidCombo(contextCode, selectedSubMode))
        {
            selectedSubMode = availableSubModes.FirstOrDefault(m => IsValidCombo(contextCode, m.Code))?.Code ?? "";
        }
    }
    
    private bool IsValidCombo(string? contextCode, string subModeCode)
    {
        // "Any" pseudo-context: hide context-specific modes (random rotation could pick an invalid context)
        bool isAnyContext = string.IsNullOrEmpty(contextCode);
        if (isAnyContext && (subModeCode == "TapTheCounter" || subModeCode == "ListenAndPlace"))
            return false;
        
        // TapTheCounter: only Counting context (other contexts have no TapTheCounter generator)
        if (subModeCode == "TapTheCounter" && contextCode != "Counting")
            return false;
        
        // ListenAndPlace: only Time context (only Time has audio→digital cards generator)
        if (subModeCode == "ListenAndPlace" && contextCode != "Time")
            return false;
        
        return true;
    }
    
    private void OnCultureChanged() => InvokeAsync(StateHasChanged);
    
    private string ActiveOwnerId() =>
        Preferences.Get(UserProfileRepository.ActiveProfileIdKey, string.Empty) ?? string.Empty;

    /// <summary>The page's learner, when it is still the active profile.</summary>
    private bool TryOwner(out string userId)
    {
        userId = ActiveOwnerId();
        if (!string.IsNullOrWhiteSpace(_ownerId) && string.Equals(userId, _ownerId, StringComparison.Ordinal))
            return true;
        Logger.LogWarning("NumberDrill refused: the active profile is absent or changed.");
        userId = string.Empty;
        return false;
    }

    private async Task StartSessionAsync()
    {
        if (isBusy || string.IsNullOrEmpty(selectedSubMode))
            return;
        if (!TryOwner(out var userId))
        {
            errorMessage = Localize["NativeActivity_LaunchUnavailable"];
            return;
        }

        try
        {
            isBusy = true;
            errorMessage = null;
            
            var request = new NumberSessionRequest(
                ContextCode: selectedContext,
                SubModeCode: selectedSubMode,
                ItemCount: itemCount,
                DueOnly: dueOnly,
                Difficulty: 1
            );
            
            var started = await SessionService.StartSessionAsync(userId, LanguageCode, request);
            
            if (started.Items.Count == 0)
            {
                await SessionService.EndSessionAsync(started.SessionId);
                errorMessage = Localize["NumberDrill_NoItems"];
                return;
            }
            
            session = started;
            _advance++;
            state = State.InSession;
            correctCount = 0;
            totalCount = 0;
            ShowItem(0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Number Drill could not start a session.");
            errorMessage = Localize["NumberDrill_StartFailed"];
        }
        finally
        {
            isBusy = false;
        }
    }
    
    private async Task PlayAudioAsync()
    {
        if (_disposed || isPlayingAudio || currentItem == null || string.IsNullOrWhiteSpace(currentItem.AudioCue))
            return;
            
        isPlayingAudio = true;

        try
        {
            // The cue is the item's answer: it is never logged.
            var cue = currentItem.AudioCue;
            var voiceId = VoicePrefs.GetVoiceForLanguage(LanguageCode);
            var clip = await ClipCache.GetOrCreateAsync(cue, voiceId, Connectivity.IsInternetAvailable, "number",
                (voice, token) => SpeechService.TextToSpeechAsync(cue, voice, speed: 1.0f, cancellationToken: token),
                _audioLifetime.Token);
            if (_disposed)
                return;
            switch (clip.Status)
            {
                case UiSpeechClipStatus.Offline:
                    Toast.ShowWarning(Localize["NumberDrill_AudioOffline"]);
                    return;
                case UiSpeechClipStatus.Failed:
                    Toast.ShowError(Localize["NumberDrill_AudioFailed"]);
                    return;
            }

            if (AudioPlayerFactory.CanPlayLocally)
            {
                _nativeAudio.CreatePlayer(AudioPlayerFactory, new MemoryStream(clip.Audio!)).Play();
            }
            else
            {
                _nativeAudio.Stop();
                _browserAudioAttempted = true;
                await BrowserAudioPlayback.PlayAsync(JS, clip.Audio!, _audioLifetime.Token);
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            _nativeAudio.Stop();
            Logger.LogError(ex, "Failed to play number audio");
            if (!_disposed)
                Toast.ShowError(Localize["NumberDrill_AudioFailed"]);
        }
        finally
        {
            isPlayingAudio = false;
        }
    }
    
    /// <summary>
    /// Stores one attempt for the page's learner. Null when the owner is absent or
    /// changed, or the attempt could not be saved; the learner is told and the item
    /// stays answerable.
    /// </summary>
    private async Task<NumberAttemptResult?> RecordAsync(string answer)
    {
        if (session is null || currentItem is null)
            return null;
        if (!TryOwner(out var userId))
        {
            errorMessage = Localize["NativeActivity_LaunchUnavailable"];
            return null;
        }

        var latencyMs = (int)(DateTime.UtcNow - itemStartTime).TotalMilliseconds;
        try
        {
            var result = await SessionService.SubmitAnswerAsync(
                userId, session.SessionId, currentItem, answer, latencyMs);
            errorMessage = null;
            return result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Number Drill could not record an attempt.");
            errorMessage = Localize["NumberDrill_SubmitFailed"];
            return null;
        }
    }

    private void ShowFeedback(SentenceStudio.Services.Numbers.GradeResult grade, NumberAttemptResult result)
    {
        lastGrade = grade;
        lastAttemptResult = result;
        showFeedback = true;
        totalCount++;
        if (grade.IsCorrect)
            correctCount++;
    }

    private async Task SubmitAnswerAsync()
    {
        if (isBusy || showFeedback || string.IsNullOrWhiteSpace(userAnswer) || currentItem == null || session == null)
            return;
        
        try
        {
            isBusy = true;
            if (await RecordAsync(userAnswer.Trim()) is { } result)
                ShowFeedback(result.Grade, result);
        }
        finally
        {
            isBusy = false;
        }
    }
    
    /// <summary>
    /// "I was correct": re-grades the stored attempt and its mastery row (SM-2)
    /// through the shared service (Captain, 2026-11-02). Only a stored
    /// correction flips the on-screen grade and the counts; otherwise the learner
    /// is told, the item stays graded as stored, and they continue with Next.
    /// </summary>
    private async Task OverrideAsCorrect()
    {
        // Double-tap protection: disable immediately on first click
        if (_overriding || !showFeedback || lastGrade is not { IsCorrect: false } grade
            || lastAttemptResult is not { } attemptResult || currentItem is not { } item)
            return;
        if (!TryOwner(out var userId))
        {
            errorMessage = Localize["NativeActivity_LaunchUnavailable"];
            return;
        }

        _overriding = true;
        _overrideInFlight = true;
        errorMessage = null;
        // A tapped choice's pending auto-advance gives way to the correction.
        _advance++;

        // Telemetry for grader-miss analysis (no learner answer or identity).
        Logger.LogInformation(
            "NumberDrill grader override: subMode={SubMode} context={Context} system={System} " +
            "counter={Counter} digitValue={DigitValue} errorClass={ErrorClass}",
            item.SubModeCode, item.ContextCode, item.System, item.CounterId ?? "(none)",
            item.DigitValue, grade.ErrorClass ?? "(none)");

        NumberOverrideResult? stored = null;
        try
        {
            if (attemptResult.Receipt is { } receipt)
                stored = await SessionService.OverrideAttemptAsync(userId, receipt);
            else
                Logger.LogWarning("NumberDrill override has no stored attempt to correct.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "NumberDrill could not store the override.");
        }
        finally
        {
            _overrideInFlight = false;
        }

        // Back or leaving the page while the correction was stored.
        if (_disposed || state != State.InSession || !ReferenceEquals(item, currentItem) || !showFeedback)
            return;
        if (stored is not { Outcome: NumberOverrideOutcome.Applied or NumberOverrideOutcome.AlreadyCorrect })
        {
            _overriding = false;
            errorMessage = Localize["NumberDrill_OverrideFailed"];
            return;
        }

        lastGrade = grade with
        { 
            IsCorrect = true,
            Verdict = Localize["NumberDrill_OverriddenVerdict"]
        };
        if (stored.Snapshot is { } snapshot)
            lastAttemptResult = attemptResult with { Snapshot = snapshot };
        
        // Update session counts (override counts as correct for streak)
        correctCount++;
        
        // Auto-advance after a brief pause to show the override feedback
        await AutoAdvanceAsync(++_advance);
    }
    
    /// <summary>Shows the graded item, then advances unless something newer happened during the pause.</summary>
    private async Task AutoAdvanceAsync(long advance)
    {
        StateHasChanged();
        if (_autoAdvanceDelay > TimeSpan.Zero)
            await Task.Delay(_autoAdvanceDelay);
        if (_disposed || advance != _advance || !showFeedback || state != State.InSession || isBusy || _overrideInFlight)
            return;
        await AdvanceAsync();
    }

    /// <summary>Next / Finish.</summary>
    private async Task NextItemAsync()
    {
        if (!showFeedback || isBusy || _overrideInFlight || state != State.InSession || session == null)
            return;
        _advance++;
        await AdvanceAsync();
    }
        
    private async Task AdvanceAsync()
    {
        var next = currentIndex + 1;
        if (next >= session!.Items.Count)
        {
            // End session
            await EndSessionAsync();
            return;
        }
        ShowItem(next);
    }
            
    private void ShowItem(int index)
    {
        currentIndex = index;
        currentItem = session!.Items[index];
        userAnswer = "";
        showFeedback = false;
        _overriding = false;  // Reset double-tap protection for next item
        lastGrade = null;
        lastAttemptResult = null;
        errorMessage = null;
        itemStartTime = DateTime.UtcNow;
            
        // Reset TapTheCounter state
        selectedCounter = null;
        correctCounter = null;

        // Reset Disambiguate state
        selectedAnswerA = null;
        selectedAnswerB = null;
        isCorrectA = false;
        isCorrectB = false;
    }
    
    private async Task EndSessionAsync()
    {
        try
        {
            isBusy = true;
            
            // Median time and patterns come from the session's stored attempts.
            var summary = await SessionService.EndSessionAsync(session!.SessionId);
            
            // The page's counts include Disambiguate's both-or-nothing grading.
            sessionSummary = summary with
            { 
                CorrectCount = correctCount,
                TotalItems = totalCount
            };
            
            state = State.Summary;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Number Drill could not end its session.");
            errorMessage = Localize["NumberDrill_EndFailed"];
        }
        finally
        {
            isBusy = false;
        }
    }
    
    private void TryAgain()
    {
        _advance++;
        state = State.Setup;
        session = null;
        currentIndex = 0;
        currentItem = null;
        sessionSummary = null;
        userAnswer = "";
        showFeedback = false;
        lastGrade = null;
        lastAttemptResult = null;
        errorMessage = null;
        correctCount = 0;
        totalCount = 0;
    }
    
    private void GoBack()
    {
        // A pending auto-advance must not run after Back.
        _advance++;
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
        NavManager.NavigateTo("/");
    }
    
    // TapTheCounter methods
    private Task TapCounter(string counter) => TapChoiceAsync(counter, currentItem?.CounterText);
    
    private string GetCounterChipClass(string counter)
    {
        if (selectedCounter == null) return "";
        
        if (counter == correctCounter)
            return "correct";
        else if (counter == selectedCounter)
            return "incorrect";
        
        return "";
    }
    
    // ListenAndPlace methods
    private Task TapTimeCard(string timeChoice) => TapChoiceAsync(timeChoice, currentItem?.CanonicalAnswer);

    /// <summary>
    /// TapTheCounter chip or ListenAndPlace time card: graded and counted
    /// immediately, the feedback shown, then auto-advance after the pause.
    /// </summary>
    private async Task TapChoiceAsync(string choice, string? correctChoice)
    {
        if (isBusy || showFeedback || currentItem == null || session == null)
            return;
        if (currentItem.CounterChoices is not { } choices || !choices.Contains(choice))
            return;
        
        long advance;
        try
        {
            isBusy = true;
            selectedCounter = choice; // Reuse selectedCounter field for state
            correctCounter = correctChoice;
            
            if (await RecordAsync(choice) is not { } result)
            {
                selectedCounter = null;
                correctCounter = null;
                return;
            }
            ShowFeedback(result.Grade, result);
            advance = ++_advance;
        }
        finally
        {
            isBusy = false;
        }

        await AutoAdvanceAsync(advance);
    }
    
    private string GetTimeCardClass(string timeChoice)
    {
        if (selectedCounter == null) return "";
        
        if (timeChoice == correctCounter)
            return "correct";
        else if (timeChoice == selectedCounter)
            return "incorrect";
        
        return "";
    }
    
    // Disambiguate methods
    private void SelectAnswerA(string choice)
    {
        if (showFeedback || isBusy) return;
        selectedAnswerA = choice;
    }
    
    private void SelectAnswerB(string choice)
    {
        if (showFeedback || isBusy) return;
        selectedAnswerB = choice;
    }
    
    private async Task SubmitBothAsync()
    {
        if (isBusy || showFeedback || currentItem == null || session == null
            || string.IsNullOrEmpty(selectedAnswerA) || string.IsNullOrEmpty(selectedAnswerB))
            return;
        
        try
        {
            isBusy = true;
            
            // Grade both prompts
            var correctA = selectedAnswerA == currentItem.CorrectAnswerA;
            var correctB = selectedAnswerB == currentItem.CorrectAnswerB;
            var bothCorrect = correctA && correctB;
            
            // Submit combined answer (both-or-nothing for mastery tracking)
            var combinedAnswer = $"{selectedAnswerA} | {selectedAnswerB}";
            if (await RecordAsync(combinedAnswer) is not { } result)
                return;

            isCorrectA = correctA;
            isCorrectB = correctB;
            
            // Build custom grade result for UI feedback
            var verdict = bothCorrect ? Localize["NumberDrillBothCorrect"]
                        : (correctA || correctB) ? Localize["NumberDrillPartialCorrect"]
                        : Localize["NumberDrillBothIncorrect"];
            
            ShowFeedback(new SentenceStudio.Services.Numbers.GradeResult(
                IsCorrect: bothCorrect,
                Verdict: verdict,
                ErrorClass: bothCorrect ? "" : "system_confusion",
                CanonicalAnswer: $"A: {currentItem.CorrectAnswerA}, B: {currentItem.CorrectAnswerB}",
                UserAnswer: combinedAnswer,
                Tip: bothCorrect ? "" : Localize["NumberDrill_DisambiguateTip"]
            ), result);
        }
        finally
        {
            isBusy = false;
        }
    }
    
    private string GetDisambiguateCardClass(bool isPromptA)
    {
        if (!showFeedback) return "";
        
        var isCorrect = isPromptA ? isCorrectA : isCorrectB;
        return isCorrect ? "correct" : "incorrect";
    }
    
