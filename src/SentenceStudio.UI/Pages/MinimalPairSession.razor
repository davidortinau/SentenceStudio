@page "/minimal-pairs/session/{Id}"
@attribute [Authorize]
@using SentenceStudio.Abstractions
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IAsyncDisposable

<PageHeader Title='@Localize["Activity_MinimalPairs"]' ShowBack="true" OnBack="GoBack" />

@if (showSummary)
{
    @* Session summary *@
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
        <h2 class="ss-title1 mb-4">@Localize["MinimalPairSession_SessionSummary"]</h2>
        <div class="card card-ss p-4" style="min-width: 300px;">
            <div class="mb-3">
                <span class="ss-body1">@Localize["MinimalPairSession_Correct"]</span>
                <span class="ss-title2 text-success ms-2">@correctCount</span>
            </div>
            <div class="mb-3">
                <span class="ss-body1">@Localize["MinimalPairSession_Incorrect"]</span>
                <span class="ss-title2 text-danger ms-2">@incorrectCount</span>
            </div>
            <div class="mb-3">
                <span class="ss-body1">@Localize["Common_Accuracy"]</span>
                <span class="ss-title2 ms-2">@($"{Accuracy:F1}")%</span>
            </div>
            <div class="mb-3">
                <span class="ss-body1">@Localize["MinimalPairSession_Duration"]</span>
                <span class="ss-title2 ms-2">@Localize.Get("NativeMinimalPairs_DurationValue", Duration)</span>
            </div>
        </div>
        <button class="btn btn-ss-primary mt-4" @onclick="GoBack">@Localize["Common_Done"]</button>
    </div>
}
else if (isInitializing)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (promptWord != null && leftWord != null && rightWord != null)
{
    @* Session header *@
    <div class="text-center mb-4">
        <p class="ss-body2 text-secondary-ss mb-2">@string.Format(Localize["MinimalPairSession_Trial"], currentTrialIndex + 1, totalTrials)</p>
        <div class="d-flex justify-content-center gap-4">
            <span class="ss-title3 text-success"><i class="bi bi-check-lg"></i> @correctCount</span>
            <span class="ss-title3 text-danger"><i class="bi bi-x-lg"></i> @incorrectCount</span>
        </div>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <small class="text-warning">@errorMessage</small>
        }
    </div>

    @* Answer tiles *@
    <div class="d-flex justify-content-center gap-4 my-5">
        @RenderAnswerTile(leftWord)
        @RenderAnswerTile(rightWord)
    </div>

    @* Action buttons *@
    <div class="d-flex justify-content-center gap-3">
        <button class="btn btn-ss-secondary" @onclick="ReplayAudio"
                disabled="@(isPlayingAudio || hasCheckedAnswer)">
            <i class="bi bi-volume-up me-1"></i> @Localize["MinimalPairSession_Replay"]
        </button>
        <button class="btn btn-ss-primary" @onclick="CheckAnswer"
                disabled="@(selectedWordId == null || isDebouncing || hasCheckedAnswer)">
            @Localize["MinimalPairSession_CheckAnswer"]
        </button>
    </div>
}
else
{
    <div class="text-center p-5">
        <p class="ss-body1 text-secondary-ss">@Localize["MinimalPairSession_NoPairs"]</p>
        <button class="btn btn-ss-secondary mt-3" @onclick="GoBack">@Localize["Common_GoBack"]</button>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    [SupplyParameterFromQuery(Name = "pairIds")]
    public string? PairIdsParam { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? ModeParam { get; set; }

    [SupplyParameterFromQuery(Name = "trials")]
    public int? TrialsParam { get; set; }

    [Inject] private MinimalPairRepository PairRepo { get; set; } = default!;
    [Inject] private MinimalPairSessionRepository SessionRepo { get; set; } = default!;
    [Inject] private StreamHistoryRepository StreamHistoryRepo { get; set; } = default!;
    [Inject] private ElevenLabsSpeechService SpeechService { get; set; } = default!;
    [Inject] private IAudioPlayerFactory AudioPlayerFactory { get; set; } = default!;
    [Inject] private SentenceStudio.Services.SpeechVoicePreferences VoicePrefs { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IConnectivityService Connectivity { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IFileSystemService FileSystemService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ILogger<MinimalPairSession> Logger { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IPreferencesService Preferences { get; set; } = default!;

    private List<MinimalPair> pairs = new();
    // The learner the session was started for. Reads and writes use it, and are
    // refused when it is absent or no longer the active profile (fail closed).
    private string _owner = string.Empty;
    private bool isInitializing = true;
    private bool showSummary;
    private bool isPlayingAudio;
    private bool _useJsAudio;
    private bool _browserAudioAttempted;
    private bool _disposed;
    private readonly CancellationTokenSource _audioLifetime = new();
    private UiSpeechClipCache? _clipCache;
    private UiSpeechClipCache ClipCache =>
        _clipCache ??= new UiSpeechClipCache(StreamHistoryRepo, FileSystemService, Logger);
    private bool hasCheckedAnswer;
    private bool isDebouncing;
    private string errorMessage = "";

    private int currentTrialIndex;
    private int totalTrials = 20;
    private int correctCount;
    private int incorrectCount;
    private string? sessionId;
    private DateTime? sessionStartedAt;

    private MinimalPair? currentPair;
    private VocabularyWord? promptWord;
    private VocabularyWord? otherWord;
    private VocabularyWord? leftWord;
    private VocabularyWord? rightWord;
    private string? selectedWordId;
    private bool? answerWasCorrect;

    private readonly UiAudioPlayerSession _nativeAudio = new();
    private readonly Random random = new();

    private double Accuracy => (correctCount + incorrectCount) > 0
        ? (double)correctCount / (correctCount + incorrectCount) * 100 : 0;
    private double Duration => sessionStartedAt.HasValue
        ? (DateTime.UtcNow - sessionStartedAt.Value).TotalMinutes : 0;

    protected override async Task OnInitializedAsync()
    {
        Localize.CultureChanged += OnCultureChanged;
        _useJsAudio = !AudioPlayerFactory.CanPlayLocally;
        await InitializeSession();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private async Task InitializeSession()
    {
        isInitializing = true;
        try
        {
            _owner = Preferences.Get("active_profile_id", string.Empty);
            if (string.IsNullOrWhiteSpace(_owner))
            {
                Logger.LogWarning("Minimal Pairs session opened without an active profile; nothing is loaded.");
                Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
                isInitializing = false;
                return;
            }

            var pairIds = ParsePairIds();
            if (pairIds.Length == 0)
            {
                isInitializing = false;
                return;
            }

            foreach (var id in pairIds)
            {
                // Only the owner's pairs whose two words still exist.
                var pair = await PairRepo.GetPairByIdAsync(_owner, id);
                if (pair?.VocabularyWordA != null && pair.VocabularyWordB != null) pairs.Add(pair);
            }

            if (pairs.Count == 0) { isInitializing = false; return; }

            var mode = ModeParam ?? "Focus";
            totalTrials = TrialsParam ?? 20;

            var session = await SessionRepo.StartSessionAsync(_owner, mode, totalTrials);
            if (session is null)
            {
                pairs.Clear();
                isInitializing = false;
                return;
            }
            sessionId = session.Id;
            sessionStartedAt = DateTime.UtcNow;
            isInitializing = false;

            NextTrial();
            _ = Task.Delay(500).ContinueWith(_ => InvokeAsync(async () =>
            {
                await PlayPromptAudio();
                StateHasChanged();
            }));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize session");
            isInitializing = false;
        }
    }

    private string[] ParsePairIds()
    {
        if (string.IsNullOrEmpty(PairIdsParam)) return Array.Empty<string>();
        return PairIdsParam.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(Uri.UnescapeDataString)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .ToArray();
    }

    private void NextTrial()
    {
        if (currentTrialIndex >= totalTrials)
        {
            _ = EndSession();
            return;
        }

        var pair = pairs[random.Next(pairs.Count)];
        var isAPrompt = random.Next(2) == 0;
        var prompt = isAPrompt ? pair.VocabularyWordA : pair.VocabularyWordB;
        var other = isAPrompt ? pair.VocabularyWordB : pair.VocabularyWordA;
        var left = random.Next(2) == 0 ? prompt : other;
        var right = left?.Id == prompt?.Id ? other : prompt;

        currentPair = pair;
        promptWord = prompt;
        otherWord = other;
        leftWord = left;
        rightWord = right;
        selectedWordId = null;
        hasCheckedAnswer = false;
        answerWasCorrect = null;
        isDebouncing = false;
        errorMessage = "";
    }

    private async Task PlayPromptAudio()
    {
        if (_disposed || promptWord == null) return;
        isPlayingAudio = true;

        try
        {
            var text = promptWord.TargetLanguageTerm;
            var voiceId = VoicePrefs.VoiceId;

            // The owner's cached clip is found by file name under today's AudioCache (the stored
            // absolute path changes when iOS moves the app container); otherwise it is
            // synthesized once and cached, pointing the existing row at it (B35).
            var clip = await ClipCache.GetOrCreateAsync(text, voiceId, Connectivity.IsInternetAvailable, "word",
                (voice, token) => SpeechService.TextToSpeechAsync(text, voice, 0.5f, 0.75f, 0.85f, cancellationToken: token),
                _audioLifetime.Token);
            if (_disposed)
                return;
            switch (clip.Status)
            {
                case UiSpeechClipStatus.Offline:
                    errorMessage = Localize["NumberDrill_AudioOffline"];
                    return;
                case UiSpeechClipStatus.Failed:
                    errorMessage = Localize["NativeMinimalPairs_PlaybackError"];
                    return;
            }

            if (_useJsAudio)
            {
                // Server-side Blazor: route audio through JS interop
                _nativeAudio.Stop();
                _browserAudioAttempted = true;
                await BrowserAudioPlayback.PlayAsync(JS, clip.Audio!, _audioLifetime.Token);
            }
            else
            {
                _nativeAudio.CreatePlayer(AudioPlayerFactory, new MemoryStream(clip.Audio!)).Play();
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            _nativeAudio.Stop();
            if (!_disposed)
            {
                Logger.LogError(ex, "Failed to play audio");
                errorMessage = Localize["NativeMinimalPairs_PlaybackError"];
            }
        }
        finally
        {
            isPlayingAudio = false;
        }
    }

    private void SelectWord(string wordId)
    {
        if (isDebouncing || hasCheckedAnswer) return;
        selectedWordId = wordId;
    }

    private async Task CheckAnswer()
    {
        if (selectedWordId == null || hasCheckedAnswer) return;
        isDebouncing = true;

        var isCorrect = selectedWordId == promptWord?.Id;
        hasCheckedAnswer = true;
        answerWasCorrect = isCorrect;
        if (isCorrect) correctCount++; else incorrectCount++;

        if (sessionId is not null && currentPair != null && promptWord != null)
        {
            if (!OwnerStillActive())
            {
                Logger.LogWarning("Minimal pair attempt not recorded: the active profile changed or is absent.");
            }
            else if (await SessionRepo.RecordAttemptAsync(_owner, sessionId, currentPair.Id,
                promptWord.Id, selectedWordId, isCorrect) is null)
            {
                Logger.LogWarning("Minimal pair attempt was refused by the repository.");
            }
        }

        currentTrialIndex++;
        StateHasChanged();

        await Task.Delay(1500);
        NextTrial();
        _ = PlayPromptAudio();
        StateHasChanged();
    }

    private async Task ReplayAudio()
    {
        if (!isPlayingAudio && answerWasCorrect == null)
            await PlayPromptAudio();
    }

    private async Task EndSession()
    {
        if (sessionId is not null && OwnerStillActive())
            await SessionRepo.EndSessionAsync(_owner, sessionId);
        showSummary = true;
    }

    private bool OwnerStillActive() =>
        !string.IsNullOrWhiteSpace(_owner)
        && string.Equals(_owner, Preferences.Get("active_profile_id", string.Empty), StringComparison.Ordinal);

    private void GoBack() => NavManager.NavigateTo("/minimal-pairs");

    private RenderFragment RenderAnswerTile(VocabularyWord word) => __builder =>
    {
        var isSelected = selectedWordId == word.Id;
        var isCorrectAnswer = word.Id == promptWord?.Id;

        var borderClass = "";
        var bgClass = "";
        var iconHtml = "";

        if (!hasCheckedAnswer && isSelected)
        {
            borderClass = "border-success";
        }
        else if (hasCheckedAnswer)
        {
            if (isSelected && answerWasCorrect == true)
            {
                borderClass = "border-info";
                bgClass = "bg-info bg-opacity-10";
            }
            else if (isSelected && answerWasCorrect == false)
            {
                borderClass = "border-danger";
                bgClass = "bg-danger bg-opacity-10";
            }
            else if (isCorrectAnswer && answerWasCorrect == false)
            {
                borderClass = "border-info";
                bgClass = "bg-info bg-opacity-10";
            }

            if (isCorrectAnswer)
                iconHtml = "<i class='bi bi-check-lg'></i>";
        }

        <div class="card card-ss clickable p-4 text-center @borderClass @bgClass"
             style="width: 150px; height: 150px; border-width: 3px !important; display: flex; align-items: center; justify-content: center; position: relative;"
             @onclick="() => SelectWord(word.Id)">
            <span class="ss-title2">@word.TargetLanguageTerm</span>
            @if (!string.IsNullOrEmpty(iconHtml))
            {
                <span class="position-absolute top-0 end-0 m-1 text-info fw-bold">@iconHtml</span>
            }
        </div>
    };

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        try
        {
            _audioLifetime.Cancel();
        }
        finally
        {
            try
            {
                Localize.CultureChanged -= OnCultureChanged;
            }
            finally
            {
                try
                {
                    _nativeAudio.Dispose();
                }
                finally
                {
                    try
                    {
                        if (_browserAudioAttempted)
                        {
                            _browserAudioAttempted = false;
                            try
                            {
                                await JS.InvokeVoidAsync("audioInterop.stop");
                            }
                            catch (Exception ex)
                            {
                                Logger.LogWarning(ex, "Failed to stop minimal-pair browser audio during disposal");
                            }
                        }
                    }
                    finally
                    {
                        _audioLifetime.Dispose();
                    }
                }
            }
        }
    }
}
