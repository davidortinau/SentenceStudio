@page "/conversation"
@attribute [Authorize]
@using SentenceStudio.Shared.Models
@using SentenceStudio.Services
@using SentenceStudio.Services.Speech
@using SentenceStudio.Services.Timer
@using SentenceStudio.Abstractions
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IAsyncDisposable

<div class="d-flex flex-column h-100">
<PageHeader Title='@Localize["Activity_Conversation"]' ShowBack="true" OnBack="GoBack">
    <ToolbarActions>
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                    type="button" data-bs-toggle="dropdown" aria-expanded="false"
                    title='@Localize["NativeConversation_ChangeLanguage"]' aria-label='@Localize["NativeConversation_ChangeLanguage"]'>
                <i class="bi bi-translate"></i>
                <span class="d-none d-md-inline ss-caption1">@targetLanguage</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                @foreach (var lang in SentenceStudio.Common.Constants.Languages)
                {
                    var l = lang;
                    <li>
                        <button class="dropdown-item @(l == targetLanguage ? "active" : "")"
                                @onclick="() => ChangeLanguage(l)">
                            @l
                        </button>
                    </li>
                }
            </ul>
        </div>
    </ToolbarActions>
</PageHeader>
@if (isBusy && !chunks.Any())
{
    <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="ss-body1 text-secondary-ss">@Localize["Conversation_StartingConversation"]</p>
    </div>
}
else
{
    @* Activity Timer *@
    @if (fromPlan)
    {
        <div class="flex-shrink-0">
            <ActivityTimer IsActive="true" TargetMinutes="targetMinutes" />
        </div>
    }

    @* Scenario selector *@
    @if (scenarios.Any())
    {
        <div class="d-flex align-items-center gap-2 mb-3 flex-shrink-0">
            <label class="ss-caption1 text-secondary-ss mb-0">@Localize["Conversation_Scenario"]</label>
            <select class="form-select form-select-sm" style="width: auto;" @onchange="OnScenarioChanged">
                @foreach (var s in scenarios)
                {
                    <option value="@s.Id" selected="@(s.Id == activeScenario?.Id)">@s.DisplayName</option>
                }
            </select>
        </div>
    }

    @* Chat messages — scrollable, fills remaining space *@
    <div class="d-flex flex-column gap-2 flex-grow-1 overflow-auto pb-2" @ref="chatContainer">
        @foreach (var chunk in chunks)
        {
            var isUser = chunk.Role == ConversationRole.User;
            <div class="d-flex @(isUser ? "justify-content-end" : "justify-content-start")">
                <div class="card p-3 @(isUser ? "bg-primary bg-opacity-10" : "card-ss")"
                     style="max-width: 75%; border-radius: 16px; @(isUser ? "border-bottom-right-radius: 4px;" : "border-bottom-left-radius: 4px;")">
                    @if (toolNotes.TryGetValue(chunk, out var notes))
                    {
                        @foreach (var note in notes)
                        {
                            <div class="ss-caption1 text-secondary-ss mb-1 d-flex align-items-center gap-1" data-testid="voice-tool-note">
                                <i class="bi bi-journal-check"></i>
                                <span>@string.Format(Localize["Conversation_VoiceToolNote"], note)</span>
                            </div>
                        }
                    }
                    @if (voiceChunks.Contains(chunk) && string.IsNullOrEmpty(chunk.Text))
                    {
                        <p class="ss-body1 mb-0 text-secondary-ss fst-italic">@Localize["Conversation_VoiceTranscribing"]</p>
                    }
                    else
                    {
                        <p class="ss-body1 mb-0">
                            @if (voiceChunks.Contains(chunk))
                            {
                                <i class="bi bi-mic-fill me-1 text-secondary-ss" title='@Localize["Conversation_Voice"]'></i>
                            }
                            @chunk.Text
                        </p>
                    }

                    @if (chunk.GrammarCorrections?.Any() == true)
                    {
                        <div class="mt-2 pt-2 border-top border-secondary-subtle">
                            @foreach (var correction in chunk.GrammarCorrections)
                            {
                                <div class="mb-1">
                                    <small>
                                        <span class="text-danger text-decoration-line-through">@correction.Original</span>
                                        → <span class="text-success fw-bold">@correction.Corrected</span>
                                    </small>
                                    @if (!string.IsNullOrEmpty(correction.Explanation))
                                    {
                                        <br /><small class="text-secondary-ss">@correction.Explanation</small>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (Reply.NormalizeComprehension(chunk.Comprehension) > 0)
                    {
                        <div class="mt-1">
                            <small class="text-secondary-ss">@string.Format(Localize["Conversation_Comprehension"], (int)Reply.NormalizeComprehension(chunk.Comprehension))</small>
                        </div>
                    }

                    @if (!isUser && !voiceChunks.Contains(chunk))
                    {
                        <button class="btn btn-sm btn-link p-0 mt-1 text-start" @onclick="() => PlayChunkAudio(chunk)">
                            <i class="bi bi-volume-up me-1"></i> @Localize["Conversation_Listen"]
                        </button>
                    }
                </div>
            </div>
        }

        @if (isWaitingForReply)
        {
            <div class="d-flex justify-content-start">
                <div class="card card-ss p-3" style="border-radius: 16px; border-bottom-left-radius: 4px;">
                    <div class="d-flex gap-1">
                        <div class="spinner-grow spinner-grow-sm text-secondary" role="status"></div>
                        <div class="spinner-grow spinner-grow-sm text-secondary" role="status" style="animation-delay: 0.15s;"></div>
                        <div class="spinner-grow spinner-grow-sm text-secondary" role="status" style="animation-delay: 0.3s;"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Audio player for TTS *@
    @if (isPlayingAudio)
    {
        <div class="card card-ss p-2 mb-2 flex-shrink-0">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-ss-secondary" @onclick="StopAudioAsync"><i class="bi bi-stop-fill me-1"></i> @Localize["Conversation_Stop"]</button>
                <span class="ss-caption1 text-secondary-ss">@Localize["Conversation_PlayingAudio"]</span>
            </div>
        </div>
    }

    @* Input area — anchored to bottom *@
    <div class="card card-ss p-3 flex-shrink-0 mt-auto" style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px)) !important;">
        @if (IsVoiceOn)
        {
            <div class="d-flex align-items-center gap-3" data-testid="voice-panel" role="status" aria-live="polite">
                @if (voiceState == VoiceState.Connecting)
                {
                    <div class="spinner-border spinner-border-sm text-primary" role="presentation"></div>
                }
                else
                {
                    <i class="bi @(voiceState == VoiceState.PartnerSpeaking ? "bi-volume-up-fill" : "bi-mic-fill") fs-4 text-primary"></i>
                }
                <div class="flex-grow-1">
                    <div class="ss-body1" data-testid="voice-status">@VoiceStatusText</div>
                    <div class="progress mt-1" style="height: 4px;" aria-hidden="true">
                        <div class="progress-bar" style="width: @(voiceState == VoiceState.Listening ? Math.Min(100, (int)(micLevel * 400)) : 0)%;"></div>
                    </div>
                </div>
                <button class="btn btn-ss-secondary text-nowrap" @onclick="ToggleVoice" data-testid="voice-stop">
                    <i class="bi bi-stop-fill me-1"></i>@Localize["Conversation_VoiceEnd"]
                </button>
            </div>
        }
        else
        {
        @if (showQuickPhrases)
        {
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (var phrase in quickPhrases)
                {
                    var p = phrase;
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => UseQuickPhrase(p)">@p</button>
                }
            </div>
        }
        <div class="d-flex gap-2">
            <input type="text" class="form-control form-control-ss"
                   value="@userInput"
                   @oninput="OnInput"
                   @onkeydown="HandleKeyDown"
                   placeholder='@Localize["Conversation_TypeMessage"]'
                   disabled="@isWaitingForReply" />
            <button class="btn btn-ss-secondary btn-sm px-2" @onclick="ToggleQuickPhrases"
                    title='@Localize["NativeConversation_QuickPhrases"]' aria-label='@Localize["NativeConversation_QuickPhrases"]' disabled="@isWaitingForReply">
                <i class="bi bi-chat-quote"></i>
            </button>
            @if (voiceAvailable)
            {
                <button class="btn btn-ss-secondary btn-sm px-2 text-nowrap" @onclick="ToggleVoice"
                        title='@Localize["Conversation_VoiceStart"]' aria-label='@Localize["Conversation_VoiceStart"]'
                        disabled="@isWaitingForReply" data-testid="voice-start">
                    <i class="bi bi-mic"></i><span class="d-none d-md-inline ms-1">@Localize["Conversation_Voice"]</span>
                </button>
            }
            <button class="btn btn-ss-primary px-4 text-nowrap" @onclick="SendMessage"
                    disabled="@(isWaitingForReply || string.IsNullOrWhiteSpace(userInput))">
                @Localize["Conversation_Send"]
            </button>
        </div>
        }
    </div>
}
</div>

@code {
    [SupplyParameterFromQuery(Name = "scenarioId")]
    public string? ScenarioIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "fromPlan")]
    public bool FromPlanParam { get; set; }

    [SupplyParameterFromQuery(Name = "targetMinutes")]
    public int? TargetMinutesParam { get; set; }

    [SupplyParameterFromQuery(Name = "planItemId")]
    public string? PlanItemId { get; set; }

    [SupplyParameterFromQuery(Name = "resourceId")]
    public string? ResourceIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "skillId")]
    public string? SkillIdParam { get; set; }

    [Inject] private ConversationService ConversationSvc { get; set; } = default!;
    [Inject] private IScenarioService ScenarioSvc { get; set; } = default!;
    [Inject] private ElevenLabsSpeechService SpeechService { get; set; } = default!;
    [Inject] private SpeechVoicePreferences VoicePrefs { get; set; } = default!;
    [Inject] private UserProfileRepository ProfileRepo { get; set; } = default!;
    [Inject] private LearningResourceRepository ResourceRepo { get; set; } = default!;
    [Inject] private VocabularyProgressService ProgressService { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IFileSystemService FileSystemService { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IPreferencesService Preferences { get; set; } = default!;
    [Inject] private IAudioPlayerFactory AudioPlayerFactory { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ILogger<Conversation> Logger { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.IProgressService PlanProgressService { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.ProgressCacheService CacheService { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Timer.IActivityTimerService ActivityTimer { get; set; } = default!;
    private SentenceStudio.Services.Timer.ActivityTimerLease? activityTimerLease;

    private bool isBusy;
    private bool isWaitingForReply;
    // The learner the page was opened for. Words are scored only for this owner, and only while
    // it is still the active profile (fail closed).
    private string _owner = string.Empty;
    // Bumped by every new conversation (scenario or language change), so an opening line or a
    // reply that was in flight never lands in the next conversation.
    private long _conversationGeneration;
    private bool isPlayingAudio;
    private bool showQuickPhrases;
    private bool fromPlan;
    private int targetMinutes;
    private string userInput = "";
    private string targetLanguage = "Korean";
    private string voiceId = "";

    private List<ConversationChunk> chunks = new();
    private List<ConversationScenario> scenarios = new();
    private List<VocabularyWord> userVocabulary = new();
    private ConversationScenario? activeScenario;
    private readonly UiAudioPlayerSession _nativeAudio = new();
    private DotNetObjectReference<Conversation>? _audioJsRef;
    private CancellationTokenSource? _audioRequestCts;
    private long _audioGeneration;
    private bool _browserAudioLoaded;
    private bool _disposed;
    private ElementReference chatContainer;

    // Helper phrases in Korean (target language)
    private static readonly string[] quickPhrases = new[]
    {
        "이게 뭐예요?",         // What is this?
        "더 자세히 설명해 주세요.", // Can you explain in more detail?
        "이해해요.",             // I understand.
        "다시 말해 주세요.",      // Please say that again.
        "조금만 할 수 있어요.",   // I only speak a little.
        "도와줘서 감사합니다.",    // Thank you for helping.
        "천천히 말해 주세요.",    // Please speak slower.
        "그게 무슨 뜻이에요?",   // What does that mean?
    };

    private void ToggleQuickPhrases() => showQuickPhrases = !showQuickPhrases;

    private void UseQuickPhrase(string phrase)
    {
        userInput = phrase;
        showQuickPhrases = false;
    }

    protected override async Task OnInitializedAsync()
    {
        Localize.CultureChanged += OnCultureChanged;
        InitializeVoice();
        Logger.LogInformation("🎯 Conversation initialized — planItemId={PlanItemId}, resourceId={ResourceId}, skillId={SkillId}",
            PlanItemId ?? "(none)", ResourceIdParam ?? "(none)", SkillIdParam ?? "(none)");
        activityTimerLease = ActivityTimer.StartSession("Conversation", PlanItemId, ResourceIdParam, SkillIdParam);
        fromPlan = FromPlanParam;
        targetMinutes = TargetMinutesParam ?? 15;

        _owner = Preferences.Get("active_profile_id", string.Empty);
        if (string.IsNullOrWhiteSpace(_owner))
        {
            Logger.LogWarning("Activity {ActivityName} opened without an active profile; nothing is loaded.", nameof(Conversation));
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        try
        {
            var profile = await ProfileRepo.GetByIdAsync(_owner);
            targetLanguage = profile?.TargetLanguage ?? "Korean";
            voiceId = VoicePrefs.GetVoiceForLanguage(targetLanguage);

            scenarios = await ScenarioSvc.GetAllScenariosAsync() ?? new();

            if (!string.IsNullOrWhiteSpace(ScenarioIdParam))
                activeScenario = scenarios.FirstOrDefault(s => s.Id == ScenarioIdParam);

            // When launched from plan with ResourceId but no scenarioId, use default scenario.
            // ResourceId/SkillId are accepted for future resource-aware scenario matching.
            activeScenario ??= scenarios.FirstOrDefault();

            userVocabulary = await ResourceRepo.GetAllVocabularyWordsWithResourcesAsync(_owner) ?? new();

            await StartConversation();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize conversation");
            Toast.ShowError(Localize["NativeConversation_LoadFailed"]);
        }
        finally
        {
            // Voice waits for the persona, scenarios, and vocabulary it depends on.
            conversationReady = true;
        }
    }

    private async Task ChangeLanguage(string language)
    {
        if (language == targetLanguage) return;
        targetLanguage = language;
        voiceId = VoicePrefs.GetVoiceForLanguage(targetLanguage);
        await StartConversation();
    }

    private async Task StartConversation()
    {
        if (IsVoiceOn)
        {
            await StopVoiceAsync();
        }

        await StopAudioAsync();
        if (_disposed) return;

        var generation = ++_conversationGeneration;
        isBusy = true;
        try
        {
            chunks.Clear();
            var scenario = activeScenario;
            var opening = await StartConversationOpeningAsync(scenario, targetLanguage);
            if (_disposed || generation != _conversationGeneration)
                return;
            if (string.IsNullOrWhiteSpace(opening))
            {
                // No opening line is a failure the learner is told about, not an empty chat.
                Logger.LogWarning("Conversation opening line was empty.");
                Toast.ShowError(Localize["NativeConversation_StartFailed"]);
                return;
            }
            chunks.Add(new ConversationChunk
            {
                Text = opening,
                Author = scenario?.PersonaName ?? "AI",
                Role = ConversationRole.Assistant,
                SentTime = DateTime.UtcNow
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start conversation");
            if (!_disposed && generation == _conversationGeneration)
                Toast.ShowError(Localize["NativeConversation_StartFailed"]);
        }
        finally
        {
            if (generation == _conversationGeneration)
                isBusy = false;
        }
    }

    /// <summary>
    /// A message that got no reply leaves the transcript (it was never saved) and goes back in
    /// the input box, so sending again sends it once; text typed meanwhile is kept.
    /// </summary>
    private void ReturnUnansweredMessage(ConversationChunk userChunk, string message)
    {
        chunks.Remove(userChunk);
        if (string.IsNullOrWhiteSpace(userInput))
            userInput = message;
    }

    private Task<string> StartConversationOpeningAsync(
        ConversationScenario? scenario, string language) =>
        ConversationSvc.StartConversation(scenario, language);

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isWaitingForReply) return;

        var owner = _owner;
        if (!OwnerStillActive())
        {
            Logger.LogWarning("Conversation message refused: the active profile changed or is absent.");
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        var message = userInput.Trim();
        userInput = "";

        var userChunk = new ConversationChunk
        {
            Text = message,
            Author = "Me",
            Role = ConversationRole.User,
            SentTime = DateTime.UtcNow
        };
        chunks.Add(userChunk);
        var scenario = activeScenario;
        var generation = _conversationGeneration;
        isWaitingForReply = true;
        StateHasChanged();

        try
        {
            Reply? reply;
            try
            {
                reply = await ConversationSvc.ContinueConversation(chunks.ToList(), scenario, targetLanguage);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to get reply");
                if (!_disposed && generation == _conversationGeneration)
                {
                    ReturnUnansweredMessage(userChunk, message);
                    Toast.ShowError(Localize["NativeConversation_ReplyFailed"]);
                }
                return;
            }

            // A reply to a conversation the learner has left lands nowhere.
            if (_disposed || generation != _conversationGeneration)
                return;

            if (string.IsNullOrWhiteSpace(reply?.Message))
            {
                // No reply is a failure the learner is told about, not an empty bubble.
                Logger.LogWarning("Conversation reply was empty.");
                ReturnUnansweredMessage(userChunk, message);
                Toast.ShowError(Localize["NativeConversation_ReplyFailed"]);
                return;
            }

            // Apply grammar corrections to user chunk
            if (reply.GrammarCorrections?.Any() == true)
            {
                userChunk.GrammarCorrections = reply.GrammarCorrections;
            }
            userChunk.Comprehension = Reply.NormalizeComprehension(reply.Comprehension);

            chunks.Add(new ConversationChunk
            {
                Text = reply.Message,
                Author = scenario?.PersonaName ?? "AI",
                Role = ConversationRole.Assistant,
                SentTime = DateTime.UtcNow
            });

            // Record vocabulary progress via shared extraction pipeline (softer penalty for chat),
            // for the owner's words only.
            if (userVocabulary.Count > 0 && OwnerStillActive())
            {
                try
                {
                    await ProgressService.ExtractAndScoreVocabularyAsync(
                        reply.VocabularyAnalysis, userVocabulary, owner,
                        activity: "Conversation", difficultyWeight: 1.2f,
                        penaltyOverride: 0.8f);
                    CacheService.InvalidateVocabSummary();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Conversation could not score vocabulary for a reply.");
                    Toast.ShowError(Localize["NativeCommon_SaveFailed"]);
                }
            }
        }
        finally
        {
            isWaitingForReply = false;
        }
    }

    private bool OwnerStillActive() =>
        !string.IsNullOrWhiteSpace(_owner)
        && string.Equals(_owner, Preferences.Get("active_profile_id", string.Empty), StringComparison.Ordinal);

    private async Task PlayChunkAudio(ConversationChunk chunk)
    {
        if (string.IsNullOrEmpty(chunk.Text) || _disposed) return;

        CancellationTokenSource? request = null;
        long generation = 0;
        try
        {
            // StopAudioAsync invalidates synchronously before JS can yield.
            var stopTask = StopAudioAsync();
            generation = _audioGeneration;
            await stopTask;
            if (_disposed || generation != _audioGeneration) return;

            request = new CancellationTokenSource();
            _audioRequestCts = request;
            var cancellationToken = request.Token;
            isPlayingAudio = true;
            StateHasChanged();

            var vid = !string.IsNullOrEmpty(voiceId) ? voiceId : "echo";
            using var stream = await SpeechService.TextToSpeechAsync(chunk.Text, vid);
            if (!IsCurrentAudioRequest(request, generation)) return;

            var cacheDir = Path.Combine(FileSystemService.AppDataDirectory, "Cache");
            Directory.CreateDirectory(cacheDir);
            var tempPath = Path.Combine(cacheDir, $"conv_{Guid.NewGuid():N}.mp3");
            using (var fs = File.Create(tempPath))
            {
                await stream.CopyToAsync(fs);
            }
            if (!IsCurrentAudioRequest(request, generation)) return;

            if (AudioPlayerFactory.CanPlayLocally)
            {
                var player = _nativeAudio.CreatePlayer(AudioPlayerFactory, File.OpenRead(tempPath));
                player.PlaybackEnded += (s, e) =>
                {
                    if (!IsCurrentAudioRequest(request, generation)) return;
                    isPlayingAudio = false;
                    _ = InvokeAsync(StateHasChanged);
                };
                player.Play();
            }
            else
            {
                var audioData = await File.ReadAllBytesAsync(tempPath, cancellationToken);
                if (!IsCurrentAudioRequest(request, generation)) return;

                _audioJsRef ??= DotNetObjectReference.Create(this);
                _browserAudioLoaded = true;
                await BrowserAudioPlayback.PlayAndTrackAsync(JS, audioData, _audioJsRef, cancellationToken, Logger);
            }
        }
        catch (OperationCanceledException) when (!IsCurrentAudioRequest(request, generation))
        {
        }
        catch (Exception ex)
        {
            if (request is not null && !IsCurrentAudioRequest(request, generation)) return;
            await HandleAudioPlaybackErrorAsync(ex);
        }
    }

    private async Task HandleAudioPlaybackErrorAsync(Exception playbackError)
    {
        Logger.LogError(playbackError, "Failed to play audio");
        try
        {
            await StopAudioAsync();
        }
        catch (Exception cleanupError)
        {
            Logger.LogWarning(cleanupError, "Could not stop conversation audio after playback failed");
            isPlayingAudio = false;
        }
        if (!_disposed)
            Toast.ShowError(Localize["NativeConversation_AudioFailed"]);
    }

    private bool IsCurrentAudioRequest(CancellationTokenSource? request, long generation) =>
        request is not null && !_disposed && generation == _audioGeneration
            && ReferenceEquals(_audioRequestCts, request)
            && !request.IsCancellationRequested;

    [JSInvokable]
    public void OnJsTimeUpdate(double _)
    {
        // The browser helper emits position updates; this page only needs its end callback.
    }

    [JSInvokable]
    public void OnJsPlaybackEnded()
    {
        if (_disposed || !_browserAudioLoaded) return;
        isPlayingAudio = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnScenarioChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } id)
        {
            activeScenario = scenarios.FirstOrDefault(s => s.Id == id);
            await StartConversation();
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        userInput = e.Value?.ToString() ?? "";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private async Task StopAudioAsync()
    {
        _audioGeneration++;
        var request = _audioRequestCts;
        _audioRequestCts = null;
        request?.Cancel();
        request?.Dispose();
        _nativeAudio.Stop();
        isPlayingAudio = false;
        if (_browserAudioLoaded)
        {
            _browserAudioLoaded = false;
            try
            {
                await JS.InvokeVoidAsync("audioInterop.stop");
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogWarning(ex, "Conversation browser audio stop was not confirmed: JS circuit disconnected");
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Conversation browser audio stop was not confirmed");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        try
        {
            await DisposeVoiceAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to stop voice mode during disposal");
        }
        try
        {
            Localize.CultureChanged -= OnCultureChanged;
        }
        finally
        {
            try
            {
                ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
            }
            finally
            {
                _audioGeneration++;
                var request = _audioRequestCts;
                _audioRequestCts = null;
                try
                {
                    request?.Cancel();
                }
                finally
                {
                    try
                    {
                        request?.Dispose();
                    }
                    finally
                    {
                        try
                        {
                            _nativeAudio.Dispose();
                        }
                        finally
                        {
                            isPlayingAudio = false;
                            try
                            {
                                if (_browserAudioLoaded)
                                {
                                    _browserAudioLoaded = false;
                                    try
                                    {
                                        await JS.InvokeVoidAsync("audioInterop.stop");
                                    }
                                    catch (Exception ex)
                                    {
                                        Logger.LogWarning(ex, "Failed to stop conversation browser audio during disposal");
                                    }
                                }
                            }
                            finally
                            {
                                _audioJsRef?.Dispose();
                                _audioJsRef = null;
                            }
                        }
                    }
                }
            }
        }
    }

    private async Task GoBack()
    {
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
        await StopVoiceAsync();
        NavManager.NavigateTo("/");
    }
}
