@page "/writing"
@attribute [Authorize]
@using SentenceStudio.Shared.Services
@inject SentenceStudio.WebUI.Services.BlazorLocalizationService Localize
@implements IAsyncDisposable

<div class="activity-page-wrapper">

<PageHeader Title='@Localize["Activity_Writing"]' ShowBack="true" OnBack="GoBack" />

<div class="activity-content">
@if (showSessionSummary)
{
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
        <h2 class="ss-title1 mb-4"><i class="bi bi-journal-check me-2"></i>@Localize["Common_SessionComplete"]</h2>
        <div class="card card-ss p-4" style="min-width: 340px;">
            <div class="d-flex justify-content-around mb-3">
                <div class="text-center">
                    <div class="ss-title2 text-success">@sessionGradedCount</div>
                    <small class="text-secondary-ss">@Localize["Common_Graded"]</small>
                </div>
                <div class="text-center">
                    <div class="ss-title2" style="color: var(--bs-primary);">
                        @(sessionGradedCount > 0 ? (int)(sessionAccuracySum / sessionGradedCount) : 0)%
                    </div>
                    <small class="text-secondary-ss">@Localize["Common_AvgAccuracy"]</small>
                </div>
                <div class="text-center">
                    <div class="ss-title2" style="color: var(--bs-info);">
                        @(sessionGradedCount > 0 ? (int)(sessionFluencySum / sessionGradedCount) : 0)%
                    </div>
                    <small class="text-secondary-ss">@Localize["Common_AvgFluency"]</small>
                </div>
            </div>
        </div>
        <button class="btn btn-ss-primary mt-4" @onclick="ContinueAfterSummary" disabled="@isGrading">@Localize["Common_ContinuePractice"]</button>
        <button class="btn btn-ss-secondary mt-2" @onclick="GoBack">@Localize["Common_Done"]</button>
    </div>
}
else if (isBusy)
{
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 40vh;">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="ss-body1 text-secondary-ss">@Localize["Writing_LoadingVocab"]</p>
    </div>
}
else if (vocabBlocks.Any())
{
    @* Previous sentences *@
    @if (sentences.Any())
    {
        <div class="mb-4">
            @foreach (var sentence in sentences)
            {
                <div class="card card-ss p-3 mb-2">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <p class="ss-body1 mb-1">@sentence.Answer</p>
                            @if (!string.IsNullOrEmpty(sentence.RecommendedSentence))
                            {
                                <small class="text-secondary-ss d-block">
                                    <strong>@Localize["Common_Suggested"]</strong> @sentence.RecommendedSentence
                                </small>
                            }
                        </div>
                        <div class="d-flex gap-3 ms-3 text-nowrap">
                            @if (sentence.Accuracy > 0)
                            {
                                <div class="text-center">
                                    <div class="ss-body2" style="color: @GetScoreColor(sentence.Accuracy);">@((int)sentence.Accuracy)%</div>
                                    <small class="text-secondary-ss">@Localize["Common_Accuracy"]</small>
                                </div>
                            }
                            @if (sentence.Fluency > 0)
                            {
                                <div class="text-center">
                                    <div class="ss-body2" style="color: @GetScoreColor(sentence.Fluency);">@((int)sentence.Fluency)%</div>
                                    <small class="text-secondary-ss">@Localize["Writing_Fluency"]</small>
                                </div>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(sentence.GrammarNotes))
                    {
                        <details class="mt-2">
                            <summary class="ss-caption1 text-secondary-ss" style="cursor: pointer;">@Localize["Writing_ShowDetails"]</summary>
                            <div class="mt-1">
                                @if (!string.IsNullOrEmpty(sentence.AccuracyExplanation))
                                {
                                    <small class="d-block text-secondary-ss"><strong>@Localize["Common_Accuracy"]:</strong> @sentence.AccuracyExplanation</small>
                                }
                                @if (!string.IsNullOrEmpty(sentence.FluencyExplanation))
                                {
                                    <small class="d-block text-secondary-ss"><strong>@Localize["Writing_Fluency"]:</strong> @sentence.FluencyExplanation</small>
                                }
                                @if (!string.IsNullOrEmpty(sentence.GrammarNotes))
                                {
                                    <small class="d-block text-secondary-ss"><strong>@Localize["Writing_Notes"]</strong> @sentence.GrammarNotes</small>
                                }
                            </div>
                        </details>
                    }
                </div>
            }
        </div>
    }

    @* Vocabulary blocks *@
    <div class="mb-3">
        <p class="ss-body2 text-secondary-ss mb-2">@Localize["Writing_ChooseVocab"]</p>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var word in vocabBlocks)
            {
                var w = word;
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => UseVocab(w.TargetLanguageTerm)">
                    @w.TargetLanguageTerm
                </button>
            }
            <button class="btn btn-sm btn-ss-secondary" @onclick="ShuffleVocab"
                    title='@Localize["Writing_Shuffle"]' aria-label='@Localize["Writing_Shuffle"]'>
                <i class="bi bi-shuffle"></i>
            </button>
        </div>
    </div>
}
else
{
    <div class="text-center p-5">
        <p class="ss-body1 text-secondary-ss">@Localize["Writing_NoVocab"]</p>
        <button class="btn btn-ss-secondary mt-3" @onclick="GoBack">@Localize["Common_GoBack"]</button>
    </div>
}
</div>

@if (vocabBlocks.Any() && !showSessionSummary && !isBusy)
{
<div class="activity-input-bar">
    <form @onsubmit="SubmitInput" @onsubmit:preventDefault class="d-flex gap-2 mb-2">
        <input type="text" class="form-control form-control-ss form-control-lg flex-grow-1"
               @bind="userInput"
               placeholder='@Localize["Writing_WriteSentence"]' />
        <button type="button" class="btn btn-ss-secondary" @onclick="TranslateInput"
                disabled="@(isTranslating || string.IsNullOrWhiteSpace(userInput))"
                title='@Localize["Writing_Translate"]' aria-label='@Localize["Writing_Translate"]'>
            <i class="bi bi-translate"></i>
        </button>
        <button type="submit" class="btn btn-ss-primary"
                disabled="@(isGrading || string.IsNullOrWhiteSpace(userInput))">
            @if (isGrading)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <i class="bi bi-send d-md-none"></i>
                <span class="d-none d-md-inline">@Localize["Writing_Grade"]</span>
            }
        </button>
    </form>

    <div class="d-flex justify-content-between align-items-center">
        <span class="ss-body2 text-secondary-ss">@string.Format(Localize["Writing_SentencesWritten"], sentences.Count)</span>
        @if (sentences.Count >= 3)
        {
            <button class="btn btn-sm btn-ss-secondary" @onclick="ShowSummary">@Localize["Writing_EndSession"]</button>
        }
    </div>
</div>
}

</div>

@code {
    [SupplyParameterFromQuery(Name = "resourceId")]
    public string? ResourceIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "skillId")]
    public string? SkillIdParam { get; set; }

    [SupplyParameterFromQuery(Name = "planItemId")]
    public string? PlanItemId { get; set; }

    [SupplyParameterFromQuery(Name = "FocusVocabularyIds")]
    public string? FocusVocabularyIdsParam { get; set; }

    [Inject] private TeacherService TeacherSvc { get; set; } = default!;
    [Inject] private TranslationService TranslationSvc { get; set; } = default!;
    [Inject] private VocabularyLookupRepository LookupRepo { get; set; } = default!;
    [Inject] private LearningResourceRepository ResourceRepo { get; set; } = default!;
    [Inject] private UserActivityRepository ActivityRepo { get; set; } = default!;
    [Inject] private VocabularyProgressService ProgressService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private ToastService Toast { get; set; } = default!;
    [Inject] private ILogger<Writing> Logger { get; set; } = default!;
    [Inject] private SentenceStudio.Abstractions.IPreferencesService Preferences { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.ProgressCacheService CacheService { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Progress.IProgressService PlanProgressService { get; set; } = default!;
    [Inject] private SentenceStudio.Services.Timer.IActivityTimerService ActivityTimer { get; set; } = default!;
    private SentenceStudio.Services.Timer.ActivityTimerLease? activityTimerLease;

    private bool isBusy;
    private bool isGrading;
    private bool isTranslating;
    private bool showSessionSummary;
    // The learner the session was loaded for. Grades and translations are recorded
    // only for this owner, and only while it is still the active profile (fail closed).
    private string _owner = string.Empty;
    // Bumped by Continue practice and by leaving the page, so a grade or translation
    // that was in flight lands nowhere and records nothing.
    private long _generation;
    private bool _leaving;
    private string userInput = "";
    private int sessionGradedCount;
    private double sessionAccuracySum;
    private double sessionFluencySum;

    private List<Sentence> sentences = new();
    private List<VocabularyWord> vocabBlocks = new();
    private List<VocabularyWord> allVocabulary = new();
    private bool usingFocusVocabularyIds;

    protected override async Task OnInitializedAsync()
    {
        Localize.CultureChanged += OnCultureChanged;
        Logger.LogInformation("Writing initialized — planItemId={PlanItemId}, resourceId={ResourceId}, skillId={SkillId}",
            PlanItemId ?? "(none)", ResourceIdParam ?? "(none)", SkillIdParam ?? "(none)");
        activityTimerLease = ActivityTimer.StartSession("Writing", PlanItemId, ResourceIdParam, SkillIdParam);

        await LoadVocabulary();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadVocabulary()
    {
        isBusy = true;
        try
        {
            _owner = Preferences.Get("active_profile_id", string.Empty);
            if (string.IsNullOrWhiteSpace(_owner))
            {
                Logger.LogWarning("Activity {ActivityName} opened without an active profile; no vocabulary is loaded.", nameof(Writing));
                allVocabulary = new();
                vocabBlocks = new();
                Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
                return;
            }

            var focusVocabularyIds = FocusVocabularySelection.ParseFocusVocabularyIds(FocusVocabularyIdsParam);
            usingFocusVocabularyIds = focusVocabularyIds.Count > 0;
            var resourceId = ResourceIdParam ?? "";

            if (usingFocusVocabularyIds)
            {
                var userVocabulary = await ResourceRepo.GetAllVocabularyWordsWithResourcesAsync(_owner);
                var selected = FocusVocabularySelection.SelectFocusWords(userVocabulary, focusVocabularyIds);
                allVocabulary = FilterToWordsOnly(selected);
                if (allVocabulary.Any())
                {
                    ShuffleVocab();
                    return;
                }

                Logger.LogWarning("Activity {ActivityName} received FocusVocabularyIds but no Word-type vocabulary was found after filter (planItemId={PlanItemId}, selected={SelectedCount}); falling back to legacy selection", nameof(Writing), PlanItemId, selected.Count);
                usingFocusVocabularyIds = false;
            }
            else
            {
                Logger.LogWarning("Activity {ActivityName} launched without FocusVocabularyIds (planItemId={PlanItemId}); falling back to legacy selection", nameof(Writing), PlanItemId);
            }

            if (!string.IsNullOrEmpty(resourceId))
            {
                var resource = await ResourceRepo.GetResourceAsync(resourceId, _owner);
                if (resource?.Vocabulary?.Any() == true)
                {
                    var wordIds = resource.Vocabulary.Select(w => w.Id).ToList();
                    var progressDict = await ProgressService.GetProgressForWordsAsync(wordIds, _owner);
                    var usable = resource.Vocabulary
                        .Where(FocusVocabularySelection.IsUsableVocabularyWord)
                        .Where(w => !progressDict.ContainsKey(w.Id) || !progressDict[w.Id].IsInGracePeriod)
                        .ToList();
                    allVocabulary = FilterToWordsOnly(usable);
                    if (!allVocabulary.Any() && usable.Any())
                    {
                        Logger.LogWarning("Writing activity filtered out all {Count} entries for resource {ResourceId} (no LexicalUnitType.Word entries; resource may contain only phrases/sentences/unclassified)", usable.Count, resourceId);
                    }
                    ShuffleVocab();
                }
                else
                {
                    Toast.ShowWarning(Localize["Writing_NoResourceVocab"]);
                }
            }
            else
            {
                Toast.ShowWarning(Localize["Writing_SelectResource"]);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading vocabulary");
            Toast.ShowError(Localize["Writing_LoadFailed"]);
        }
        finally
        {
            isBusy = false;
        }
    }

    // Writing activity practices producing original sentences — phrases and full sentences
    // from the user's vocabulary aren't appropriate building blocks here. Filter to Word-type
    // entries only. (Per Captain directive, June 2026 — "Filter to Word for now".)
    // See WritingActivityVocabularyFilter for the canonical implementation + tests.
    private static List<VocabularyWord> FilterToWordsOnly(IEnumerable<VocabularyWord> source) =>
        WritingActivityVocabularyFilter.FilterToWordsOnly(source);

    private void ShuffleVocab()
    {
        vocabBlocks = usingFocusVocabularyIds
            ? allVocabulary.Take(4).ToList()
            : allVocabulary
                .OrderBy(_ => Random.Shared.Next())
                .Take(4)
                .ToList();
    }

    private void UseVocab(string word)
    {
        userInput = string.IsNullOrEmpty(userInput) ? word : $"{userInput} {word}";
    }

    private async Task SubmitInput()
    {
        await GradeMe();
    }

    private async Task GradeMe()
    {
        // The field stays enabled while grading, so Enter can submit again: one grade at a time.
        if (isGrading || string.IsNullOrWhiteSpace(userInput)) return;

        var owner = _owner;
        if (!OwnerStillActive())
        {
            Logger.LogWarning("Writing grade refused: the active profile changed or is absent.");
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        // The grade belongs to the sentence that was submitted, not to whatever is typed
        // while it is in flight.
        var submitted = userInput;
        var generation = _generation;
        isGrading = true;
        StateHasChanged();

        try
        {
            GradeResponse? grade;
            try
            {
                grade = await TeacherSvc.GradeSentence(submitted, "");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error grading sentence");
                if (!IsSuperseded(generation, owner))
                    Toast.ShowError(Localize["Writing_GradeFailed"]);
                return;
            }

            // Leaving the page, Continue practice, or a profile change while the grade was
            // in flight supersedes it: the late result is not shown and nothing is recorded.
            if (IsSuperseded(generation, owner))
            {
                Logger.LogInformation("Writing grade discarded: superseded while it was in flight.");
                return;
            }

            if (grade == null)
            {
                Toast.ShowError(Localize["Writing_GradeFailed"]);
                return;
            }

            var sentence = new Sentence
            {
                Answer = submitted,
                Accuracy = grade.Accuracy,
                Fluency = grade.Fluency,
                FluencyExplanation = grade.FluencyExplanation,
                AccuracyExplanation = grade.AccuracyExplanation,
                RecommendedSentence = grade.GrammarNotes?.RecommendedTranslation,
                GrammarNotes = grade.GrammarNotes?.Explanation
            };

            sentences.Add(sentence);

            sessionGradedCount++;
            sessionAccuracySum += grade.Accuracy;
            sessionFluencySum += grade.Fluency;

            var saveFailed = false;

            // Record activity
            var saved = await ActivityRepo.SaveAsync(new UserActivity
            {
                Activity = SentenceStudio.Shared.Models.Activity.Writer.ToString(),
                Input = submitted,
                Accuracy = grade.Accuracy,
                Fluency = grade.Fluency,
                UserProfileId = owner,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            });
            if (saved < 0)
            {
                Logger.LogError("Writing could not save its UserActivity row.");
                saveFailed = true;
            }

            // Record vocabulary progress via shared extraction pipeline
            if (OwnerStillActive())
            {
                try
                {
                    var scoringResults = await ProgressService.ExtractAndScoreVocabularyAsync(
                        grade.VocabularyAnalysis, allVocabulary, owner,
                        activity: "Writing", difficultyWeight: 1.5f);

                    // Show verification probe feedback to user
                    foreach (var result in scoringResults)
                    {
                        if (result.UpdatedProgress.IsFamiliar)
                        {
                            if (result.WasCorrect)
                                Toast.ShowSuccess(Localize["Writing_ProbeConfirmed"]);
                            else
                                Toast.ShowInfo(Localize["Writing_ProbeTricky"]);
                        }
                    }

                    CacheService.InvalidateVocabSummary();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Writing could not score vocabulary for a graded sentence.");
                    saveFailed = true;
                }
            }

            if (saveFailed)
                Toast.ShowError(Localize["NativeCommon_SaveFailed"]);

            // Source behavior: the field is cleared after every grade.
            userInput = "";
            ShuffleVocab();
            Toast.ShowSuccess(Localize.Get("Writing_GradedAccuracy", (int)grade.Accuracy));
        }
        finally
        {
            isGrading = false;
        }
    }

    private async Task TranslateInput()
    {
        if (isTranslating || string.IsNullOrWhiteSpace(userInput)) return;

        var owner = _owner;
        if (!OwnerStillActive())
        {
            Logger.LogWarning("Writing translate refused: the active profile changed or is absent.");
            Toast.ShowError(Localize["Vocabulary_NoActiveProfile"]);
            return;
        }

        var generation = _generation;
        var text = userInput;
        LookupTranslation? lookup = null;
        isTranslating = true;
        try
        {
            // Reads the owner's vocabulary or asks the AI; it is not saved as a word.
            lookup = await TranslationSvc.TranslateLookupAsync(text, userProfileId: owner);
            if (IsSuperseded(generation, owner))
                return;
            if (lookup is null)
                Toast.ShowError(Localize["Writing_TranslateFailed"]);
            else
                Toast.ShowInfo(lookup.Translation);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error translating");
            if (!IsSuperseded(generation, owner))
                Toast.ShowError(Localize["Writing_TranslateFailed"]);
        }
        finally
        {
            isTranslating = false;
            // A successful translation joins the lookup history (decision 4 B), after it is shown,
            // even when Continue practice moved on; never after leaving or for another profile.
            if (lookup is not null && !_leaving && OwnerStillActive()
                && string.Equals(owner, _owner, StringComparison.Ordinal))
            {
                StateHasChanged();
                await RecordLookupAsync(owner, text, lookup);
            }
        }
    }

    private async Task RecordLookupAsync(string owner, string text, LookupTranslation lookup)
    {
        try
        {
            var status = await LookupRepo.RecordAsync(owner, new VocabularyLookupEntry(
                text, lookup.Translation, lookup.Direction, VocabularyLookupActivity.Writing,
                ResourceIdParam));
            if (status != VocabularyLookupRecordStatus.Recorded)
                Logger.LogWarning("Writing did not record a lookup: {Status}", status);
        }
        catch (Exception ex)
        {
            // The learner already has the translation; only the history entry is missing.
            Logger.LogError(ex, "Writing could not record a lookup");
        }
    }

    private bool OwnerStillActive() =>
        !string.IsNullOrWhiteSpace(_owner)
        && string.Equals(_owner, Preferences.Get("active_profile_id", string.Empty), StringComparison.Ordinal);

    private bool IsSuperseded(long generation, string owner) =>
        _leaving || generation != _generation
        || !string.Equals(owner, _owner, StringComparison.Ordinal) || !OwnerStillActive();

    private void ShowSummary()
    {
        showSessionSummary = true;
    }

    private async Task ContinueAfterSummary()
    {
        // Wait for an in-flight grade, so it counts in the session it was submitted in.
        if (isGrading) return;
        _generation++;
        showSessionSummary = false;
        sessionGradedCount = 0;
        sessionAccuracySum = 0;
        sessionFluencySum = 0;
        sentences.Clear();
        await LoadVocabulary();
    }

    private string GetScoreColor(double score) => score switch
    {
        >= 80 => "var(--bs-success)",
        >= 50 => "var(--bs-warning)",
        _ => "var(--bs-danger)"
    };

    private void GoBack()
    {
        _leaving = true;
        _generation++;
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
        NavManager.NavigateTo("/");
    }

    public ValueTask DisposeAsync()
    {
        _leaving = true;
        _generation++;
        Localize.CultureChanged -= OnCultureChanged;
        ActivityTimer.PauseAndStopOwnedSession(activityTimerLease);
        return ValueTask.CompletedTask;
    }
}
