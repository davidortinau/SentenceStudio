@page "/admin"
@using SentenceStudio.WebApp.Admin
@using SentenceStudio.WebApp.Components.Admin
@using SentenceStudio.WebUI.Shared
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AdminApiClient Api
@inject AdminSessionState State

@*
    The admin portal's front page. Web app only, English only (docs/admin-portal-plan.md).
    AdminGate draws what is below it only after the API has answered LoadAsync for an admin.
*@

<AdminGate @ref="_gate" Load="LoadAsync">
    <PageTitle>Admin</PageTitle>
    <PageHeader Title="Admin" />

    <div class="container-fluid" id="admin-home">
        @if (_session is null)
        {
            <div class="alert alert-warning d-flex align-items-center" role="alert" id="admin-home-unexpected">
                <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                <span class="flex-grow-1">The admin service did not answer as expected.</span>
                <button type="button" class="btn btn-sm btn-outline-primary ms-2" id="admin-home-retry" @onclick="RetryAsync">
                    Try again
                </button>
            </div>
        }
        else
        {
            <p class="text-secondary" id="admin-signed-in-as">
                Signed in as <strong>@(_session.Email ?? _session.DisplayName ?? _session.UserId)</strong>.
                Every request you make here is recorded in the audit log.
            </p>

            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="card" id="admin-feedback-card">
                        <div class="card-body">
                            <h2 class="h5 card-title">Feedback inbox</h2>
                            <p class="text-secondary">
                                The Sam answers learners flagged, for every learner, and the reports they
                                filed to GitHub. Opening a flagged question and answer asks for your password.
                            </p>
                            <p id="admin-feedback-card-count" role="status">
                                @(_newReports switch
                                {
                                    null => "The number of new flagged answers could not be read.",
                                    0 => "No new flagged answers.",
                                    1 => "1 new flagged answer.",
                                    var count => $"{count} new flagged answers."
                                })
                            </p>
                            <a id="admin-open-feedback" class="btn btn-outline-primary" href="/admin/feedback">
                                <i class="bi bi-inbox me-1" aria-hidden="true"></i>Open the feedback inbox
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <AdminPasswordCard OnNotAdmin="CloseGate" />
                </div>
                <div class="col-12 col-lg-6">
                    <div class="card" id="admin-audit-card">
                        <div class="card-body">
                            <h2 class="h5 card-title">Audit log</h2>
                            <p class="text-secondary">
                                Who did what, to which learner or report, when, and how it ended.
                                It holds no learner content.
                            </p>
                            <a id="admin-open-audit" class="btn btn-outline-primary" href="/admin/audit">
                                <i class="bi bi-journal-text me-1" aria-hidden="true"></i>Open the audit log
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="card" id="admin-sync-health-card">
                        <div class="card-body">
                            <h2 class="h5 card-title">Sync and data health</h2>
                            <p class="text-secondary">
                                Row counts per synced table for a learner, the devices the server has synced
                                with, and the deployed API version and database migration. Numbers only, no
                                learner content.
                            </p>
                            <a id="admin-open-sync-health" class="btn btn-outline-primary" href="/admin/sync-health">
                                <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Open sync health
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="card" id="admin-usage-card">
                        <div class="card-body">
                            <h2 class="h5 card-title">AI usage and jobs</h2>
                            <p class="text-secondary">
                                Sam runs, tokens and estimated cost per learner, YouTube imports that failed or
                                are stuck, and where the part-of-speech backfill stands. Counts and codes only.
                            </p>
                            <a id="admin-open-usage" class="btn btn-outline-primary" href="/admin/usage">
                                <i class="bi bi-cpu me-1" aria-hidden="true"></i>Open AI usage and jobs
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="card" id="admin-tokens-card">
                        <div class="card-body">
                            <h2 class="h5 card-title">Agent tokens</h2>
                            <p class="text-secondary">
                                What the maintenance agent signs in with to read the feedback inbox and set
                                a report's status and issue. A token can never use an account tool.
                            </p>
                            <a id="admin-open-tokens" class="btn btn-outline-primary" href="/admin/tokens">
                                <i class="bi bi-key me-1" aria-hidden="true"></i>Open agent tokens
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</AdminGate>

@code {
    private AdminGate? _gate;
    private AdminSession? _session;
    private int? _newReports;

    private async Task<AdminApiStatus> LoadAsync()
    {
        var result = await Api.GetSessionAsync(State.CurrentProof);
        if (result.IsOk)
        {
            _session = result.Value;

            // The API's word on the proof just sent is the one that counts.
            State.Reconcile(_session!.StepUpExpiresAtUtc);

            // The same number the sidebar shows. Not knowing it is said on the card, and does not
            // keep the page from opening.
            _newReports = await State.GetNewReportCountAsync();
        }
        else if (result.Status == AdminApiStatus.NotFound)
        {
            State.MarkNotAdmin();
        }

        return result.Status;
    }

    private void CloseGate() => _gate?.Close();

    // Through the gate, in this circuit: a reload would drop a confirmed password. A click that
    // arrives after the page has its answer asks nothing.
    private Task RetryAsync() => _session is null && _gate is { } gate ? gate.RetryAsync() : Task.CompletedTask;
}
