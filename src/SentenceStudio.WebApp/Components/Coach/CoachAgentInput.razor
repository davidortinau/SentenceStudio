@using Microsoft.AspNetCore.Components.AI
@implements IDisposable
@inject BlazorLocalizationService Localize
@inject CoachWorkspaceState Workspace

@if (Workspace.SessionId is not null || Workspace.ConversationId is not null)
{
    <fieldset disabled="@(!Workspace.CanSubmit)">
        <MessageInput @key="Context" Placeholder="@Localize["Coach_ComposerPlaceholder"]" />
    </fieldset>
}

@code {
    [CascadingParameter] public AgentContext Context { get; set; } = default!;
    private bool _disposed;

    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    private void OnChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    StateHasChanged();
                }
            });
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Workspace.Changed -= OnChanged;
    }
}
