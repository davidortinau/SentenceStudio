@using Microsoft.AspNetCore.Components.AI
@using SentenceStudio.WebApp.Coach
@implements IAsyncDisposable
@inject CoachWorkspaceState Workspace
@inject CoachWorkspaceChatClient ChatClient
@inject BlazorLocalizationService Localize

@* A replaceable context clears preview-library retry state without remounting the app shell. *@
<CascadingValue Value="_context">
    <CoachAgentSynchronization OnResetContext="ResetContext" OnHistoryRestored="HistoryRestored" />
    <CascadingValue Name="CoachMessageList" Value="MessageListContent">
        <CascadingValue Name="CoachMessageInput" Value="MessageInputContent">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private UIAgent _agent = default!;
    private AgentContext _context = default!;
    private long _historyVersion;
    private RenderFragment MessageListContent => @<CoachAgentMessages HistoryVersion="_historyVersion" />;
    private RenderFragment MessageInputContent => @<text>
        @if (Workspace.EntryId is not null)
        {
            <fieldset disabled="@(!Workspace.CanSubmit)">
                <MessageInput @key="_context" Placeholder="@Localize["Coach_ComposerPlaceholder"]" />
            </fieldset>
        }
    </text>;

    private void HistoryRestored() => _historyVersion++;

    protected override void OnInitialized() => CreateContext();

    private void CreateContext()
    {
        _agent = new UIAgent(ChatClient, options =>
        {
            options.Thread = new CoachConversationThread(Workspace);
            options.AddBlockHandler(new CoachTimelineBlockHandler());
        });
        _context = new AgentContext(_agent);
    }

    private void ResetContext()
    {
        _context.Dispose();
        _agent.Dispose();
        CreateContext();
    }

    public ValueTask DisposeAsync()
    {
        _context.Dispose();
        _agent.Dispose();
        return ValueTask.CompletedTask;
    }
}
