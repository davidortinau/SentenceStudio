@using SentenceStudio.WebApp.Admin
@inject ILogger<AdminGate> Logger

@*
    Wraps every admin page. The page's own first admin request is the gate: the API answers it
    only for an admin, on every visit, and until it has answered nothing of the page is drawn.
    A person the API refuses sees the app's ordinary "Page not found".

    The request is made in the live circuit only. A prerender draws the same waiting mark for
    everyone, so no admin content is ever in the HTML a browser first receives. The waiting mark
    and the could-not-load state are drawn for anyone, so their ids say nothing about admins. (That first response is still the app shell with
    status 200, as for any page of the app; the API routes are where a refusal is a bare 404.)
*@

@switch (_state)
{
    case GateState.Admitted:
        @ChildContent
        break;

    case GateState.NotFound:
        <NotFoundContent />
        break;

    case GateState.Unavailable:
        <div class="container text-center mt-5" id="page-unavailable" role="alert">
            <h1>This page could not be loaded</h1>
            <p class="text-secondary">The service did not answer.</p>
            <button type="button" class="btn btn-primary" id="page-retry" @onclick="TryAgainAsync">Try again</button>
        </div>
        break;

    default:
        <div class="d-flex justify-content-center align-items-center py-5" id="page-loading" role="status">
            <span class="spinner-border text-primary" aria-hidden="true"></span>
            <span class="visually-hidden">Loading&hellip;</span>
        </div>
        break;
}

@code {
    // Waiting covers the prerender and the live circuit until the API has answered.
    private enum GateState { Waiting = 0, Admitted, NotFound, Unavailable }

    private GateState _state;

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    /// <summary>
    /// The page's first admin request, which loads what the page shows. Its status decides the
    /// gate: answered (even with a refusal that names a reason) means admitted, 404 means not an
    /// admin, and a call that failed means nobody knows yet.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<Task<AdminApiStatus>> Load { get; set; } = default!;

    // The ask in flight, shared by everyone who asks meanwhile (single flight). All of this runs
    // on the circuit's own dispatcher, so the field needs no lock.
    private Task? _inFlight;

    protected override Task OnInitializedAsync() =>
        RendererInfo.IsInteractive ? AskAsync() : Task.CompletedTask;

    /// <summary>
    /// Asks again in the same circuit, for a page whose own "Try again" should re-run its first
    /// request. Not a reload: that starts a new circuit and throws away a password the admin has
    /// just confirmed. Completes when the answer is in.
    /// </summary>
    public async Task RetryAsync()
    {
        var asking = AskAsync();
        StateHasChanged();
        await asking;
        StateHasChanged();
    }

    // The gate's own button. A click can still arrive after the button has been replaced: while
    // an ask is in flight it joins that ask, and once the page is drawn it asks nothing.
    private Task TryAgainAsync() =>
        _state is GateState.Unavailable or GateState.Waiting ? AskAsync() : Task.CompletedTask;

    /// <summary>One ask at a time: two would be two audit rows, and the later answer would decide the gate.</summary>
    private Task AskAsync()
    {
        if (_inFlight is { } running)
        {
            return running;
        }

        var ask = AskOnceAsync();
        if (!ask.IsCompleted)
        {
            _inFlight = ask;
        }

        return ask;
    }

    private async Task AskOnceAsync()
    {
        _state = GateState.Waiting;
        try
        {
            _state = await Load() switch
            {
                AdminApiStatus.Ok or AdminApiStatus.Refused => GateState.Admitted,
                AdminApiStatus.NotFound => GateState.NotFound,
                _ => GateState.Unavailable
            };
        }
        catch (Exception ex)
        {
            // A failed call arrives as a status. A throw is a cancelled request or a fault in the
            // page's own loading; either way nobody knows yet, and a mark that waits for ever
            // tells the admin nothing.
            Logger.LogError(ex, "[Admin] An admin page's first request threw");
            _state = GateState.Unavailable;
        }
        finally
        {
            _inFlight = null;
        }
    }

    /// <summary>
    /// Replaces the page with "Page not found". A page calls this when a later admin request is
    /// answered 404: the person stopped being an admin while the page was open.
    /// </summary>
    public void Close()
    {
        _state = GateState.NotFound;
        StateHasChanged();
    }
}
