@using SentenceStudio.WebApp.Admin
@inject AdminSessionState State
@inject TimeProvider Time
@implements IDisposable

@*
    Password again. Dangerous admin actions (deleting an account, switching one off, creating a
    reset link, reading a learner's content) need the password typed in the last ten minutes. The
    API checks it and issues the proof; this card only collects it and shows how long it lasts.
*@

<div class="card" id="admin-password-card">
    <div class="card-body">
        <h2 class="h5 card-title">Password confirmation</h2>

        @if (State.PasswordConfirmedUntilUtc is { } until)
        {
            <p class="mb-0" id="admin-password-status" role="status">
                <i class="bi bi-unlock me-1" aria-hidden="true"></i>
                Password confirmed. It counts for @RemainingText(until).
            </p>
        }
        else
        {
            <p class="text-secondary" id="admin-password-status" role="status">
                <i class="bi bi-lock me-1" aria-hidden="true"></i>
                Not confirmed. Deleting or switching off an account, creating a reset link and reading
                a learner's content ask for your password again. A confirmation lasts 10 minutes.
            </p>

            <form id="admin-password-form" @onsubmit="ConfirmAsync" @onsubmit:preventDefault
                  class="d-flex flex-wrap gap-2 align-items-start">
                <div class="flex-grow-1">
                    <label for="admin-password" class="visually-hidden">Your password</label>
                    <input id="admin-password" type="password" class="form-control @(_message is null ? "" : "is-invalid")"
                           autocomplete="current-password" placeholder="Your password"
                           aria-describedby="admin-password-message"
                           @bind="_password" @bind:event="oninput" disabled="@_busy" />
                    <div id="admin-password-message" class="invalid-feedback" role="alert">@_message</div>
                </div>
                @* Not disabled while the field is empty. A browser ignores Enter in a form whose
                   submit button is disabled, and what the server knows of the field trails the
                   keyboard by a round trip, so a password filled and submitted in one go (a
                   password manager does that) would be dropped. ConfirmAsync refuses an empty one
                   and says so. *@
                <button id="admin-password-confirm" type="submit" class="btn btn-primary" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    }
                    Confirm password
                </button>
            </form>
        }
    </div>
</div>

@code {
    // Often enough that "N more minutes" is never more than a minute stale.
    private static readonly TimeSpan CountdownTick = TimeSpan.FromSeconds(20);

    private string _password = string.Empty;
    private string? _message;
    private bool _busy;
    private ITimer? _countdown;

    /// <summary>Raised when the API says this person is no longer an admin.</summary>
    [Parameter]
    public EventCallback OnNotAdmin { get; set; }

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        ScheduleCountdown();
    }

    private async Task ConfirmAsync()
    {
        if (_busy)
        {
            return;
        }

        if (string.IsNullOrEmpty(_password))
        {
            // The button is never disabled for an empty field, so say why nothing was sent.
            _message = "Enter your password.";
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var outcome = await State.ConfirmPasswordAsync(_password);
            _password = string.Empty;
            switch (outcome)
            {
                case AdminPasswordOutcome.Confirmed:
                    break;
                case AdminPasswordOutcome.Incorrect:
                    _message = "That password is not correct.";
                    break;
                case AdminPasswordOutcome.LockedOut:
                    _message = "Too many failed attempts. Try again in a few minutes.";
                    break;
                case AdminPasswordOutcome.NotAdmin:
                    await OnNotAdmin.InvokeAsync();
                    break;
                default:
                    _message = "The password could not be checked. Try again.";
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnStateChanged()
    {
        ScheduleCountdown();
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// While a confirmation is live, redraws on a tick so the minutes shown keep falling and the
    /// card turns back to "Not confirmed" when it runs out. Stops itself once nothing is live.
    /// </summary>
    private void ScheduleCountdown()
    {
        _countdown?.Dispose();
        _countdown = State.PasswordConfirmedUntilUtc is null
            ? null
            : Time.CreateTimer(_ => _ = InvokeAsync(OnCountdownTick), null, CountdownTick, CountdownTick);
    }

    private void OnCountdownTick()
    {
        if (State.PasswordConfirmedUntilUtc is null)
        {
            _countdown?.Dispose();
            _countdown = null;
        }

        StateHasChanged();
    }

    private string RemainingText(DateTimeOffset until)
    {
        var minutes = (int)Math.Ceiling((until - Time.GetUtcNow()).TotalMinutes);
        return minutes <= 1 ? "less than a minute more" : $"{minutes} more minutes";
    }

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        _countdown?.Dispose();
    }
}
