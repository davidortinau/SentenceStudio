@using SentenceStudio.Contracts.Theme
@inject ThemeService ThemeService

@*
    The appearance attributes are written here, in the server-side render, from the per-browser
    ss_appearance cookie. This is the whole reason the substrate is a cookie: it arrives on the
    request, so the scoped ThemeService can read it synchronously in its constructor and the very
    first bytes of the document already carry the learner's theme. Anything only reachable from the
    browser — localStorage, an interop call — would paint the default first and snap afterwards.
*@
<!DOCTYPE html>
<html lang="en" data-bs-theme="@ThemeService.CurrentMode" data-ss-theme="@ThemeService.CurrentTheme"
      style="--ss-font-scale: @ThemeService.FontScale.ToString(System.Globalization.CultureInfo.InvariantCulture)">

<head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover is required for env(safe-area-inset-*) to resolve to anything but 0
         in mobile Safari/Chrome. Without it every safe-area rule in app.css (activity input bar,
         coach composer) silently no-ops on the web, and the composer sits under the home indicator. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <ResourcePreloader />
    @*
        Bootswatch themes replace the Bootstrap stylesheet outright rather than overlaying CSS
        variables, so the swap has to happen here too. Emitting stock Bootstrap and letting app.js
        correct it after the circuit starts means a Bootswatch learner watches their page restyle
        itself on every navigation. The descriptor knows which family it belongs to.
    *@
    <link id="bootstrap-theme"
          href="@(ThemeService.CurrentDescriptor.StylesheetSwap is { } swap
                    ? $"_content/SentenceStudio.UI/css/themes/{swap}.min.css"
                    : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")"
          rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="_content/SentenceStudio.UI/css/app.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <CascadingAuthenticationState>
        <SentenceStudio.WebApp.Components.AppRoutes @rendermode="InteractiveServer" />
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="js/audioInterop.js"></script>
    <script src="js/filePicker.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
