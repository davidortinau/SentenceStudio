<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain .NET presentation assembly: no MAUI, Comet, platform UI, or platform runtime pack.
       Its Shared reference resolves the existing net10.0 slice for a net11.0 build.
       That slice still carries ASP.NET Core Identity/PostgreSQL on non-platform TFMs;
       native-head runtime closure needs a separate platform-target proof before shipping. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SentenceStudio.Native.Tests" />
    <InternalsVisibleTo Include="SentenceStudio.Native.iOS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SentenceStudio.AppLib/SentenceStudio.AppLib.csproj" />
    <ProjectReference Include="../SentenceStudio.Shared/SentenceStudio.Shared.csproj" />
    <ProjectReference Include="../SentenceStudio.Contracts/SentenceStudio.Contracts.csproj" />
  </ItemGroup>
</Project>
