<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain .NET presentation assembly: no MAUI, Comet, platform UI, or platform runtime pack.
       Its Shared reference resolves the existing net10.0 slice for a net11.0 build.
       That slice still carries ASP.NET Core Identity/PostgreSQL on non-platform TFMs;
       native-head runtime closure needs a separate platform-target proof before shipping. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SentenceStudio.Native.Tests" />
    <InternalsVisibleTo Include="SentenceStudio.Native.iOS.Tests" />
    <InternalsVisibleTo Include="SentenceStudio.Native.Android.Tests" />
    <!-- Both heads use the shared feature coordinators in Features/ (Settings, Profile,
         Skills, Vocabulary filters, Activity Log). -->
    <InternalsVisibleTo Include="SentenceStudio.Native.iOS" />
    <InternalsVisibleTo Include="SentenceStudio.Native.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SentenceStudio.AppLib/SentenceStudio.AppLib.csproj" />
    <ProjectReference Include="../SentenceStudio.Shared/SentenceStudio.Shared.csproj" />
    <ProjectReference Include="../SentenceStudio.Contracts/SentenceStudio.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GetStarterVocabulary.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GetStarterVocabulary.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/ExtractNativeResourceVocabulary.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.ExtractNativeResourceVocabulary.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GradeSentence.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GradeSentence.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GetClozuresV2.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GetClozuresV2.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GetTranslations.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GetTranslations.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GradeTranslation.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GradeTranslation.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/Translate.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.Translate.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GetShadowingSentences.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GetShadowingSentences.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GradeWordAssociation.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GradeWordAssociation.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/Conversation.system.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.Conversation.system.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/Conversation.scenario.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.Conversation.scenario.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/StartConversation.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.StartConversation.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/StartConversation.scenario.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.StartConversation.scenario.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/ContinueConversation.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.ContinueConversation.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/ContinueConversation.scenario.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.ContinueConversation.scenario.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GenerateDiaryPrompt.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GenerateDiaryPrompt.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GradeDiaryEntry.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GradeDiaryEntry.scriban-txt" />
    <EmbeddedResource Include="../SentenceStudio.AppLib/Resources/Raw/GradeMyDescription.scriban-txt"
                      LogicalName="SentenceStudio.Native.Prompts.GradeMyDescription.scriban-txt" />
  </ItemGroup>
</Project>
