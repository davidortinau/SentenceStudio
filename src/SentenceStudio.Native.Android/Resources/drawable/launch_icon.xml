<?xml version="1.0" encoding="utf-8"?>
<!-- The MAUI head's Android 12+ splash icon (Resizetizer maui_splash_image, drawable-v31):
     studio_icon.png at 108 dp, centered on the splash color. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:opacity="opaque">
    <item android:drawable="@color/launch_background" />
    <item android:width="108dp" android:height="108dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@mipmap/appicon_foreground" android:mipMap="true" />
    </item>
</layer-list>
