<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="SentenceStudioNativeTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <!-- Launch screen as the MAUI head (Maui.SplashTheme): the icon artwork on #0c0b10. -->
    <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>
</resources>
